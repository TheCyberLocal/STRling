{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strling.dev/tests/adapters/go-dart-swift-3.0/evidence.schema.json",
  "title": "STRling Go/Dart/Swift adapter migration evidence denominator 3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "suite_id",
    "suite_version",
    "contract",
    "legacy",
    "task_start_observations",
    "counts",
    "cases",
    "fingerprint"
  ],
  "properties": {
    "$schema": {
      "const": "evidence.schema.json"
    },
    "suite_id": {
      "const": "strling.go-dart-swift-adapter-migration-evidence"
    },
    "suite_version": {
      "const": "3.0.0"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "fingerprint"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          }
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_commit",
        "baseline_path",
        "tree_file_count",
        "production_source_count",
        "test_source_count",
        "public_input_count",
        "semantic_copy_count",
        "tree_fingerprint",
        "production_fingerprint",
        "public_fingerprint",
        "semantic_copy_fingerprint"
      ],
      "properties": {
        "base_commit": {
          "const": "b6cefe0add189d687f7c2940f4a505621c60c8e4"
        },
        "baseline_path": {
          "const": "tests/adapters/go-dart-swift-3.0/legacy-baseline.json"
        },
        "tree_file_count": {
          "const": 204
        },
        "production_source_count": {
          "const": 32
        },
        "test_source_count": {
          "const": 33
        },
        "public_input_count": {
          "const": 36
        },
        "semantic_copy_count": {
          "const": 30
        },
        "tree_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "production_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "public_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "semantic_copy_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "task_start_observations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding",
          "runtime",
          "status",
          "tests",
          "detail"
        ],
        "properties": {
          "binding": {
            "enum": [
              "dart",
              "go",
              "swift"
            ]
          },
          "runtime": {
            "enum": [
              "dart->=3.0,<4.0",
              "go->=1.22,<1.23",
              "swift->=5.9,<7.0"
            ]
          },
          "status": {
            "const": "unavailable"
          },
          "tests": {
            "type": "null"
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "families"
      ],
      "properties": {
        "total": {
          "const": 78
        },
        "families": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "minProperties": 12,
          "maxProperties": 12
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 78,
      "maxItems": 78,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "bindings",
          "runner",
          "claim"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
          },
          "family": {
            "enum": [
              "public_api",
              "canonical_parity",
              "compatibility_success",
              "compatibility_refusal",
              "marshaling_error",
              "lifecycle_concurrency",
              "unicode_resource",
              "simply_stdlib",
              "package_install",
              "architecture_deletion",
              "historical_preservation",
              "platform_toolchain"
            ]
          },
          "bindings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "dart",
                "go",
                "swift"
              ]
            }
          },
          "runner": {
            "enum": [
              "architecture",
              "cross-language",
              "dart-adapter",
              "go-adapter",
              "historical-reference",
              "manifest",
              "native-lifecycle",
              "package",
              "platform-ci",
              "public-contract",
              "swift-adapter"
            ]
          },
          "operation": {
            "enum": [
              "compile",
              "describe",
              "simply.compile",
              "target_profile.inspect"
            ]
          },
          "runtime": {
            "enum": [
              "dart->=3.0,<4.0",
              "go->=1.22,<1.23",
              "swift->=5.9,<7.0"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "LegacyBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "suite_id",
        "suite_version",
        "base_commit",
        "fingerprints",
        "public_files",
        "semantic_copy_files",
        "historical_source_files",
        "fingerprint"
      ],
      "properties": {
        "$schema": {
          "const": "evidence.schema.json#/$defs/LegacyBaseline"
        },
        "suite_id": {
          "const": "strling.go-dart-swift-adapter-legacy-baseline"
        },
        "suite_version": {
          "const": "3.0.0"
        },
        "base_commit": {
          "const": "b6cefe0add189d687f7c2940f4a505621c60c8e4"
        },
        "fingerprints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tree",
            "production",
            "public",
            "semantic"
          ],
          "properties": {
            "tree": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "production": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "public": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "semantic": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "public_files": {
          "type": "array",
          "minItems": 36,
          "maxItems": 36,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "semantic_copy_files": {
          "type": "array",
          "minItems": 30,
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "historical_source_files": {
          "type": "array",
          "minItems": 204,
          "maxItems": 204,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "content_base64"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "content_base64": {
                "type": "string",
                "pattern": "^[A-Za-z0-9+/]*={0,2}$"
              }
            }
          }
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
