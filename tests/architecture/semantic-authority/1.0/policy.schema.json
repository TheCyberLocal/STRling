{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/tests/architecture/semantic-authority/1.0/policy.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "$schema",
        "policy_id",
        "policy_version",
        "profile_ids",
        "structured_operation",
        "retired_operation_ids",
        "retired_generated_artifact_ids",
        "retired_path_patterns",
        "historical_files",
        "historical_path_patterns",
        "decision_sources",
        "forbidden_decision_tokens",
        "forbidden_semantic_scraping_tokens",
        "forbidden_semantic_scraping_patterns",
        "canonical_replacements"
    ],
    "properties": {
        "$schema": { "const": "policy.schema.json" },
        "policy_id": { "const": "strling.semantic-authority" },
        "policy_version": { "const": "1.0.0" },
        "profile_ids": { "$ref": "#/$defs/strings" },
        "structured_operation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "contract", "operation_id"],
            "properties": {
                "id": { "const": "semantic_authority_check" },
                "contract": { "const": "certification-result-v1" },
                "operation_id": { "const": "certification.semantic-authority" }
            }
        },
        "retired_operation_ids": { "$ref": "#/$defs/strings" },
        "retired_generated_artifact_ids": { "$ref": "#/$defs/strings" },
        "retired_path_patterns": { "$ref": "#/$defs/strings" },
        "historical_files": { "$ref": "#/$defs/strings" },
        "historical_path_patterns": { "$ref": "#/$defs/strings" },
        "decision_sources": { "$ref": "#/$defs/strings" },
        "forbidden_decision_tokens": { "$ref": "#/$defs/strings" },
        "forbidden_semantic_scraping_tokens": { "$ref": "#/$defs/strings" },
        "forbidden_semantic_scraping_patterns": { "$ref": "#/$defs/strings" },
        "canonical_replacements": { "$ref": "#/$defs/strings" }
    },
    "$defs": {
        "strings": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
        }
    }
}
