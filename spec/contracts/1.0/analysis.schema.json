{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/contracts/1.0/analysis.schema.json",
    "title": "STRling derived semantic analysis",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "contract_version",
        "specification_version",
        "node_facts",
        "feature_requirements"
    ],
    "properties": {
        "contract_version": {
            "$ref": "source.schema.json#/$defs/ContractVersion"
        },
        "specification_version": {
            "$ref": "source.schema.json#/$defs/SpecificationVersion"
        },
        "node_facts": {
            "type": "array",
            "items": { "$ref": "#/$defs/NodeFacts" }
        },
        "feature_requirements": {
            "type": "array",
            "items": { "$ref": "#/$defs/FeatureRequirement" }
        }
    },
    "$defs": {
        "NodeFacts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id"],
            "properties": {
                "node_id": { "$ref": "source.schema.json#/$defs/NodeId" },
                "nullable": { "type": "boolean" },
                "length_bounds": { "$ref": "#/$defs/LengthBounds" }
            },
            "anyOf": [
                { "required": ["nullable"] },
                { "required": ["length_bounds"] }
            ]
        },
        "LengthBounds": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max", "unit"],
            "properties": {
                "min": { "type": "integer", "minimum": 0 },
                "max": {
                    "oneOf": [
                        { "type": "integer", "minimum": 0 },
                        { "type": "null" }
                    ]
                },
                "unit": { "const": "unicode-scalar-values" }
            }
        },
        "FeatureRequirement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirement_id", "feature_id", "node_ids"],
            "properties": {
                "requirement_id": {
                    "type": "string",
                    "pattern": "^requirement:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
                },
                "feature_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
                },
                "node_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "source.schema.json#/$defs/NodeId" }
                }
            }
        }
    }
}
