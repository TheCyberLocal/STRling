{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/contracts/1.0/source.schema.json",
    "title": "STRling SourceDocument contract",
    "description": "Canonical source identity and provenance. Offsets are half-open UTF-8 byte offsets.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "contract_version",
        "source_id",
        "specification_version",
        "frontend",
        "content",
        "provenance"
    ],
    "properties": {
        "contract_version": { "$ref": "#/$defs/ContractVersion" },
        "source_id": { "$ref": "#/$defs/SourceId" },
        "specification_version": { "$ref": "#/$defs/SpecificationVersion" },
        "frontend": { "$ref": "#/$defs/FrontendIdentity" },
        "display_name": { "type": "string", "minLength": 1 },
        "content": { "$ref": "#/$defs/SourceContent" },
        "provenance": { "$ref": "#/$defs/Provenance" }
    },
    "$defs": {
        "ContractVersion": {
            "type": "string",
            "const": "1.0.0"
        },
        "SpecificationVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-draft\\.([1-9][0-9]*))?$"
        },
        "SourceId": {
            "type": "string",
            "pattern": "^src:[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        "NodeId": {
            "type": "string",
            "pattern": "^node:[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        "FrontendIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "dialect_version"],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
                },
                "dialect_version": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                }
            }
        },
        "SourceContent": {
            "oneOf": [
                { "$ref": "#/$defs/InlineContent" },
                { "$ref": "#/$defs/ReferencedContent" }
            ]
        },
        "InlineContent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "encoding", "text"],
            "properties": {
                "kind": { "const": "inline" },
                "encoding": { "const": "utf-8" },
                "media_type": { "type": "string", "minLength": 1 },
                "text": { "type": "string" }
            }
        },
        "ReferencedContent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "encoding", "uri", "sha256"],
            "properties": {
                "kind": { "const": "reference" },
                "encoding": { "const": "utf-8" },
                "media_type": { "type": "string", "minLength": 1 },
                "uri": { "type": "string", "format": "uri", "minLength": 1 },
                "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                }
            }
        },
        "Producer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
                },
                "version": { "type": "string", "minLength": 1 }
            }
        },
        "ParentSource": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id"],
            "properties": {
                "source_id": { "$ref": "#/$defs/SourceId" },
                "span": { "$ref": "#/$defs/SourceSpan" }
            }
        },
        "Provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
                "kind": {
                    "enum": ["authored", "imported", "generated", "projected"]
                },
                "producer": { "$ref": "#/$defs/Producer" },
                "parent_sources": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/ParentSource" }
                },
                "description": { "type": "string", "minLength": 1 }
            },
            "allOf": [
                {
                    "if": {
                        "properties": { "kind": { "const": "authored" } },
                        "required": ["kind"]
                    },
                    "then": { "not": { "required": ["parent_sources"] } }
                },
                {
                    "if": {
                        "properties": {
                            "kind": { "enum": ["generated", "projected"] }
                        },
                        "required": ["kind"]
                    },
                    "then": { "required": ["producer"] }
                }
            ]
        },
        "SourceSpan": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "coordinate_system", "start", "end"],
            "properties": {
                "source_id": { "$ref": "#/$defs/SourceId" },
                "coordinate_system": { "const": "utf8-bytes" },
                "start": { "type": "integer", "minimum": 0 },
                "end": { "type": "integer", "minimum": 0 }
            }
        },
        "SourceOrigin": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "source_spans": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/SourceSpan" }
                },
                "derived_from_node_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/NodeId" }
                }
            },
            "anyOf": [
                { "required": ["source_spans"] },
                { "required": ["derived_from_node_ids"] }
            ]
        }
    }
}
