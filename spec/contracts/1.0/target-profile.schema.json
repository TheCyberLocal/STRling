{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/contracts/1.0/target-profile.schema.json",
    "title": "STRling version-aware target profile",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "contract_version",
        "profile_id",
        "profile_version",
        "engine",
        "compatible_specification_versions",
        "capability_scope",
        "capabilities",
        "semantic_sets",
        "semantic_algorithms",
        "target_limits",
        "options",
        "evidence"
    ],
    "properties": {
        "contract_version": {
            "$ref": "source.schema.json#/$defs/ContractVersion"
        },
        "profile_id": {
            "$ref": "portability.schema.json#/$defs/TargetProfileReference/properties/profile_id"
        },
        "profile_version": {
            "$ref": "portability.schema.json#/$defs/TargetProfileReference/properties/profile_version"
        },
        "engine": {
            "$ref": "#/$defs/EngineIdentity"
        },
        "runtime": {
            "$ref": "#/$defs/RuntimeIdentity"
        },
        "compatible_specification_versions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "source.schema.json#/$defs/SpecificationVersion"
            }
        },
        "capability_scope": {
            "$ref": "#/$defs/CapabilityScope"
        },
        "capabilities": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/Capability"
            }
        },
        "semantic_sets": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/SemanticSet"
            }
        },
        "semantic_algorithms": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/SemanticAlgorithm"
            }
        },
        "target_limits": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/TargetLimit"
            }
        },
        "options": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/ProfileOption"
            }
        },
        "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/Evidence"
            }
        }
    },
    "$defs": {
        "Identifier": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "Version": {
            "oneOf": [
                {
                    "$ref": "#/$defs/SemanticVersion"
                },
                {
                    "$ref": "#/$defs/DottedNumericVersion"
                },
                {
                    "$ref": "#/$defs/EditionVersion"
                },
                {
                    "$ref": "#/$defs/OpaqueVersion"
                }
            ]
        },
        "SemanticVersion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scheme", "value"],
            "properties": {
                "scheme": {
                    "const": "semver"
                },
                "value": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
                }
            }
        },
        "DottedNumericVersion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scheme", "value"],
            "properties": {
                "scheme": {
                    "const": "dotted_numeric"
                },
                "value": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(?:\\.(0|[1-9][0-9]*)){1,3}$"
                }
            }
        },
        "EditionVersion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scheme", "value"],
            "properties": {
                "scheme": {
                    "const": "edition"
                },
                "value": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{3}$"
                }
            }
        },
        "OpaqueVersion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scheme", "value"],
            "properties": {
                "scheme": {
                    "const": "opaque"
                },
                "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                }
            }
        },
        "EngineIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
                "id": {
                    "$ref": "#/$defs/Identifier"
                },
                "version": {
                    "$ref": "#/$defs/Version"
                }
            }
        },
        "RuntimeIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
                "id": {
                    "$ref": "#/$defs/Identifier"
                },
                "version": {
                    "$ref": "#/$defs/Version"
                }
            }
        },
        "CapabilityScope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "unlisted_capabilities"],
            "properties": {
                "kind": {
                    "const": "enumerated"
                },
                "unlisted_capabilities": {
                    "const": "unknown"
                }
            }
        },
        "Capability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "capability_id",
                "availability",
                "constraints",
                "semantic_fact_refs"
            ],
            "properties": {
                "capability_id": {
                    "$ref": "#/$defs/Identifier"
                },
                "availability": {
                    "enum": ["available", "constrained", "unavailable"]
                },
                "constraints": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/CapabilityConstraint"
                    }
                },
                "semantic_fact_refs": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/SemanticFactReference"
                    }
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "availability": {
                                "const": "constrained"
                            }
                        },
                        "required": ["availability"]
                    },
                    "then": {
                        "properties": {
                            "constraints": {
                                "minItems": 1
                            }
                        }
                    },
                    "else": {
                        "properties": {
                            "constraints": {
                                "maxItems": 0
                            }
                        }
                    }
                }
            ]
        },
        "SemanticFactReference": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "role", "fact_id"],
            "properties": {
                "kind": {
                    "enum": [
                        "semantic_set",
                        "semantic_algorithm",
                        "target_limit"
                    ]
                },
                "role": {
                    "$ref": "#/$defs/Identifier"
                },
                "fact_id": {
                    "$ref": "#/$defs/Identifier"
                }
            }
        },
        "FixedUnicodeVersion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "value"],
            "properties": {
                "kind": {
                    "const": "fixed"
                },
                "value": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                }
            }
        },
        "LatestUnicodeAtEditionVersion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "edition"],
            "properties": {
                "kind": {
                    "const": "latest_unicode_at_edition"
                },
                "edition": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{3}$"
                }
            }
        },
        "UnicodeVersion": {
            "oneOf": [
                {
                    "$ref": "#/$defs/FixedUnicodeVersion"
                },
                {
                    "$ref": "#/$defs/LatestUnicodeAtEditionVersion"
                }
            ]
        },
        "UnicodeScalar": {
            "type": "string",
            "pattern": "^U\\+[0-9A-F]{4,6}$"
        },
        "FactEvidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/Identifier"
            }
        },
        "UnicodeGeneralCategory": {
            "enum": [
                "C",
                "Cc",
                "Cf",
                "Cn",
                "Co",
                "Cs",
                "L",
                "Ll",
                "Lm",
                "Lo",
                "Lt",
                "Lu",
                "M",
                "Mc",
                "Me",
                "Mn",
                "N",
                "Nd",
                "Nl",
                "No",
                "P",
                "Pc",
                "Pd",
                "Pe",
                "Pf",
                "Pi",
                "Po",
                "Ps",
                "S",
                "Sc",
                "Sk",
                "Sm",
                "So",
                "Z",
                "Zl",
                "Zp",
                "Zs"
            ]
        },
        "ScalarRange": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
                "start": {
                    "$ref": "#/$defs/UnicodeScalar"
                },
                "end": {
                    "$ref": "#/$defs/UnicodeScalar"
                }
            }
        },
        "CharacterSetDefinition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind",
                "universe",
                "scalars",
                "ranges",
                "unicode_general_categories"
            ],
            "properties": {
                "kind": {
                    "const": "character_set"
                },
                "universe": {
                    "enum": ["byte", "unicode_scalar"]
                },
                "scalars": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/UnicodeScalar"
                    }
                },
                "ranges": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/ScalarRange"
                    }
                },
                "unicode_general_categories": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/UnicodeGeneralCategory"
                    }
                }
            },
            "anyOf": [
                {
                    "properties": {
                        "scalars": {
                            "minItems": 1
                        }
                    }
                },
                {
                    "properties": {
                        "ranges": {
                            "minItems": 1
                        }
                    }
                },
                {
                    "properties": {
                        "unicode_general_categories": {
                            "minItems": 1
                        }
                    }
                }
            ]
        },
        "LineTerminatorSetDefinition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "members", "sequence_policy"],
            "properties": {
                "kind": {
                    "const": "line_terminator_set"
                },
                "members": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "enum": [
                            "LF",
                            "VT",
                            "FF",
                            "CR",
                            "CRLF",
                            "NEL",
                            "LS",
                            "PS"
                        ]
                    }
                },
                "sequence_policy": {
                    "enum": ["independent_code_points", "atomic_longest"]
                }
            }
        },
        "SemanticSet": {
            "type": "object",
            "additionalProperties": false,
            "required": ["set_id", "definition", "evidence"],
            "properties": {
                "set_id": {
                    "$ref": "#/$defs/Identifier"
                },
                "definition": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/CharacterSetDefinition"
                        },
                        {
                            "$ref": "#/$defs/LineTerminatorSetDefinition"
                        }
                    ]
                },
                "unicode_version": {
                    "$ref": "#/$defs/UnicodeVersion"
                },
                "evidence": {
                    "$ref": "#/$defs/FactEvidence"
                }
            }
        },
        "BackreferenceUnsetAlgorithm": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "behavior"],
            "properties": {
                "kind": {
                    "const": "backreference_unset"
                },
                "behavior": {
                    "enum": ["empty", "fail"]
                }
            }
        },
        "CaptureResetAlgorithm": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "behavior"],
            "properties": {
                "kind": {
                    "const": "capture_reset_on_iteration"
                },
                "behavior": {
                    "enum": ["reset", "retain"]
                }
            }
        },
        "CaseFoldingAlgorithm": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "mode", "additional_equivalence_classes"],
            "properties": {
                "kind": {
                    "const": "case_folding"
                },
                "mode": {
                    "enum": [
                        "ascii",
                        "simple_unicode",
                        "full_unicode",
                        "engine_specific"
                    ]
                },
                "variant": {
                    "$ref": "#/$defs/Identifier"
                },
                "additional_equivalence_classes": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "array",
                        "minItems": 2,
                        "uniqueItems": true,
                        "items": {
                            "$ref": "#/$defs/UnicodeScalar"
                        }
                    }
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "mode": {
                                "const": "engine_specific"
                            }
                        },
                        "required": ["mode"]
                    },
                    "then": {
                        "required": ["variant"]
                    }
                }
            ]
        },
        "MatchingUnitAlgorithm": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "unit"],
            "properties": {
                "kind": {
                    "const": "matching_unit"
                },
                "unit": {
                    "enum": ["byte", "unicode_code_point"]
                }
            }
        },
        "SemanticAlgorithm": {
            "type": "object",
            "additionalProperties": false,
            "required": ["algorithm_id", "definition", "evidence"],
            "properties": {
                "algorithm_id": {
                    "$ref": "#/$defs/Identifier"
                },
                "definition": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/BackreferenceUnsetAlgorithm"
                        },
                        {
                            "$ref": "#/$defs/CaptureResetAlgorithm"
                        },
                        {
                            "$ref": "#/$defs/CaseFoldingAlgorithm"
                        },
                        {
                            "$ref": "#/$defs/MatchingUnitAlgorithm"
                        }
                    ]
                },
                "unicode_version": {
                    "$ref": "#/$defs/UnicodeVersion"
                },
                "evidence": {
                    "$ref": "#/$defs/FactEvidence"
                }
            }
        },
        "NumericLimitBound": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "operator", "value", "unit"],
            "properties": {
                "kind": {
                    "const": "numeric"
                },
                "operator": {
                    "enum": ["equals", "at_most", "at_least"]
                },
                "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                },
                "unit": {
                    "$ref": "#/$defs/Identifier"
                }
            }
        },
        "UnknownLimitBound": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
                "kind": {
                    "const": "unknown"
                }
            }
        },
        "ResourceDependentLimitBound": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
                "kind": {
                    "const": "resource_dependent"
                }
            }
        },
        "TargetLimit": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "limit_id",
                "scope",
                "bound",
                "prediction",
                "evidence"
            ],
            "properties": {
                "limit_id": {
                    "$ref": "#/$defs/Identifier"
                },
                "scope": {
                    "enum": [
                        "syntactic_quantifier",
                        "compiled_pattern",
                        "resource_dependent"
                    ]
                },
                "bound": {
                    "oneOf": [
                        {
                            "$ref": "#/$defs/NumericLimitBound"
                        },
                        {
                            "$ref": "#/$defs/UnknownLimitBound"
                        },
                        {
                            "$ref": "#/$defs/ResourceDependentLimitBound"
                        }
                    ]
                },
                "prediction": {
                    "enum": [
                        "exact",
                        "artifact_and_configuration_dependent",
                        "resource_dependent"
                    ]
                },
                "evidence": {
                    "$ref": "#/$defs/FactEvidence"
                }
            }
        },
        "CapabilityConstraint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["constraint_id", "operator", "value"],
            "properties": {
                "constraint_id": {
                    "$ref": "#/$defs/Identifier"
                },
                "operator": {
                    "enum": [
                        "equals",
                        "at_most",
                        "at_least",
                        "one_of",
                        "requires_option"
                    ]
                },
                "value": {
                    "$ref": "#/$defs/ConstraintValue"
                },
                "unit": {
                    "$ref": "#/$defs/Identifier"
                }
            }
        },
        "ConstraintValue": {
            "oneOf": [
                {
                    "type": ["string", "number", "boolean"]
                },
                {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": ["string", "number", "boolean"]
                    }
                }
            ]
        },
        "ProfileOption": {
            "type": "object",
            "additionalProperties": false,
            "required": ["option_id", "stage", "value", "selection"],
            "properties": {
                "option_id": {
                    "$ref": "#/$defs/Identifier"
                },
                "stage": {
                    "enum": ["compile", "runtime"]
                },
                "value": {
                    "type": ["string", "number", "boolean"]
                },
                "selection": {
                    "enum": ["required", "profile_default"]
                }
            }
        },
        "Evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_id", "authority", "url", "locator"],
            "properties": {
                "evidence_id": {
                    "$ref": "#/$defs/Identifier"
                },
                "authority": {
                    "enum": ["normative_standard", "engine_documentation"]
                },
                "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                },
                "locator": {
                    "type": "string",
                    "minLength": 1
                }
            }
        }
    }
}
