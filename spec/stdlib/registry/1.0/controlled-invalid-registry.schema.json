{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/spec/stdlib/registry/1.0/controlled-invalid-registry.schema.json",
    "title": "Controlled invalid standard-library registry case",
    "type": "object",
    "additionalProperties": false,
    "required": ["case_id", "expected_rule", "kind", "operations", "registry_reference"],
    "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "expected_rule": {"type": "string", "pattern": "^[a-z][a-z0-9.]+$"},
        "kind": {"const": "strling.stdlib-registry-invalid-case"},
        "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "path"],
                "properties": {
                    "from": {"type": "string", "pattern": "^/"},
                    "op": {"enum": ["copy", "remove", "replace"]},
                    "path": {"type": "string", "pattern": "^/"},
                    "value": true
                },
                "allOf": [
                    {
                        "if": {"properties": {"op": {"const": "copy"}}},
                        "then": {"required": ["from"]}
                    },
                    {
                        "if": {"properties": {"op": {"const": "replace"}}},
                        "then": {"required": ["value"]}
                    }
                ]
            }
        },
        "registry_reference": {"const": "spec/stdlib/registry/1.0/registry.json"}
    }
}
