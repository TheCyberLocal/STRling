{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/frontends/simply/1.0/case.schema.json",
    "title": "STRling Simply builder equivalence cases",
    "type": "object",
    "additionalProperties": false,
    "required": ["suite_version", "kind", "cases"],
    "properties": {
        "suite_version": { "const": "1.0.0" },
        "kind": { "enum": ["positive", "negative"] },
        "cases": { "type": "array", "minItems": 1 }
    },
    "allOf": [
        {
            "if": {
                "properties": { "kind": { "const": "positive" } },
                "required": ["kind"]
            },
            "then": {
                "properties": {
                    "cases": {
                        "items": { "$ref": "#/$defs/PositiveCase" }
                    }
                }
            }
        },
        {
            "if": {
                "properties": { "kind": { "const": "negative" } },
                "required": ["kind"]
            },
            "then": {
                "properties": {
                    "cases": {
                        "items": { "$ref": "#/$defs/NegativeCase" }
                    }
                }
            }
        }
    ],
    "$defs": {
        "CaseId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "FeatureIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "enum": [
                    "alternation",
                    "atomic",
                    "backreference",
                    "capture",
                    "character_set",
                    "compile_request",
                    "empty",
                    "group",
                    "identity",
                    "import_node",
                    "import_program",
                    "literal",
                    "lookaround",
                    "options",
                    "position",
                    "provenance",
                    "repeat",
                    "sequence",
                    "wildcard"
                ]
            }
        },
        "PositiveCase": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "feature_ids", "request", "expected"],
            "properties": {
                "case_id": { "$ref": "#/$defs/CaseId" },
                "feature_ids": { "$ref": "#/$defs/FeatureIds" },
                "request": {
                    "$ref": "builder-request.schema.json"
                },
                "expected": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "outcome",
                        "semantic_program",
                        "compile_request"
                    ],
                    "properties": {
                        "outcome": { "const": "success" },
                        "semantic_program": {
                            "$ref": "../../../contracts/1.0/semantic-ir.schema.json"
                        },
                        "compile_request": {
                            "$ref": "../../../contracts/1.0/compile-request.schema.json"
                        }
                    }
                }
            }
        },
        "NegativeCase": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "feature_ids", "request", "expected"],
            "properties": {
                "case_id": { "$ref": "#/$defs/CaseId" },
                "feature_ids": { "$ref": "#/$defs/FeatureIds" },
                "request": { "type": "object" },
                "expected": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["outcome", "errors"],
                    "properties": {
                        "outcome": { "const": "failure" },
                        "errors": {
                            "type": "array",
                            "minItems": 1,
                            "items": { "$ref": "#/$defs/ExpectedError" }
                        }
                    }
                }
            }
        },
        "ExpectedError": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "path"],
            "properties": {
                "code": {
                    "type": "string",
                    "pattern": "^STRL-SIMPLY-[0-9]{4}$"
                },
                "path": { "type": "string", "pattern": "^\\$" }
            }
        }
    }
}
