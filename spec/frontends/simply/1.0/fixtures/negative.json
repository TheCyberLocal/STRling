                "steps": [
                    {
                        "step_id": "root",
                        "operation": "literal",
                        "arguments": { "text": "a" }
                    }
                ],
                "root_step_id": "root",
                "compile": {
                    "requested_outputs": ["semantic"],
                    "compiler_options": {
                        "partial_semantics": "forbid",
                        "diagnostic_policy": { "minimum_severity": "warning" }
                    }
                }
            },
            "expected": {
                "outcome": "failure",
                "errors": [
                    {
                        "code": "STRL-SIMPLY-0001",
                        "path": "$.semantic_options.text_model"
                    }
                ]
            }
        },
