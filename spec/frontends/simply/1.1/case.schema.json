{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/frontends/simply/1.1/case.schema.json",
    "title": "STRling Simply 1.1 standard-library extension cases",
    "type": "object",
    "additionalProperties": false,
    "required": ["suite_version", "kind", "cases"],
    "properties": {
        "suite_version": { "const": "1.1.0" },
        "kind": { "enum": ["positive", "negative"] },
        "cases": { "type": "array", "minItems": 1 }
    },
    "allOf": [
        {
            "if": {
                "properties": { "kind": { "const": "positive" } },
                "required": ["kind"]
            },
            "then": {
                "properties": {
                    "cases": { "items": { "$ref": "#/$defs/PositiveCase" } }
                }
            }
        },
        {
            "if": {
                "properties": { "kind": { "const": "negative" } },
                "required": ["kind"]
            },
            "then": {
                "properties": {
                    "cases": { "items": { "$ref": "#/$defs/NegativeCase" } }
                }
            }
        }
    ],
    "$defs": {
        "CaseId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "PositiveCase": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "feature_ids", "request", "expected"],
            "properties": {
                "case_id": { "$ref": "#/$defs/CaseId" },
                "feature_ids": {
                    "const": ["stdlib_helper"]
                },
                "request": { "$ref": "builder-request.schema.json" },
                "expected": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["outcome", "helper_id", "variant_id"],
                    "properties": {
                        "outcome": { "const": "accepted" },
                        "helper_id": {
                            "type": "string",
                            "pattern": "^stdlib[.][a-z][a-z0-9_]*$"
                        },
                        "variant_id": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]*(?:[.][a-z][a-z0-9_]*)+$"
                        }
                    }
                }
            }
        },
        "NegativeCase": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "feature_ids", "request", "expected"],
            "properties": {
                "case_id": { "$ref": "#/$defs/CaseId" },
                "feature_ids": {
                    "const": ["stdlib_helper"]
                },
                "request": { "type": "object" },
                "expected": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["outcome", "errors"],
                    "properties": {
                        "outcome": { "const": "failure" },
                        "errors": {
                            "type": "array",
                            "minItems": 1,
                            "items": { "$ref": "#/$defs/ExpectedError" }
                        }
                    }
                }
            }
        },
        "ExpectedError": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "path"],
            "properties": {
                "code": {
                    "enum": ["STRL-SIMPLY-0001", "STRL-SIMPLY-0010"]
                },
                "path": { "type": "string", "pattern": "^\\$" }
            }
        }
    }
}
