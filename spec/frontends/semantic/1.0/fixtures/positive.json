            "expected": {
                "status": "accepted",
                "mapping_ids": [
                    "node.alternation",
                    "node.literal",
                    "node.repeat",
                    "program.case-matching"
                ]
            }
        },
        {
            "id": "case:semantic/set-negation",
            "source": "semantic strling 1.0;\ncase insensitive;\npattern character except { unicode word; }\n",
            "production_ids": ["BuiltinMember", "CharacterSet", "SetPolarity"],
            "expected": {
                "status": "accepted",
                "mapping_ids": [
                    "member.builtin",
                    "node.character-set",
                    "program.case-matching"
                ]
            }
        },
        {
            "id": "case:semantic/wildcard-policies",
            "source": "semantic strling 1.0;\ncase sensitive;\npattern choice { any character excluding line terminators; any character including line terminators; }\n",
            "production_ids": ["LineTerminatorPolicy", "Wildcard"],
            "expected": {
                "status": "accepted",
                "mapping_ids": [
                    "node.alternation",
                    "node.wildcard",
                    "program.case-matching"
                ]
            }
        }
    ]
}
