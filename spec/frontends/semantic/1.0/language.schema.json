{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/frontends/semantic/1.0/language.schema.json",
    "title": "Semantic STRling 1.0 language catalog",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "$schema",
        "contract_kind",
        "contract_version",
        "frontend",
        "authority",
        "source_model",
        "structure",
        "limits",
        "reserved_words",
        "construct_phrases",
        "diagnostics",
        "deferred_constructs",
        "versioning"
    ],
    "properties": {
        "$schema": {
            "const": "https://strling.dev/frontends/semantic/1.0/language.schema.json"
        },
        "contract_kind": { "const": "strling.semantic-language" },
        "contract_version": { "const": "1.0.0" },
        "frontend": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "dialect_version", "source_edition", "role", "media_type"],
            "properties": {
                "id": { "const": "strling.semantic" },
                "dialect_version": { "const": "1.0.0" },
                "source_edition": { "const": "1.0" },
                "role": { "const": "flagship-textual-frontend" },
                "media_type": { "const": "text/x-strling-semantic" }
            }
        },
        "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "syntax_authority",
                "mapping_authority",
                "canonical_semantic_authority",
                "target_authority",
                "runtime_authority",
                "parser_implementation",
                "formatter_implementation",
                "lowering_destination"
            ],
            "properties": {
                "syntax_authority": { "const": true },
                "mapping_authority": { "const": true },
                "canonical_semantic_authority": { "const": false },
                "target_authority": { "const": false },
                "runtime_authority": { "const": false },
                "parser_implementation": { "const": false },
                "formatter_implementation": { "const": false },
                "lowering_destination": { "const": "semantic-ir" }
            }
        },
        "source_model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "encoding",
                "coordinate_system",
                "line_endings",
                "bom_policy",
                "comment_model",
                "raw_fragment_model",
                "target_assumption",
                "metadata_selection"
            ],
            "properties": {
                "encoding": { "const": "utf-8" },
                "coordinate_system": { "const": "utf8-bytes" },
                "line_endings": {
                    "const": ["crlf", "lf"]
                },
                "bom_policy": { "const": "reject-as-unexpected-token" },
                "comment_model": { "const": "hash-to-physical-line-end" },
                "raw_fragment_model": { "const": "none" },
                "target_assumption": { "const": "none" },
                "metadata_selection": { "const": "explicit-and-header-consistent" }
            }
        },
        "structure": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "header",
                "case_declaration",
                "root_count",
                "composition",
                "operator_precedence",
                "implicit_concatenation",
                "transparent_grouping",
                "text_model",
                "capture_model",
                "wildcard_default",
                "builtin_domain_default"
            ],
            "properties": {
                "header": { "const": "semantic strling 1.0;" },
                "case_declaration": { "const": "required-exactly-once" },
                "root_count": { "const": 1 },
                "composition": { "const": "keyword-led-explicit-blocks" },
                "operator_precedence": { "const": "none" },
                "implicit_concatenation": { "const": false },
                "transparent_grouping": { "const": false },
                "text_model": { "const": "unicode-scalar-values" },
                "capture_model": { "const": "unique-named-prior-declarations" },
                "wildcard_default": { "const": "none-explicit-per-node" },
                "builtin_domain_default": { "const": "none-explicit-per-member" }
            }
        },
        "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "max_source_bytes",
                "max_nesting_depth",
                "max_material_nodes",
                "max_captures",
                "max_set_members",
                "max_identifier_bytes",
                "max_integer",
                "error_selection"
            ],
            "properties": {
                "max_source_bytes": { "const": 1048576 },
                "max_nesting_depth": { "const": 128 },
                "max_material_nodes": { "const": 65535 },
                "max_captures": { "const": 16384 },
                "max_set_members": { "const": 65535 },
                "max_identifier_bytes": { "const": 64 },
                "max_integer": { "const": 4294967295 },
                "error_selection": { "const": "first-utf8-byte-order" }
            }
        },
        "reserved_words": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z]+$" }
        },
        "construct_phrases": {
            "type": "array",
            "minItems": 12,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[a-z]+(?: [a-z]+)*$"
            }
        },
        "diagnostics": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/Diagnostic" }
        },
        "deferred_constructs": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/Deferred" }
        },
        "versioning": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selection", "compatible_addition", "incompatible_change", "patch_scope"],
            "properties": {
                "selection": { "const": "exact-major-minor-header" },
                "compatible_addition": { "const": "new-minor-edition" },
                "incompatible_change": { "const": "new-major-edition" },
                "patch_scope": { "const": "editorial-or-additional-reviewed-evidence-only" }
            }
        }
    },
    "$defs": {
        "Diagnostic": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "id", "phase", "category", "trigger", "fixture_required"],
            "properties": {
                "code": { "type": "string", "pattern": "^STRL-DSL-[0-9]{4}$" },
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
                "phase": { "enum": ["frontend_parse", "semantic_lowering"] },
                "category": { "enum": ["syntax", "semantic_validity", "resource_limit"] },
                "trigger": { "type": "string", "minLength": 1 },
                "fixture_required": { "type": "boolean" }
            }
        },
        "Deferred": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "rationale", "diagnostic_code"],
            "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$" },
                "status": { "const": "unavailable-in-1.0" },
                "rationale": { "type": "string", "minLength": 1 },
                "diagnostic_code": { "type": "string", "pattern": "^STRL-DSL-[0-9]{4}$" }
            }
        }
    }
}
