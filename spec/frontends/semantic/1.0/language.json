{
    "$schema": "https://strling.dev/frontends/semantic/1.0/language.schema.json",
    "contract_kind": "strling.semantic-language",
    "contract_version": "1.0.0",
    "frontend": {
        "id": "strling.semantic",
        "dialect_version": "1.0.0",
        "source_edition": "1.0",
        "role": "flagship-textual-frontend",
        "media_type": "text/x-strling-semantic"
    },
    "authority": {
        "syntax_authority": true,
        "mapping_authority": true,
        "canonical_semantic_authority": false,
        "target_authority": false,
        "runtime_authority": false,
        "parser_implementation": false,
        "formatter_implementation": false,
        "lowering_destination": "semantic-ir"
    },
    "source_model": {
        "encoding": "utf-8",
        "coordinate_system": "utf8-bytes",
        "line_endings": ["crlf", "lf"],
        "bom_policy": "reject-as-unexpected-token",
        "comment_model": "hash-to-physical-line-end",
        "raw_fragment_model": "none",
        "target_assumption": "none",
        "metadata_selection": "explicit-and-header-consistent"
    },
    "structure": {
        "header": "semantic strling 1.0;",
        "case_declaration": "required-exactly-once",
        "root_count": 1,
        "composition": "keyword-led-explicit-blocks",
        "operator_precedence": "none",
        "implicit_concatenation": false,
        "transparent_grouping": false,
        "text_model": "unicode-scalar-values",
        "capture_model": "unique-named-prior-declarations",
        "wildcard_default": "none-explicit-per-node",
        "builtin_domain_default": "none-explicit-per-member"
    },
    "limits": {
        "max_source_bytes": 1048576,
        "max_nesting_depth": 128,
        "max_material_nodes": 65535,
        "max_captures": 16384,
        "max_set_members": 65535,
        "max_identifier_bytes": 64,
        "max_integer": 4294967295,
        "error_selection": "first-utf8-byte-order"
    },
    "reserved_words": [
        "any",
        "as",
        "ascii",
        "at",
        "backtracking",
        "before",
        "boundary",
        "by",
        "capture",
        "case",
        "character",
        "choice",
        "digit",
        "empty",
        "end",
        "except",
        "excluding",
        "final",
        "followed",
        "from",
        "greedy",
        "if",
        "including",
        "input",
        "insensitive",
        "lazy",
        "line",
        "not",
        "pattern",
        "possessive",
        "preceded",
        "property",
        "range",
        "repeat",
        "same",
        "scalar",
        "semantic",
        "sensitive",
        "sequence",
        "start",
        "strling",
        "terminator",
        "terminators",
        "text",
        "through",
        "to",
        "unbounded",
        "unicode",
        "unless",
        "using",
        "value",
        "whitespace",
        "without",
        "word"
    ],
    "construct_phrases": [
        "any character excluding line terminators",
        "any character including line terminators",
        "at input end",
        "at input start",
        "at line end",
        "at line start",
        "at word boundary",
        "before final line terminator",
        "capture",
        "character except",
        "character from",
        "choice",
        "empty",
        "if followed by",
        "if preceded by",
        "not at word boundary",
        "repeat from",
        "same text as",
        "sequence",
        "text",
        "unless followed by",
        "unless preceded by",
        "without backtracking"
    ],
    "diagnostics": [
        {"code": "STRL-DSL-1001", "id": "invalid_header", "phase": "frontend_parse", "category": "syntax", "trigger": "Missing, misspelled, reordered, or duplicated semantic strling header", "fixture_required": true},
        {"code": "STRL-DSL-1002", "id": "unsupported_version", "phase": "frontend_parse", "category": "syntax", "trigger": "Header selects an edition other than exact 1.0", "fixture_required": true},
        {"code": "STRL-DSL-1003", "id": "missing_case_declaration", "phase": "frontend_parse", "category": "syntax", "trigger": "Required case declaration is missing, duplicated, or out of order", "fixture_required": true},
        {"code": "STRL-DSL-1004", "id": "duplicate_top_level", "phase": "frontend_parse", "category": "syntax", "trigger": "More than one pattern root or trailing top-level construct", "fixture_required": true},
        {"code": "STRL-DSL-1005", "id": "unexpected_token", "phase": "frontend_parse", "category": "syntax", "trigger": "Token cannot begin the production required at this position", "fixture_required": true},
        {"code": "STRL-DSL-1006", "id": "missing_delimiter", "phase": "frontend_parse", "category": "syntax", "trigger": "Required semicolon, opening brace, closing brace, or string delimiter is absent", "fixture_required": true},
        {"code": "STRL-DSL-1007", "id": "invalid_identifier", "phase": "frontend_parse", "category": "syntax", "trigger": "Capture identifier is not lowercase ASCII snake form or exceeds 64 bytes", "fixture_required": true},
        {"code": "STRL-DSL-1008", "id": "reserved_identifier", "phase": "frontend_parse", "category": "syntax", "trigger": "Capture identifier equals a reserved 1.0 word", "fixture_required": true},
        {"code": "STRL-DSL-1009", "id": "invalid_escape", "phase": "frontend_parse", "category": "syntax", "trigger": "String contains an escape outside the closed 1.0 escape set", "fixture_required": true},
        {"code": "STRL-DSL-1010", "id": "unterminated_string", "phase": "frontend_parse", "category": "syntax", "trigger": "String reaches a line ending or end of input without a closing quote", "fixture_required": true},
        {"code": "STRL-DSL-1011", "id": "invalid_unicode_scalar", "phase": "frontend_parse", "category": "syntax", "trigger": "Raw or escaped value is not a Unicode scalar", "fixture_required": true},
        {"code": "STRL-DSL-1012", "id": "invalid_integer", "phase": "frontend_parse", "category": "syntax", "trigger": "Integer has a leading zero, is missing, or exceeds 4294967295", "fixture_required": true},
        {"code": "STRL-DSL-1013", "id": "resource_limit", "phase": "frontend_parse", "category": "resource_limit", "trigger": "A governed source, nesting, node, capture, or set-member limit is exceeded", "fixture_required": false},
        {"code": "STRL-DSL-2001", "id": "empty_text", "phase": "semantic_lowering", "category": "semantic_validity", "trigger": "text literal decodes to an empty string", "fixture_required": true},
        {"code": "STRL-DSL-2002", "id": "invalid_set_scalar", "phase": "semantic_lowering", "category": "semantic_validity", "trigger": "scalar member or range endpoint decodes to other than one Unicode scalar", "fixture_required": true},
        {"code": "STRL-DSL-2003", "id": "invalid_range", "phase": "semantic_lowering", "category": "semantic_validity", "trigger": "Character range start exceeds its end", "fixture_required": true},
        {"code": "STRL-DSL-2004", "id": "invalid_repeat_bounds", "phase": "semantic_lowering", "category": "semantic_validity", "trigger": "Finite repetition maximum is less than its minimum", "fixture_required": true},
        {"code": "STRL-DSL-2005", "id": "insufficient_children", "phase": "semantic_lowering", "category": "semantic_validity", "trigger": "sequence or choice contains fewer than two children", "fixture_required": true},
        {"code": "STRL-DSL-2006", "id": "empty_character_set", "phase": "semantic_lowering", "category": "semantic_validity", "trigger": "character set contains no member", "fixture_required": true},
        {"code": "STRL-DSL-2007", "id": "duplicate_capture", "phase": "semantic_lowering", "category": "semantic_validity", "trigger": "Capture name duplicates an earlier declaration", "fixture_required": true},
        {"code": "STRL-DSL-2008", "id": "unresolved_capture", "phase": "semantic_lowering", "category": "semantic_validity", "trigger": "Reference names no capture declaration in the source", "fixture_required": true},
        {"code": "STRL-DSL-2009", "id": "reference_before_capture", "phase": "semantic_lowering", "category": "semantic_validity", "trigger": "Reference precedes or occurs within the declaration it names", "fixture_required": true},
        {"code": "STRL-DSL-3001", "id": "unsupported_target_annotation", "phase": "frontend_parse", "category": "syntax", "trigger": "Source attempts to select a target, profile, engine, or engine option", "fixture_required": true},
        {"code": "STRL-DSL-3002", "id": "unsupported_module_import", "phase": "frontend_parse", "category": "syntax", "trigger": "Source uses module, import, include, or export syntax", "fixture_required": true},
        {"code": "STRL-DSL-3003", "id": "unsupported_policy_directive", "phase": "frontend_parse", "category": "syntax", "trigger": "Source uses portability, safety, warning, suppression, or runtime policy syntax", "fixture_required": true},
        {"code": "STRL-DSL-3004", "id": "unsupported_regex_syntax", "phase": "frontend_parse", "category": "syntax", "trigger": "Source uses raw regex operators, delimiters, escapes, flags, or fragments", "fixture_required": true},
        {"code": "STRL-DSL-3005", "id": "unsupported_numeric_reference", "phase": "frontend_parse", "category": "syntax", "trigger": "Capture declaration or reference uses a numeric identity", "fixture_required": true}
    ],
    "deferred_constructs": [
        {"id": "composition.interpolation", "status": "unavailable-in-1.0", "rationale": "No host-value or interpolation contract may enter semantic source.", "diagnostic_code": "STRL-DSL-3004"},
        {"id": "composition.macros", "status": "unavailable-in-1.0", "rationale": "No hygienic macro, expansion provenance, or resource contract exists.", "diagnostic_code": "STRL-DSL-1005"},
        {"id": "frontend.raw-regex", "status": "unavailable-in-1.0", "rationale": "Raw regex belongs to the separate regex-compatible import frontend.", "diagnostic_code": "STRL-DSL-3004"},
        {"id": "module.import", "status": "unavailable-in-1.0", "rationale": "Canonical IR has no module identity, linkage, or cycle contract.", "diagnostic_code": "STRL-DSL-3002"},
        {"id": "policy.portability", "status": "unavailable-in-1.0", "rationale": "Portability decisions belong to analysis and exact target-profile planning.", "diagnostic_code": "STRL-DSL-3003"},
        {"id": "policy.safety", "status": "unavailable-in-1.0", "rationale": "Safety is structured analysis evidence, not a source suppression language.", "diagnostic_code": "STRL-DSL-3003"},
        {"id": "reference.numeric", "status": "unavailable-in-1.0", "rationale": "Logical capture identity is named and target capture numbers are emission details.", "diagnostic_code": "STRL-DSL-3005"},
        {"id": "semantic.conditionals", "status": "unavailable-in-1.0", "rationale": "Canonical Semantic IR has no conditional node.", "diagnostic_code": "STRL-DSL-1005"},
        {"id": "semantic.recursion", "status": "unavailable-in-1.0", "rationale": "Canonical Semantic IR has no recursion or subroutine node.", "diagnostic_code": "STRL-DSL-1005"},
        {"id": "target.annotation", "status": "unavailable-in-1.0", "rationale": "Exact target and profile selection belong only to CompileRequest.", "diagnostic_code": "STRL-DSL-3001"}
    ],
    "versioning": {
        "selection": "exact-major-minor-header",
        "compatible_addition": "new-minor-edition",
        "incompatible_change": "new-major-edition",
        "patch_scope": "editorial-or-additional-reviewed-evidence-only"
    }
}
