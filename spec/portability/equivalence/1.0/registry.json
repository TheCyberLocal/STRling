                },
                {
                    "id": "precondition.minimum_exactly_one",
                    "text": "The authored repetition minimum is exactly one."
                },
                {
                    "id": "precondition.maximum_exactly_one",
                    "text": "The authored repetition maximum is finite and exactly one."
                },
                {
                    "id": "precondition.mode_nonpossessive",
                    "text": "The repetition mode is greedy or lazy, never possessive."
                }
            ],
            "semantic_invariants": [
