                    "id": "invariant.accepted_language",
                    "text": "Exactly one body evaluation accepts the same language as its direct body."
                },
                {
                    "id": "invariant.match_capture_priority",
                    "text": "Matched span/value, capture participation/values, alternative priority, zero-length behavior, and Unicode/case options remain unchanged."
                },
