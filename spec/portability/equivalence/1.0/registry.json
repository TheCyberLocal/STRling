                    "text": "The optional action does not mutate the analyzed input or rewrite diagnostic evidence automatically."
                }
            ],
            "unsupported_conditions": [
                {
                    "id": "unsupported.possessive_mode",
                    "text": "Possessive exact-once is excluded because commitment can suppress backtracking into the body."
                },
                {
                    "id": "unsupported.nonexact_bounds",
                    "text": "Any minimum or maximum other than exactly one is outside this equivalence proof."
                },
                {
                    "id": "unsupported.implicit_application",
                    "text": "Diagnostics and portability planning cannot select this optional strategy without an explicit rewrite request."
