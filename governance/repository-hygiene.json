{
    "schema_version": 1,
    "scope": "tracked_files",
    "tracked_inventory_command": ["git", "ls-files", "--stage", "-z"],
    "maximum_file_size_bytes": 1048576,
    "prohibited_patterns": [
        {
            "id": "temporary-copies",
            "patterns": [
                "*.tmp",
                "**/*.tmp",
                "*.new",
                "**/*.new",
                "*.bak",
                "**/*.bak",
                "*.orig",
                "**/*.orig",
                "*~",
                "**/*~"
            ]
        },
        {
            "id": "editor-state",
            "patterns": [
                ".idea/**",
                "**/.idea/**",
                ".vscode/**",
                "**/.vscode/**",
                ".vs/**",
                "**/.vs/**",
                "*.code-workspace",
                "**/*.code-workspace",
                "*.suo",
                "**/*.suo",
                "*.user",
                "**/*.user",
                "*.swp",
                "**/*.swp"
            ]
        },
        {
            "id": "logs-and-test-state",
            "patterns": [
                "*.log",
                "**/*.log",
                "*.status",
                "**/*.status",
                ".rspec_status",
                "**/.rspec_status",
                "test_output.txt",
                "**/test_output.txt",
                "npm-debug.log*",
                "**/npm-debug.log*",
                "yarn-error.log*",
                "**/yarn-error.log*"
            ]
        },
        {
            "id": "coverage-output",
            "patterns": [
                ".coverage",
                "**/.coverage",
                "coverage/**",
                "**/coverage/**",
                "htmlcov/**",
                "**/htmlcov/**",
                "coverage.xml",
                "**/coverage.xml",
                "lcov.info",
                "**/lcov.info"
            ]
        },
        {
            "id": "package-products",
            "patterns": [
                "dist/**",
                "**/dist/**",
                "vendor/**",
                "**/vendor/**",
                "node_modules/**",
                "**/node_modules/**",
                "*.gem",
                "**/*.gem",
                "*.whl",
                "**/*.whl",
                "*.nupkg",
                "**/*.nupkg",
                "*.vsix",
                "**/*.vsix"
            ]
        },
        {
            "id": "compiler-and-build-output",
            "patterns": [
                "build/**",
                "**/build/**",
                "target/**",
                "**/target/**",
                "bin/**",
                "**/bin/**",
                "obj/**",
                "**/obj/**",
                ".build/**",
                "**/.build/**",
                ".dart_tool/**",
                "**/.dart_tool/**",
                ".gradle/**",
                "**/.gradle/**",
                "__pycache__/**",
                "**/__pycache__/**",
                "*.egg-info/**",
                "**/*.egg-info/**",
                "blib/**",
                "**/blib/**",
                "_build/**",
                "**/_build/**",
                "*.o",
                "**/*.o",
                "*.a",
                "**/*.a",
                "*.so",
                "**/*.so",
                "*.dylib",
                "**/*.dylib",
                "*.class",
                "**/*.class",
                "*.pyc",
                "**/*.pyc",
                "*.pyo",
                "**/*.pyo",
                "*.exe",
                "**/*.exe",
                "*.dll",
                "**/*.dll"
            ]
        },
        {
            "id": "archives-and-packages",
            "patterns": [
                "*.zip",
                "**/*.zip",
                "*.tar",
                "**/*.tar",
                "*.tgz",
                "**/*.tgz",
                "*.tar.gz",
                "**/*.tar.gz",
                "*.gz",
                "**/*.gz",
                "*.7z",
                "**/*.7z",
                "*.rar",
                "**/*.rar",
                "*.jar",
                "**/*.jar",
                "*.war",
                "**/*.war"
            ]
        },
        {
            "id": "credential-like-files",
            "patterns": [
                ".env",
                "**/.env",
                ".env.*",
                "**/.env.*",
                "credentials.json",
                "**/credentials.json",
                "credentials.yml",
                "**/credentials.yml",
                "secrets.json",
                "**/secrets.json",
                "id_rsa",
                "**/id_rsa",
                "id_ed25519",
                "**/id_ed25519",
                "*.pem",
                "**/*.pem",
                "*.p12",
                "**/*.p12",
                "*.pfx",
                "**/*.pfx",
                "*.key",
                "**/*.key"
            ]
        }
    ],
    "allowed_intentional_artifacts": [
        {
            "path": "tooling/lsp-server/examples/strling.code-workspace",
            "rule": "editor-state",
            "rationale": "This is a user-facing example workspace, not personal editor state."
        },
        {
            "path": "bindings/rust/src/bin/strling-cli.rs",
            "rule": "compiler-and-build-output",
            "rationale": "This is the Rust CLI source location defined by Cargo conventions, not compiler output."
        },
        {
            "path": "core/src/target/mod.rs",
            "rule": "compiler-and-build-output",
            "rationale": "This is the canonical kernel target-contract source module, not Cargo build output."
        },
        {
            "path": "core/src/target/profile.rs",
            "rule": "compiler-and-build-output",
            "rationale": "This is the canonical kernel target-profile source module, not Cargo build output."
        },
        {
            "path": "tests/adapters/2.0/legacy-baseline.json",
            "rule": "maximum-file-size",
            "rationale": "This immutable migration denominator preserves the exact pre-migration TypeScript/Python observation inventory and is verified by its registered certifier."
        },
        {
            "path": "tests/adapters/go-dart-swift-3.0/legacy-baseline.json",
            "rule": "maximum-file-size",
            "rationale": "This immutable migration denominator preserves the exact pre-migration Go/Dart/Swift observation inventory and is verified by its registered certifier."
        },
        {
            "path": "tests/adapters/dynamic-languages-3.0/legacy-baseline.json",
            "rule": "maximum-file-size",
            "rationale": "This immutable migration denominator preserves the exact pre-migration Ruby/PHP/Perl/Lua/R observation inventory and is verified by its registered certifier."
        }
    ],
    "generated_paths": [
        {
            "paths": [
                "tests/spec/**",
                "bindings/c/tests/fixtures/**",
                "bindings/swift/Tests/STRlingConformanceTests/Resources/**"
            ],
            "owner": "STRling fixture generation and binding copy pipelines",
            "text_normalization": "serializer_owned",
            "rationale": "Fixture bytes, including the absence of a final newline, are controlled by the producer and may be exact test inputs."
        },
        {
            "paths": [
                "package-lock.json",
                "**/package-lock.json",
                "bindings/dart/pubspec.lock",
                "bindings/php/composer.lock",
                "bindings/ruby/Gemfile.lock",
                "Cargo.lock",
                "core/internal/Cargo.lock"
            ],
            "owner": "Owning package manager",
            "text_normalization": "serializer_owned",
            "rationale": "Lock-file layout is controlled by the package manager."
        },
        {
            "paths": [
                "tooling/js_to_json_ast/out/**",
                "tooling/lsp-server/dist/**"
            ],
            "owner": "Owning repository generator",
            "text_normalization": "serializer_owned",
            "rationale": "Generated outputs must be reproduced rather than hand-normalized."
        }
    ],
    "binary_allowlist": [
        {
            "path": "bindings/interop/fuzz/corpus/deep-target-serialization/canonical.txt",
            "sha256": "ad65ddf953b9a12e22b32a34080f645df02365f689188cd5b659200904749e2a",
            "kind": "libFuzzer canonical seed",
            "rationale": "The leading byte selects the first governed target profile and the remaining bytes are the canonical literal payload."
        },
        {
            "path": "bindings/kotlin/gradle/wrapper/gradle-wrapper.jar",
            "sha256": "423cb469ccc0ecc31f0e4e1c309976198ccb734cdcbb7029d4bda0f18f57e8d9",
            "kind": "Gradle wrapper bootstrap",
            "rationale": "The repository-managed Gradle wrapper requires this pinned bootstrap JAR."
        },
        {
            "path": "tooling/lsp-server/strling-icon.png",
            "sha256": "b2969a0473e655b909e87bcf29778618c5352f339e2166831d3eebd32531ca96",
            "kind": "Language-server extension icon",
            "rationale": "The source image is an intentional package asset."
        }
    ],
    "text_policy": {
        "encoding": "utf-8",
        "default_line_ending": "lf",
        "crlf_paths": ["strling.ps1"],
        "require_final_newline": true,
        "forbid_trailing_whitespace": true,
        "extensions": [
            ".c",
            ".cc",
            ".cpp",
            ".cs",
            ".dart",
            ".ebnf",
            ".fs",
            ".fsi",
            ".fsx",
            ".go",
            ".h",
            ".hh",
            ".hpp",
            ".ini",
            ".java",
            ".js",
            ".json",
            ".kt",
            ".kts",
            ".lua",
            ".md",
            ".mjs",
            ".php",
            ".pl",
            ".pm",
            ".properties",
            ".ps1",
            ".py",
            ".r",
            ".rb",
            ".rockspec",
            ".rs",
            ".sh",
            ".sln",
            ".t",
            ".toml",
            ".ts",
            ".txt",
            ".xml",
            ".yaml",
            ".yml"
        ],
        "special_files": [
            ".gitattributes",
            ".gitignore",
            ".prettierignore",
            ".prettierrc",
            "DESCRIPTION",
            "Gemfile",
            "Makefile",
            "NAMESPACE",
            "Rakefile",
            "strling"
        ],
        "excluded_paths": [
            "tests/spec/**",
            "bindings/c/tests/fixtures/**",
            "bindings/swift/Tests/STRlingConformanceTests/Resources/**",
            "package-lock.json",
            "**/package-lock.json",
            "bindings/dart/pubspec.lock",
            "bindings/php/composer.lock",
            "bindings/ruby/Gemfile.lock",
            "Cargo.lock",
            "core/internal/Cargo.lock"
        ]
    },
    "private_key_markers": [
        "-----BEGIN RSA PRIVATE KEY-----",
        "-----BEGIN OPENSSH PRIVATE KEY-----",
        "-----BEGIN EC PRIVATE KEY-----",
        "-----BEGIN DSA PRIVATE KEY-----",
        "-----BEGIN PGP PRIVATE KEY BLOCK-----"
    ],
    "credential_marker_exclusions": [
        {
            "path": "governance/repository-hygiene.json",
            "rationale": "The policy must contain the literal private-key markers that the scanner detects."
        }
    ],
    "executable_allowlist": [
        "strling",
        "bindings/c/setup.sh",
        "bindings/kotlin/gradlew",
        "bindings/lua/run_tests.sh",
        "bindings/lua/setup.sh",
        "bindings/perl/setup.sh"
    ],
    "case_collision_waivers": [
        {
            "waiver": "WVR-PERL-PARSER-CASE-001",
            "paths": [
                "bindings/perl/lib/STRling/Core/Parser.pm",
                "bindings/perl/lib/STRling/Core/parser.pm"
            ]
        }
    ]
}
