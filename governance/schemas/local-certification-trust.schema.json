{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/governance/local-certification-trust.schema.json",
    "title": "STRling authoritative local certification trust policy",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "policy_kind",
        "signature_namespace",
        "bundle_path",
        "required_profiles",
        "allowed_waivers",
        "closure_paths",
        "authorized_certifiers"
    ],
    "properties": {
        "$schema": { "type": "string", "format": "uri" },
        "schema_version": { "const": "1.0.0" },
        "policy_kind": { "const": "strling-local-certification-trust" },
        "signature_namespace": { "const": "strling-local-certification-v1" },
        "bundle_path": { "type": "string", "minLength": 1 },
        "required_profiles": {
            "type": "array",
            "const": ["full", "release"]
        },
        "allowed_waivers": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^WVR-[A-Z0-9][A-Z0-9._-]{2,63}$"
            },
            "uniqueItems": true
        },
        "closure_paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
        },
        "authorized_certifiers": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "certifier_id",
                    "public_key",
                    "ssh_key_fingerprint",
                    "authorized_profiles",
                    "status"
                ],
                "properties": {
                    "certifier_id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{2,63}$"
                    },
                    "public_key": {
                        "type": "string",
                        "pattern": "^ssh-ed25519 [A-Za-z0-9+/=]+(?: .+)?$"
                    },
                    "ssh_key_fingerprint": {
                        "type": "string",
                        "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
                    },
                    "authorized_profiles": {
                        "type": "array",
                        "const": ["full", "release"]
                    },
                    "status": { "const": "active" }
                }
            }
        }
    }
}
