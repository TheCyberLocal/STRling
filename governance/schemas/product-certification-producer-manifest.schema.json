{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/governance/product-certification-producer-manifest.schema.json",
    "title": "STRling product certification producer manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "manifest_kind",
        "source_profile",
        "specification",
        "aggregate_policy",
        "evidence_areas",
        "producers",
        "claims"
    ],
    "properties": {
        "schema_version": { "const": "1.0.0" },
        "manifest_kind": {
            "const": "strling-product-certification-producers"
        },
        "source_profile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "artifact_schema_version",
                "definition_fingerprint"
            ],
            "properties": {
                "id": { "const": "full" },
                "artifact_schema_version": { "const": "1.0.0" },
                "definition_fingerprint": { "$ref": "#/$defs/sha256" }
            }
        },
        "specification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "version", "contract_suite_version"],
            "properties": {
                "status": {
                    "enum": ["unversioned-transitional", "ratified"]
                },
                "version": {
                    "type": ["string", "null"],
                    "minLength": 1
                },
                "contract_suite_version": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "status": { "const": "unversioned-transitional" }
                        },
                        "required": ["status"]
                    },
                    "then": { "properties": { "version": { "type": "null" } } }
                },
                {
                    "if": {
                        "properties": { "status": { "const": "ratified" } },
                        "required": ["status"]
                    },
                    "then": {
                        "properties": {
                            "version": { "type": "string", "minLength": 1 }
                        }
                    }
                }
            ]
        },
        "aggregate_policy": { "$ref": "#/$defs/aggregatePolicy" },
        "evidence_areas": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/evidenceArea" }
        },
        "producers": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/producer" }
        },
        "claims": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/claim" }
        }
    },
    "$defs": {
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "operationId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
        },
        "evidenceArea": {
            "enum": [
                "adapter-package",
                "architecture-governance",
                "canonical-compiler",
                "contracts-specification",
                "documentation",
                "interop-resilience",
                "migration",
                "repository-quality",
                "security-provenance",
                "target-conformance"
            ]
        },
        "resultContract": {
            "oneOf": [
                {
                    "enum": [
                        "certification-result-v1",
                        "documentation-result-v1",
                        "security-result-v1"
                    ]
                },
                { "type": "null" }
            ]
        },
        "aggregatePolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "version",
                "precedence",
                "incomplete_result_statuses",
                "neutral_result_statuses",
                "blocking_result_statuses"
            ],
            "properties": {
                "version": { "const": "1.0.0" },
                "precedence": {
                    "const": [
                        "failed",
                        "incomplete",
                        "unavailable",
                        "waived",
                        "passed"
                    ]
                },
                "incomplete_result_statuses": {
                    "const": [
                        "incomplete",
                        "not_yet_configured",
                        "not_yet_enforceable",
                        "skipped"
                    ]
                },
                "neutral_result_statuses": {
                    "const": ["not_applicable", "passed"]
                },
                "blocking_result_statuses": {
                    "const": [
                        "failed",
                        "incomplete",
                        "not_yet_configured",
                        "not_yet_enforceable",
                        "skipped",
                        "unavailable"
                    ]
                }
            }
        },
        "producer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "operation_id",
                "evidence_area",
                "requirement",
                "result_contract",
                "structured_operation_id"
            ],
            "properties": {
                "operation_id": { "$ref": "#/$defs/operationId" },
                "evidence_area": { "$ref": "#/$defs/evidenceArea" },
                "requirement": { "const": "required" },
                "result_contract": { "$ref": "#/$defs/resultContract" },
                "structured_operation_id": {
                    "type": ["string", "null"],
                    "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": { "result_contract": { "type": "null" } },
                        "required": ["result_contract"]
                    },
                    "then": {
                        "properties": {
                            "structured_operation_id": { "type": "null" }
                        }
                    },
                    "else": {
                        "properties": {
                            "structured_operation_id": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                }
            ]
        },
        "claim": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "claim_id",
                "description",
                "evidence_area",
                "source"
            ],
            "properties": {
                "claim_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
                },
                "description": { "type": "string", "minLength": 1 },
                "evidence_area": { "$ref": "#/$defs/evidenceArea" },
                "source": {
                    "oneOf": [
                        {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["all_profile_results"],
                            "properties": {
                                "all_profile_results": { "const": true }
                            }
                        },
                        {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["operations"],
                            "properties": {
                                "operations": {
                                    "type": "array",
                                    "minItems": 1,
                                    "uniqueItems": true,
                                    "items": { "$ref": "#/$defs/operationId" }
                                }
                            }
                        }
                    ]
                }
            }
        }
    }
}
