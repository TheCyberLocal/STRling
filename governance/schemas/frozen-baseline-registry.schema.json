{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/governance/frozen-baseline-registry.schema.json",
    "title": "STRling frozen baseline registry",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "baselines"],
    "properties": {
        "schema_version": { "const": "1.0.0" },
        "baselines": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "manifest", "sha256", "status"],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
                    },
                    "manifest": {
                        "type": "string",
                        "pattern": "^governance/baselines/[a-z0-9][a-z0-9._-]+\\.json$"
                    },
                    "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                    },
                    "status": { "const": "frozen" }
                }
            }
        }
    }
}

