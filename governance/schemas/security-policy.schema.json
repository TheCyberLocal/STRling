{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/governance/security-policy.schema.json",
    "title": "STRling baseline repository security policy",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "policy_version",
        "engine",
        "security_tools",
        "result_schema",
        "waiver_schema",
        "security_waivers",
        "statuses",
        "blocking_statuses",
        "dependency_roots",
        "manifest_names",
        "manifest_suffixes",
        "dependency_rules",
        "vulnerability_policy",
        "license_policy",
        "secret_policy",
        "workflow_policy"
    ],
    "properties": {
        "policy_version": { "const": 1 },
        "engine": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
                "name": { "const": "strling-repository-security" },
                "version": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                }
            }
        },
        "security_tools": { "type": "object" },
        "result_schema": {
            "const": "governance/schemas/security-result.schema.json"
        },
        "waiver_schema": { "const": "governance/schemas/waiver.schema.json" },
        "security_waivers": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^WVR-SEC-[A-Z0-9][A-Z0-9._-]{2,63}$"
            },
            "uniqueItems": true
        },
        "statuses": {
            "type": "array",
            "const": ["passed", "failed", "waived", "unavailable", "incomplete"]
        },
        "blocking_statuses": {
            "type": "array",
            "const": ["failed", "unavailable", "incomplete"]
        },
        "dependency_roots": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/dependencyRoot" }
        },
        "manifest_names": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
        },
        "manifest_suffixes": {
            "type": "array",
            "items": { "type": "string", "pattern": "^\\." },
            "uniqueItems": true
        },
        "dependency_rules": { "type": "object" },
        "vulnerability_policy": { "type": "object" },
        "license_policy": { "$ref": "#/$defs/licensePolicy" },
        "secret_policy": { "type": "object" },
        "workflow_policy": { "type": "object" }
    },
    "$defs": {
        "pathList": {
            "type": "array",
            "items": { "type": "string", "pattern": "^(?!/)(?!.*\\\\).+$" },
            "uniqueItems": true
        },
        "dependencyRoot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "ecosystem",
                "classification",
                "usage",
                "manifests",
                "locks",
                "lock_policy",
                "integrity_mode",
                "risk_mode"
            ],
            "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
                "ecosystem": { "type": "string", "minLength": 1 },
                "classification": {
                    "enum": ["actively_governed", "transitional", "unavailable"]
                },
                "usage": { "enum": ["runtime", "tooling_only"] },
                "manifests": { "$ref": "#/$defs/pathList" },
                "locks": { "$ref": "#/$defs/pathList" },
                "lock_policy": { "type": "string", "minLength": 1 },
                "integrity_mode": { "type": "string", "minLength": 1 },
                "risk_mode": { "type": "string", "minLength": 1 }
            }
        },
        "licensePolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "permitted",
                "prohibited",
                "scoped_permitted",
                "metadata_overrides",
                "unknown_is_blocking"
            ],
            "properties": {
                "evidence_manifest": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*\\\\).+$"
                },
                "permitted": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 },
                    "uniqueItems": true
                },
                "prohibited": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 },
                    "uniqueItems": true
                },
                "scoped_permitted": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/scopedLicenseDisposition" },
                    "uniqueItems": true
                },
                "metadata_overrides": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/licenseMetadataOverride" },
                    "uniqueItems": true
                },
                "unknown_is_blocking": { "const": true }
            }
        },
        "scopedLicenseDisposition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "ecosystem",
                "package",
                "version",
                "license",
                "dependency_roots",
                "required_usage",
                "evidence"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^LIC-[A-Z0-9][A-Z0-9._-]{2,63}$"
                },
                "ecosystem": { "type": "string", "minLength": 1 },
                "package": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 },
                "license": { "type": "string", "minLength": 1 },
                "dependency_roots": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]+$"
                    },
                    "uniqueItems": true
                },
                "required_usage": { "enum": ["runtime", "tooling_only"] },
                "selected_license": { "type": "string", "minLength": 1 },
                "license_material": {
                    "$ref": "#/$defs/licenseMaterialEvidence"
                },
                "reachability_evidence": {
                    "$ref": "#/$defs/licenseReachabilityEvidence"
                },
                "evidence": { "type": "string", "minLength": 1 }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "required_usage": { "const": "runtime" }
                        },
                        "required": ["required_usage"]
                    },
                    "then": { "required": ["reachability_evidence"] }
                }
            ]
        },
        "licenseReachabilityEvidence": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "manifest", "scope"],
                    "properties": {
                        "kind": { "const": "maven-direct-scope" },
                        "manifest": {
                            "type": "string",
                            "pattern": "^(?!/)(?!.*\\\\).+$"
                        },
                        "scope": { "const": "test" }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "lock", "configurations"],
                    "properties": {
                        "kind": { "const": "gradle-lock-configurations" },
                        "lock": {
                            "type": "string",
                            "pattern": "^(?!/)(?!.*\\\\).+$"
                        },
                        "configurations": {
                            "type": "array",
                            "minItems": 1,
                            "items": { "type": "string", "minLength": 1 },
                            "uniqueItems": true
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "manifest", "lock", "path"],
                    "properties": {
                        "kind": { "const": "renv-development-path" },
                        "manifest": {
                            "type": "string",
                            "pattern": "^(?!/)(?!.*\\\\).+$"
                        },
                        "lock": {
                            "type": "string",
                            "pattern": "^(?!/)(?!.*\\\\).+$"
                        },
                        "path": {
                            "type": "array",
                            "minItems": 2,
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["package", "version"],
                                "properties": {
                                    "package": { "type": "string", "minLength": 1 },
                                    "version": { "type": "string", "minLength": 1 }
                                }
                            }
                        }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "kind",
                        "manifest",
                        "lock",
                        "release_manifest",
                        "release_surface",
                        "path"
                    ],
                    "properties": {
                        "kind": { "const": "cpan-runtime-closure" },
                        "manifest": {
                            "type": "string",
                            "pattern": "^(?!/)(?!.*\\\\).+$"
                        },
                        "lock": {
                            "type": "string",
                            "pattern": "^(?!/)(?!.*\\\\).+$"
                        },
                        "release_manifest": {
                            "type": "string",
                            "pattern": "^(?!/)(?!.*\\\\).+$"
                        },
                        "release_surface": {
                            "type": "string",
                            "pattern": "^release:[a-z0-9-]+$"
                        },
                        "path": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["package", "version"],
                                "properties": {
                                    "package": { "type": "string", "minLength": 1 },
                                    "version": { "type": "string", "minLength": 1 }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "licenseMaterialEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "manifest",
                "archive_url",
                "archive_sha256",
                "license_path",
                "license_sha256"
            ],
            "properties": {
                "manifest": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*\\\\).+$"
                },
                "archive_url": { "type": "string", "format": "uri" },
                "archive_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                },
                "license_path": { "type": "string", "minLength": 1 },
                "license_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                }
            }
        },
        "licenseMetadataOverride": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "ecosystem",
                "package",
                "version",
                "license",
                "evidence"
            ],
            "properties": {
                "ecosystem": { "type": "string", "minLength": 1 },
                "package": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 },
                "license": { "type": "string", "minLength": 1 },
                "evidence": { "type": "string", "minLength": 1 }
            }
        }
    }
}
