{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/governance/profile-certification-artifact.schema.json",
    "title": "STRling profile certification artifact",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "artifact_kind",
        "deterministic_evidence",
        "evidence_fingerprint",
        "execution_metadata"
    ],
    "properties": {
        "schema_version": { "const": "1.0.0" },
        "artifact_kind": { "const": "strling-profile-certification" },
        "deterministic_evidence": {
            "$ref": "#/$defs/deterministicEvidence"
        },
        "evidence_fingerprint": { "$ref": "#/$defs/sha256" },
        "execution_metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["generated_at"],
            "properties": {
                "generated_at": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        }
    },
    "$defs": {
        "sha1": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "operationId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
        },
        "componentId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "resultStatus": {
            "enum": [
                "passed",
                "failed",
                "waived",
                "unavailable",
                "incomplete",
                "not_applicable",
                "not_yet_configured",
                "not_yet_enforceable"
            ]
        },
        "aggregateStatus": {
            "enum": ["passed", "failed", "waived", "unavailable", "incomplete"]
        },
        "nullableCommand": {
            "oneOf": [
                {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                },
                { "type": "null" }
            ]
        },
        "nullableExit": {
            "type": ["integer", "null"],
            "minimum": 0
        },
        "nullableReason": {
            "type": ["string", "null"],
            "minLength": 1
        },
        "toolEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "tool",
                "status",
                "expected",
                "actual",
                "command",
                "exit_code",
                "reason"
            ],
            "properties": {
                "tool": { "type": "string", "minLength": 1 },
                "status": {
                    "enum": [
                        "compatible",
                        "incompatible",
                        "transitional",
                        "deferred",
                        "unknown",
                        "unavailable"
                    ]
                },
                "expected": {
                    "type": ["string", "null"],
                    "minLength": 1
                },
                "actual": {
                    "type": ["string", "null"],
                    "minLength": 1
                },
                "command": { "$ref": "#/$defs/nullableCommand" },
                "exit_code": { "$ref": "#/$defs/nullableExit" },
                "reason": { "$ref": "#/$defs/nullableReason" }
            }
        },
        "operationEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "operation_id",
                "result_id",
                "component",
                "status",
                "command",
                "exit_code",
                "reason",
                "capability",
                "formatters",
                "environment",
                "waiver_references"
            ],
            "properties": {
                "operation_id": { "$ref": "#/$defs/operationId" },
                "result_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*@[a-z][a-z0-9-]*$"
                },
                "component": { "$ref": "#/$defs/componentId" },
                "status": { "$ref": "#/$defs/resultStatus" },
                "command": { "$ref": "#/$defs/nullableCommand" },
                "exit_code": { "$ref": "#/$defs/nullableExit" },
                "reason": { "$ref": "#/$defs/nullableReason" },
                "capability": {
                    "oneOf": [
                        {
                            "enum": [
                                "configured",
                                "enforced",
                                "not_applicable",
                                "not_yet_configured",
                                "not_yet_enforceable",
                                "unavailable"
                            ]
                        },
                        { "type": "null" }
                    ]
                },
                "formatters": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 },
                    "uniqueItems": true
                },
                "environment": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/toolEvidence" }
                },
                "waiver_references": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^WVR-[A-Z0-9][A-Z0-9._-]{2,63}$"
                    },
                    "uniqueItems": true
                },
                "structured_evidence": {
                    "type": "object"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": { "status": { "const": "waived" } },
                        "required": ["status"]
                    },
                    "then": {
                        "properties": {
                            "waiver_references": { "minItems": 1 }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "status": {
                                "enum": [
                                    "failed",
                                    "unavailable",
                                    "incomplete",
                                    "not_yet_configured",
                                    "not_yet_enforceable"
                                ]
                            }
                        },
                        "required": ["status"]
                    },
                    "then": {
                        "properties": {
                            "reason": { "type": "string", "minLength": 1 }
                        }
                    }
                }
            ]
        },
        "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "passed",
                "failed",
                "waived",
                "unavailable",
                "incomplete",
                "not_applicable",
                "not_yet_configured",
                "not_yet_enforceable"
            ],
            "properties": {
                "passed": { "type": "integer", "minimum": 0 },
                "failed": { "type": "integer", "minimum": 0 },
                "waived": { "type": "integer", "minimum": 0 },
                "unavailable": { "type": "integer", "minimum": 0 },
                "incomplete": { "type": "integer", "minimum": 0 },
                "not_applicable": { "type": "integer", "minimum": 0 },
                "not_yet_configured": {
                    "type": "integer",
                    "minimum": 0
                },
                "not_yet_enforceable": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "componentScope": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["mode"],
                    "properties": {
                        "mode": { "const": "profile-default" }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["mode"],
                    "properties": {
                        "mode": { "const": "all" }
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["mode", "component"],
                    "properties": {
                        "mode": { "const": "component" },
                        "component": { "$ref": "#/$defs/componentId" }
                    }
                }
            ]
        },
        "deterministicEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "repository",
                "profile",
                "component_scope",
                "operations",
                "aggregate"
            ],
            "properties": {
                "repository": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["commit", "dirty"],
                    "properties": {
                        "commit": { "$ref": "#/$defs/sha1" },
                        "dirty": { "type": "boolean" }
                    }
                },
                "profile": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "id",
                        "definition_version",
                        "definition_fingerprint",
                        "purpose",
                        "network_policy"
                    ],
                    "properties": {
                        "id": {
                            "enum": ["local", "pull-request", "full", "release"]
                        },
                        "definition_version": {
                            "type": "string",
                            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                        },
                        "definition_fingerprint": {
                            "$ref": "#/$defs/sha256"
                        },
                        "purpose": {
                            "type": "string",
                            "minLength": 1
                        },
                        "network_policy": {
                            "enum": ["offline", "allowed"]
                        }
                    }
                },
                "component_scope": { "$ref": "#/$defs/componentScope" },
                "operations": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/operationEvidence" }
                },
                "aggregate": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "status",
                        "exit_code",
                        "operation_count",
                        "counts"
                    ],
                    "properties": {
                        "status": { "$ref": "#/$defs/aggregateStatus" },
                        "exit_code": {
                            "type": "integer",
                            "enum": [0, 1]
                        },
                        "operation_count": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "counts": { "$ref": "#/$defs/counts" }
                    }
                }
            }
        }
    }
}
