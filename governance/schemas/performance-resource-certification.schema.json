{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/governance/performance-resource-certification.schema.json",
    "title": "STRling performance and resource certification contract",
    "oneOf": [
        { "$ref": "#/$defs/manifest" },
        { "$ref": "#/$defs/fixtureManifest" },
        { "$ref": "#/$defs/resourceInventory" },
        { "$ref": "#/$defs/hostAttestation" },
        { "$ref": "#/$defs/baseline" },
        { "$ref": "#/$defs/evidence" }
    ],
    "$defs": {
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "gitSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "repositoryPath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "fileReference": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
                "path": { "$ref": "#/$defs/repositoryPath" },
                "sha256": { "$ref": "#/$defs/sha256" }
            }
        },
        "artifactFingerprint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "bytes"],
            "properties": {
                "path": { "$ref": "#/$defs/repositoryPath" },
                "sha256": { "$ref": "#/$defs/sha256" },
                "bytes": { "type": "integer", "minimum": 1 }
            }
        },
        "artifactFingerprints": {
            "type": "object",
            "additionalProperties": false,
            "required": ["runner", "kernel", "interop"],
            "properties": {
                "runner": { "$ref": "#/$defs/artifactFingerprint" },
                "kernel": { "$ref": "#/$defs/artifactFingerprint" },
                "interop": { "$ref": "#/$defs/artifactFingerprint" }
            }
        },
        "processorTopology": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "logical_cpu",
                "online",
                "package_id",
                "die_id",
                "core_id",
                "core_type",
                "thread_siblings"
            ],
            "properties": {
                "logical_cpu": { "type": "integer", "minimum": 0 },
                "online": { "type": "boolean" },
                "package_id": { "type": "string", "minLength": 1 },
                "die_id": { "type": "string", "minLength": 1 },
                "core_id": { "type": "string", "minLength": 1 },
                "core_type": { "type": "string", "minLength": 1 },
                "thread_siblings": {
                    "type": "string",
                    "pattern": "^[0-9]+(?:[-,][0-9]+)*$"
                }
            }
        },
        "hostProcessor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "vendor_id",
                "family",
                "model",
                "stepping",
                "microcode",
                "model_name",
                "logical_cpu_count",
                "topology_sha256"
            ],
            "properties": {
                "vendor_id": { "type": "string", "minLength": 1 },
                "family": { "type": "string", "minLength": 1 },
                "model": { "type": "string", "minLength": 1 },
                "stepping": { "type": "string", "minLength": 1 },
                "microcode": { "type": "string", "minLength": 1 },
                "model_name": { "type": "string", "minLength": 1 },
                "logical_cpu_count": { "type": "integer", "minimum": 1 },
                "topology_sha256": { "$ref": "#/$defs/sha256" }
            }
        },
        "hostReservation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "mechanism",
                "reservation_id",
                "host_logical_processors",
                "host_physical_core_identity",
                "cpu_quota",
                "exclusive",
                "housekeeping_excluded",
                "unrelated_workloads_excluded",
                "evidence_sha256"
            ],
            "properties": {
                "mechanism": {
                    "enum": [
                        "bare-metal-cpuset-isolation",
                        "hypervisor-host-pinned"
                    ]
                },
                "reservation_id": { "type": "string", "minLength": 8 },
                "host_logical_processors": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "integer", "minimum": 0 }
                },
                "host_physical_core_identity": {
                    "type": "string",
                    "minLength": 1
                },
                "cpu_quota": { "const": "unlimited" },
                "exclusive": { "const": true },
                "housekeeping_excluded": { "const": true },
                "unrelated_workloads_excluded": { "const": true },
                "evidence_sha256": { "$ref": "#/$defs/sha256" }
            }
        },
        "cpuList": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 0 }
        },
        "bareMetalReservationEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "selected_cpu_topology",
                "host_topology",
                "online_cpus",
                "cgroup_path",
                "cgroup_cpuset_effective",
                "cgroup_cpu_max",
                "isolated_cpus",
                "nohz_full_cpus",
                "isolcpus",
                "rcu_nocbs",
                "irq_affinity",
                "governor",
                "energy_performance_preference",
                "thermal_throttle_counts",
                "unrelated_schedulable_tasks",
                "clocksource"
            ],
            "properties": {
                "selected_cpu_topology": {
                    "$ref": "#/$defs/processorTopology"
                },
                "host_topology": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/processorTopology" }
                },
                "online_cpus": { "$ref": "#/$defs/cpuList" },
                "cgroup_path": { "type": "string", "minLength": 1 },
                "cgroup_cpuset_effective": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                },
                "cgroup_cpu_max": {
                    "type": "string",
                    "pattern": "^max [1-9][0-9]*$"
                },
                "isolated_cpus": { "$ref": "#/$defs/cpuList" },
                "nohz_full_cpus": { "$ref": "#/$defs/cpuList" },
                "isolcpus": { "$ref": "#/$defs/cpuList" },
                "rcu_nocbs": { "$ref": "#/$defs/cpuList" },
                "irq_affinity": { "$ref": "#/$defs/cpuList" },
                "governor": { "const": "performance" },
                "energy_performance_preference": { "const": "performance" },
                "thermal_throttle_counts": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": { "type": "integer", "minimum": 0 }
                },
                "unrelated_schedulable_tasks": {
                    "type": "array",
                    "maxItems": 0
                },
                "clocksource": { "const": "tsc" }
            }
        },
        "conditioningPolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["policy_id", "executable_path", "executable_sha256"],
            "properties": {
                "policy_id": { "type": "string", "minLength": 8 },
                "executable_path": { "type": "string", "pattern": "^/" },
                "executable_sha256": { "$ref": "#/$defs/sha256" }
            }
        },
        "hostAttestation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "attestation_kind",
                "environment_kind",
                "host_id_sha256",
                "host_os",
                "host_kernel_or_hypervisor",
                "host_processor",
                "reservation",
                "reservation_evidence",
                "conditioning",
                "attestation_fingerprint"
            ],
            "properties": {
                "schema_version": { "const": "1.0.0" },
                "attestation_kind": {
                    "const": "strling-performance-host-reservation"
                },
                "environment_kind": {
                    "enum": ["dedicated-bare-metal", "hypervisor-host-pinned"]
                },
                "host_id_sha256": { "$ref": "#/$defs/sha256" },
                "host_os": { "type": "string", "minLength": 1 },
                "host_kernel_or_hypervisor": {
                    "type": "string",
                    "minLength": 1
                },
                "host_processor": { "$ref": "#/$defs/hostProcessor" },
                "reservation": { "$ref": "#/$defs/hostReservation" },
                "reservation_evidence": {
                    "$ref": "#/$defs/bareMetalReservationEvidence"
                },
                "conditioning": { "$ref": "#/$defs/conditioningPolicy" },
                "attestation_fingerprint": { "$ref": "#/$defs/sha256" }
            }
        },
        "executionResource": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "cgroup_version",
                "cgroup_path",
                "cgroup_cpuset_effective",
                "cgroup_cpu_max",
                "clocksource",
                "processor_topology"
            ],
            "properties": {
                "cgroup_version": { "const": 2 },
                "cgroup_path": { "type": "string", "minLength": 1 },
                "cgroup_cpuset_effective": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                },
                "cgroup_cpu_max": {
                    "type": "string",
                    "pattern": "^max [1-9][0-9]*$"
                },
                "clocksource": { "type": "string", "minLength": 1 },
                "processor_topology": { "$ref": "#/$defs/processorTopology" }
            }
        },
        "toolchainFingerprints": {
            "type": "object",
            "additionalProperties": false,
            "required": ["python", "rustc", "cargo"],
            "properties": {
                "python": { "$ref": "#/$defs/sha256" },
                "rustc": { "$ref": "#/$defs/sha256" },
                "cargo": { "$ref": "#/$defs/sha256" }
            }
        },
        "conditioningSnapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "status",
                "policy_id",
                "host_attestation_fingerprint",
                "conditioner_sha256",
                "selected_logical_cpu",
                "effective_cpu_affinity",
                "effective_cpuset",
                "cgroup_cpu_max",
                "clocksource",
                "thermal_state",
                "power_state",
                "unrelated_workloads_excluded",
                "snapshot_fingerprint"
            ],
            "properties": {
                "status": { "const": "passed" },
                "policy_id": { "type": "string", "minLength": 8 },
                "host_attestation_fingerprint": { "$ref": "#/$defs/sha256" },
                "conditioner_sha256": { "$ref": "#/$defs/sha256" },
                "selected_logical_cpu": { "type": "integer", "minimum": 0 },
                "effective_cpu_affinity": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": { "type": "integer", "minimum": 0 }
                },
                "effective_cpuset": { "type": "string", "pattern": "^[0-9]+$" },
                "cgroup_cpu_max": {
                    "type": "string",
                    "pattern": "^max [1-9][0-9]*$"
                },
                "clocksource": { "type": "string", "minLength": 1 },
                "thermal_state": { "const": "nominal" },
                "power_state": { "const": "governed" },
                "unrelated_workloads_excluded": { "const": true },
                "snapshot_fingerprint": { "$ref": "#/$defs/sha256" }
            }
        },
        "profileId": {
            "enum": ["local", "pull-request", "full"]
        },
        "operationId": {
            "type": "string",
            "pattern": "^(latency|memory|size|resource):[a-z0-9-]+$"
        },
        "fixtureId": {
            "type": "string",
            "pattern": "^fixture:[a-z0-9-]+$"
        },
        "budget": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "state",
                "relative_regression_basis_points",
                "absolute_ceiling",
                "rationale"
            ],
            "properties": {
                "state": { "enum": ["planned", "active", "not-applicable"] },
                "relative_regression_basis_points": {
                    "type": ["integer", "null"],
                    "minimum": 0,
                    "maximum": 10000
                },
                "absolute_ceiling": {
                    "type": ["integer", "null"],
                    "minimum": 0
                },
                "rationale": { "type": "string", "minLength": 20 }
            }
        },
        "operation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "family",
                "measurement_kind",
                "unit",
                "enforcement",
                "state",
                "fixture_ids",
                "profiles",
                "required_environment",
                "budget",
                "description"
            ],
            "properties": {
                "id": { "$ref": "#/$defs/operationId" },
                "family": {
                    "enum": [
                        "frontend",
                        "compiler-stage",
                        "target",
                        "product-entrypoint",
                        "transport",
                        "adapter",
                        "memory",
                        "artifact",
                        "resource-limit"
                    ]
                },
                "measurement_kind": {
                    "enum": [
                        "latency",
                        "peak-rss",
                        "artifact-bytes",
                        "resource-limit"
                    ]
                },
                "unit": {
                    "enum": ["nanoseconds", "microseconds", "bytes", "status"]
                },
                "enforcement": { "enum": ["hard", "informational"] },
                "state": { "enum": ["planned", "active"] },
                "fixture_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/fixtureId" }
                },
                "profiles": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/profileId" }
                },
                "required_environment": {
                    "enum": [
                        "any",
                        "fingerprinted-linux-x86_64",
                        "supported-host"
                    ]
                },
                "budget": { "$ref": "#/$defs/budget" },
                "description": { "type": "string", "minLength": 20 }
            }
        },
        "profilePartition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "operation_id",
                "maximum_duration_seconds",
                "operation_ids"
            ],
            "properties": {
                "id": { "$ref": "#/$defs/profileId" },
                "operation_id": {
                    "type": "string",
                    "pattern": "^certification\\.performance-resource-(local|pull-request|full)$"
                },
                "maximum_duration_seconds": { "type": "integer", "minimum": 1 },
                "operation_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/operationId" }
                }
            }
        },
        "measurementPolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "warmup_iterations",
                "sample_iterations",
                "baseline_repetitions",
                "minimum_sample_duration_nanoseconds",
                "batch_duration_safety_factor",
                "maximum_batch_iterations",
                "order_seed",
                "single_worker",
                "cpu_affinity_policy",
                "selected_logical_cpu",
                "host_reservation_policy",
                "cgroup_cpuset_policy",
                "cpu_quota_policy",
                "conditioning_policy",
                "randomize_operation_order",
                "statistics",
                "p95_method",
                "relative_budget_formula",
                "minimum_relative_budget_basis_points",
                "maximum_relative_budget_basis_points",
                "maximum_relative_mad_basis_points",
                "baseline_update_command",
                "ordinary_certification_may_update_baseline"
            ],
            "properties": {
                "warmup_iterations": { "type": "integer", "minimum": 1 },
                "sample_iterations": { "type": "integer", "minimum": 20 },
                "baseline_repetitions": { "type": "integer", "minimum": 3 },
                "minimum_sample_duration_nanoseconds": {
                    "type": "integer",
                    "minimum": 1
                },
                "batch_duration_safety_factor": {
                    "type": "integer",
                    "minimum": 1
                },
                "maximum_batch_iterations": {
                    "type": "integer",
                    "minimum": 1
                },
                "order_seed": { "type": "integer", "minimum": 1 },
                "single_worker": { "const": true },
                "cpu_affinity_policy": {
                    "const": "single-fixed-logical-cpu"
                },
                "selected_logical_cpu": {
                    "type": "integer",
                    "minimum": 0
                },
                "host_reservation_policy": {
                    "const": "dedicated-or-host-pinned-exclusive"
                },
                "cgroup_cpuset_policy": {
                    "const": "single-cpu-effective"
                },
                "cpu_quota_policy": { "const": "unlimited" },
                "conditioning_policy": {
                    "const": "authenticated-identical-before-each-repetition"
                },
                "randomize_operation_order": { "const": true },
                "statistics": {
                    "type": "array",
                    "const": ["median", "p95", "mad"]
                },
                "p95_method": { "const": "nearest-rank" },
                "relative_budget_formula": {
                    "const": "max(floor, ceil(6 * mad / median * 10000))"
                },
                "minimum_relative_budget_basis_points": {
                    "type": "integer",
                    "minimum": 1
                },
                "maximum_relative_budget_basis_points": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                },
                "maximum_relative_mad_basis_points": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                },
                "baseline_update_command": {
                    "type": "string",
                    "minLength": 20
                },
                "ordinary_certification_may_update_baseline": { "const": false }
            }
        },
        "manifest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "manifest_kind",
                "task_start_commit",
                "authority",
                "fixture_manifest",
                "resource_inventory",
                "measurement_policy",
                "profile_partitions",
                "operations",
                "expected_counts",
                "manifest_fingerprint"
            ],
            "properties": {
                "schema_version": { "const": "1.0.0" },
                "manifest_kind": {
                    "const": "strling-performance-resource-manifest"
                },
                "task_start_commit": { "$ref": "#/$defs/gitSha" },
                "authority": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "semantic_authority",
                        "resource_authority",
                        "target_runtime_performance",
                        "baseline_policy"
                    ],
                    "properties": {
                        "semantic_authority": {
                            "const": "specification-and-contracts"
                        },
                        "resource_authority": {
                            "const": "canonical-source-declarations-and-tests"
                        },
                        "target_runtime_performance": { "const": "excluded" },
                        "baseline_policy": {
                            "const": "explicit-attributable-update-only"
                        }
                    }
                },
                "fixture_manifest": { "$ref": "#/$defs/fileReference" },
                "resource_inventory": { "$ref": "#/$defs/fileReference" },
                "measurement_policy": { "$ref": "#/$defs/measurementPolicy" },
                "profile_partitions": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": { "$ref": "#/$defs/profilePartition" }
                },
                "operations": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/operation" }
                },
                "expected_counts": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "operations",
                        "performance_operations",
                        "resource_operations",
                        "fixtures",
                        "resource_declarations"
                    ],
                    "properties": {
                        "operations": { "type": "integer", "minimum": 1 },
                        "performance_operations": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "resource_operations": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "fixtures": { "type": "integer", "minimum": 1 },
                        "resource_declarations": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                },
                "manifest_fingerprint": { "$ref": "#/$defs/sha256" }
            }
        },
        "fixture": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "class",
                "input_kind",
                "payload",
                "payload_fingerprint",
                "bounded_by",
                "description"
            ],
            "properties": {
                "id": { "$ref": "#/$defs/fixtureId" },
                "class": {
                    "enum": ["tiny", "common", "large", "pathological"]
                },
                "input_kind": {
                    "enum": [
                        "semantic",
                        "legacy-regex",
                        "simply",
                        "interop-protocol"
                    ]
                },
                "payload": { "type": "object" },
                "payload_fingerprint": { "$ref": "#/$defs/sha256" },
                "bounded_by": { "type": "string", "minLength": 10 },
                "description": { "type": "string", "minLength": 20 }
            }
        },
        "fixtureManifest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "fixture_kind",
                "fixtures",
                "fixture_manifest_fingerprint"
            ],
            "properties": {
                "schema_version": { "const": "1.0.0" },
                "fixture_kind": { "const": "strling-performance-fixtures" },
                "fixtures": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/fixture" }
                },
                "fixture_manifest_fingerprint": { "$ref": "#/$defs/sha256" }
            }
        },
        "resourceDeclaration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "expression"],
            "properties": {
                "name": { "type": "string", "pattern": "^MAX_[A-Z0-9_]+$" },
                "expression": { "type": "string", "minLength": 1 }
            }
        },
        "resourceFamily": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sources", "test_sources", "disposition"],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^resource-family:[a-z0-9-]+$"
                },
                "sources": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["path", "declarations"],
                        "properties": {
                            "path": { "$ref": "#/$defs/repositoryPath" },
                            "declarations": {
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                    "$ref": "#/$defs/resourceDeclaration"
                                }
                            }
                        }
                    }
                },
                "test_sources": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/fileReference" }
                },
                "disposition": { "const": "read-only-existing-limit" }
            }
        },
        "resourceInventory": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "inventory_kind",
                "families",
                "declaration_count",
                "inventory_fingerprint"
            ],
            "properties": {
                "schema_version": { "const": "1.0.0" },
                "inventory_kind": {
                    "const": "strling-resource-limit-inventory"
                },
                "families": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/resourceFamily" }
                },
                "declaration_count": { "type": "integer", "minimum": 1 },
                "inventory_fingerprint": { "$ref": "#/$defs/sha256" }
            }
        },
        "environment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "os",
                "os_version",
                "architecture",
                "cpu_model",
                "logical_cpu_count",
                "memory_bytes",
                "python_version",
                "glibc_version",
                "rustc_version",
                "cargo_version",
                "toolchain_sha256",
                "target_triple",
                "build_profile",
                "feature_set",
                "cpu_affinity_policy",
                "selected_logical_cpu",
                "effective_cpu_affinity",
                "effective_cpuset",
                "execution_resource",
                "host_attestation",
                "host_attestation_fingerprint"
            ],
            "properties": {
                "os": { "type": "string", "minLength": 1 },
                "os_version": { "type": "string", "minLength": 1 },
                "architecture": { "type": "string", "minLength": 1 },
                "cpu_model": { "type": "string", "minLength": 1 },
                "logical_cpu_count": { "type": "integer", "minimum": 1 },
                "memory_bytes": { "type": "integer", "minimum": 1 },
                "python_version": { "type": "string", "minLength": 1 },
                "glibc_version": { "type": "string", "minLength": 1 },
                "rustc_version": { "type": "string", "minLength": 1 },
                "cargo_version": { "type": "string", "minLength": 1 },
                "toolchain_sha256": { "$ref": "#/$defs/toolchainFingerprints" },
                "target_triple": { "type": "string", "minLength": 1 },
                "build_profile": { "const": "release" },
                "feature_set": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "type": "string" }
                },
                "cpu_affinity_policy": {
                    "const": "single-fixed-logical-cpu"
                },
                "selected_logical_cpu": {
                    "type": "integer",
                    "minimum": 0
                },
                "effective_cpu_affinity": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "integer", "minimum": 0 }
                },
                "effective_cpuset": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                },
                "execution_resource": { "$ref": "#/$defs/executionResource" },
                "host_attestation": { "$ref": "#/$defs/hostAttestation" },
                "host_attestation_fingerprint": { "$ref": "#/$defs/sha256" }
            }
        },
        "statistics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sample_count",
                "median",
                "p95",
                "mad",
                "minimum",
                "maximum"
            ],
            "properties": {
                "sample_count": { "type": "integer", "minimum": 1 },
                "median": { "type": "integer", "minimum": 0 },
                "p95": { "type": "integer", "minimum": 0 },
                "mad": { "type": "integer", "minimum": 0 },
                "minimum": { "type": "integer", "minimum": 0 },
                "maximum": { "type": "integer", "minimum": 0 }
            }
        },
        "baselineMeasurement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "operation_id",
                "fixture_id",
                "unit",
                "repetitions",
                "batch_iterations",
                "batch_duration_repetitions",
                "samples",
                "statistics",
                "budget",
                "environment_fingerprint"
            ],
            "properties": {
                "operation_id": { "$ref": "#/$defs/operationId" },
                "fixture_id": {
                    "oneOf": [
                        { "$ref": "#/$defs/fixtureId" },
                        { "type": "null" }
                    ]
                },
                "unit": { "enum": ["nanoseconds", "microseconds", "bytes"] },
                "repetitions": {
                    "type": "array",
                    "minItems": 3,
                    "items": {
                        "type": "array",
                        "minItems": 1,
                        "items": { "type": "integer", "minimum": 0 }
                    }
                },
                "batch_iterations": { "type": "integer", "minimum": 1 },
                "batch_duration_repetitions": {
                    "oneOf": [
                        {
                            "type": "array",
                            "minItems": 3,
                            "items": {
                                "type": "array",
                                "minItems": 1,
                                "items": { "type": "integer", "minimum": 1 }
                            }
                        },
                        { "type": "null" }
                    ]
                },
                "samples": {
                    "type": "array",
                    "minItems": 3,
                    "items": { "type": "integer", "minimum": 0 }
                },
                "statistics": { "$ref": "#/$defs/statistics" },
                "budget": { "$ref": "#/$defs/budget" },
                "environment_fingerprint": { "$ref": "#/$defs/sha256" }
            }
        },
        "baseline": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "baseline_kind",
                "baseline_state",
                "manifest_fingerprint",
                "fixture_manifest_fingerprint",
                "source_commit",
                "environment",
                "environment_fingerprint",
                "artifact_fingerprints",
                "conditioning_repetitions",
                "measurements",
                "update_command",
                "update_rationale",
                "baseline_fingerprint"
            ],
            "properties": {
                "schema_version": { "const": "1.0.0" },
                "baseline_kind": { "const": "strling-performance-baseline" },
                "baseline_state": { "enum": ["planned", "active"] },
                "manifest_fingerprint": { "$ref": "#/$defs/sha256" },
                "fixture_manifest_fingerprint": { "$ref": "#/$defs/sha256" },
                "source_commit": { "$ref": "#/$defs/gitSha" },
                "environment": { "$ref": "#/$defs/environment" },
                "environment_fingerprint": { "$ref": "#/$defs/sha256" },
                "artifact_fingerprints": {
                    "oneOf": [
                        { "$ref": "#/$defs/artifactFingerprints" },
                        { "type": "object", "maxProperties": 0 }
                    ]
                },
                "conditioning_repetitions": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/conditioningSnapshot" }
                },
                "measurements": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/baselineMeasurement" }
                },
                "update_command": { "type": "string", "minLength": 20 },
                "update_rationale": { "type": "string", "minLength": 20 },
                "baseline_fingerprint": { "$ref": "#/$defs/sha256" }
            }
        },
        "check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "details"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "status": { "enum": ["passed", "failed", "unavailable"] },
                "details": { "type": "object" }
            }
        },
        "deterministicEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile", "status", "checks"],
            "properties": {
                "profile": { "$ref": "#/$defs/profileId" },
                "status": { "enum": ["passed", "failed", "unavailable"] },
                "checks": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/check" }
                }
            }
        },
        "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "evidence_kind",
                "manifest_fingerprint",
                "commit",
                "deterministic_evidence",
                "evidence_fingerprint",
                "disclaimer"
            ],
            "properties": {
                "schema_version": { "const": "certification-result-v1" },
                "evidence_kind": {
                    "enum": ["synthetic-contract-fixture", "live-certification"]
                },
                "manifest_fingerprint": { "$ref": "#/$defs/sha256" },
                "commit": { "$ref": "#/$defs/gitSha" },
                "deterministic_evidence": {
                    "$ref": "#/$defs/deterministicEvidence"
                },
                "evidence_fingerprint": { "$ref": "#/$defs/sha256" },
                "disclaimer": { "type": "string", "minLength": 30 }
            }
        }
    }
}
