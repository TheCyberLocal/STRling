{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/governance/performance-resource-certification.schema.json",
    "title": "STRling performance and resource certification contract",
    "oneOf": [
        { "$ref": "#/$defs/manifest" },
        { "$ref": "#/$defs/fixtureManifest" },
        { "$ref": "#/$defs/resourceInventory" },
        { "$ref": "#/$defs/baseline" },
        { "$ref": "#/$defs/evidence" }
    ],
    "$defs": {
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "gitSha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "repositoryPath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "fileReference": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
                "path": { "$ref": "#/$defs/repositoryPath" },
                "sha256": { "$ref": "#/$defs/sha256" }
            }
        },
        "profileId": {
            "enum": ["local", "pull-request", "full"]
        },
        "operationId": {
            "type": "string",
            "pattern": "^(latency|memory|size|resource):[a-z0-9-]+$"
        },
        "fixtureId": {
            "type": "string",
            "pattern": "^fixture:[a-z0-9-]+$"
        },
        "budget": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "state",
                "relative_regression_basis_points",
                "absolute_ceiling",
                "rationale"
            ],
            "properties": {
                "state": { "enum": ["planned", "active", "not-applicable"] },
                "relative_regression_basis_points": {
                    "type": ["integer", "null"],
                    "minimum": 0,
                    "maximum": 10000
                },
                "absolute_ceiling": {
                    "type": ["integer", "null"],
                    "minimum": 0
                },
                "rationale": { "type": "string", "minLength": 20 }
            }
        },
        "operation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "family",
                "measurement_kind",
                "unit",
                "enforcement",
                "state",
                "fixture_ids",
                "profiles",
                "required_environment",
                "budget",
                "description"
            ],
            "properties": {
                "id": { "$ref": "#/$defs/operationId" },
                "family": {
                    "enum": [
                        "frontend",
                        "compiler-stage",
                        "target",
                        "product-entrypoint",
                        "transport",
                        "adapter",
                        "memory",
                        "artifact",
                        "resource-limit"
                    ]
                },
                "measurement_kind": {
                    "enum": [
                        "latency",
                        "peak-rss",
                        "artifact-bytes",
                        "resource-limit"
                    ]
                },
                "unit": {
                    "enum": ["nanoseconds", "microseconds", "bytes", "status"]
                },
                "enforcement": { "enum": ["hard", "informational"] },
                "state": { "enum": ["planned", "active"] },
                "fixture_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/fixtureId" }
                },
                "profiles": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/profileId" }
                },
                "required_environment": {
                    "enum": [
                        "any",
                        "fingerprinted-linux-x86_64",
                        "supported-host"
                    ]
                },
                "budget": { "$ref": "#/$defs/budget" },
                "description": { "type": "string", "minLength": 20 }
            }
        },
        "profilePartition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "operation_id",
                "maximum_duration_seconds",
                "operation_ids"
            ],
            "properties": {
                "id": { "$ref": "#/$defs/profileId" },
                "operation_id": {
                    "type": "string",
                    "pattern": "^certification\\.performance-resource-(local|pull-request|full)$"
                },
                "maximum_duration_seconds": { "type": "integer", "minimum": 1 },
                "operation_ids": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/operationId" }
                }
            }
        },
        "measurementPolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "warmup_iterations",
                "sample_iterations",
                "baseline_repetitions",
                "minimum_sample_duration_nanoseconds",
                "batch_duration_safety_factor",
                "maximum_batch_iterations",
                "order_seed",
                "single_worker",
                "randomize_operation_order",
                "statistics",
                "p95_method",
                "relative_budget_formula",
                "minimum_relative_budget_basis_points",
                "maximum_relative_budget_basis_points",
                "maximum_relative_mad_basis_points",
                "baseline_update_command",
                "ordinary_certification_may_update_baseline"
            ],
            "properties": {
                "warmup_iterations": { "type": "integer", "minimum": 1 },
                "sample_iterations": { "type": "integer", "minimum": 20 },
                "baseline_repetitions": { "type": "integer", "minimum": 3 },
                "minimum_sample_duration_nanoseconds": {
                    "type": "integer",
                    "minimum": 1
                },
                "batch_duration_safety_factor": {
                    "type": "integer",
                    "minimum": 1
                },
                "maximum_batch_iterations": {
                    "type": "integer",
                    "minimum": 1
                },
                "order_seed": { "type": "integer", "minimum": 1 },
                "single_worker": { "const": true },
                "randomize_operation_order": { "const": true },
                "statistics": {
                    "type": "array",
                    "const": ["median", "p95", "mad"]
                },
                "p95_method": { "const": "nearest-rank" },
                "relative_budget_formula": {
                    "const": "max(floor, ceil(6 * mad / median * 10000))"
                },
                "minimum_relative_budget_basis_points": {
                    "type": "integer",
                    "minimum": 1
                },
                "maximum_relative_budget_basis_points": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                },
                "maximum_relative_mad_basis_points": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                },
                "baseline_update_command": {
                    "type": "string",
                    "minLength": 20
                },
                "ordinary_certification_may_update_baseline": { "const": false }
            }
        },
        "manifest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "manifest_kind",
                "task_start_commit",
                "authority",
                "fixture_manifest",
                "resource_inventory",
                "measurement_policy",
                "profile_partitions",
                "operations",
                "expected_counts",
                "manifest_fingerprint"
            ],
            "properties": {
                "schema_version": { "const": "1.0.0" },
                "manifest_kind": {
                    "const": "strling-performance-resource-manifest"
                },
                "task_start_commit": { "$ref": "#/$defs/gitSha" },
                "authority": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "semantic_authority",
                        "resource_authority",
                        "target_runtime_performance",
                        "baseline_policy"
                    ],
                    "properties": {
                        "semantic_authority": {
                            "const": "specification-and-contracts"
                        },
                        "resource_authority": {
                            "const": "canonical-source-declarations-and-tests"
                        },
                        "target_runtime_performance": { "const": "excluded" },
                        "baseline_policy": {
                            "const": "explicit-attributable-update-only"
                        }
                    }
                },
                "fixture_manifest": { "$ref": "#/$defs/fileReference" },
                "resource_inventory": { "$ref": "#/$defs/fileReference" },
                "measurement_policy": { "$ref": "#/$defs/measurementPolicy" },
                "profile_partitions": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": { "$ref": "#/$defs/profilePartition" }
                },
                "operations": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/operation" }
                },
                "expected_counts": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "operations",
                        "performance_operations",
                        "resource_operations",
                        "fixtures",
                        "resource_declarations"
                    ],
                    "properties": {
                        "operations": { "type": "integer", "minimum": 1 },
                        "performance_operations": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "resource_operations": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "fixtures": { "type": "integer", "minimum": 1 },
                        "resource_declarations": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                },
                "manifest_fingerprint": { "$ref": "#/$defs/sha256" }
            }
        },
        "fixture": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "class",
                "input_kind",
                "payload",
                "payload_fingerprint",
                "bounded_by",
                "description"
            ],
            "properties": {
                "id": { "$ref": "#/$defs/fixtureId" },
                "class": {
                    "enum": ["tiny", "common", "large", "pathological"]
                },
                "input_kind": {
                    "enum": [
                        "semantic",
                        "legacy-regex",
                        "simply",
                        "interop-protocol"
                    ]
                },
                "payload": { "type": "object" },
                "payload_fingerprint": { "$ref": "#/$defs/sha256" },
                "bounded_by": { "type": "string", "minLength": 10 },
                "description": { "type": "string", "minLength": 20 }
            }
        },
        "fixtureManifest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "fixture_kind",
                "fixtures",
                "fixture_manifest_fingerprint"
            ],
            "properties": {
                "schema_version": { "const": "1.0.0" },
                "fixture_kind": { "const": "strling-performance-fixtures" },
                "fixtures": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/fixture" }
                },
                "fixture_manifest_fingerprint": { "$ref": "#/$defs/sha256" }
            }
        },
        "resourceDeclaration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "expression"],
            "properties": {
                "name": { "type": "string", "pattern": "^MAX_[A-Z0-9_]+$" },
                "expression": { "type": "string", "minLength": 1 }
            }
        },
        "resourceFamily": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sources", "test_sources", "disposition"],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^resource-family:[a-z0-9-]+$"
                },
                "sources": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["path", "declarations"],
                        "properties": {
                            "path": { "$ref": "#/$defs/repositoryPath" },
                            "declarations": {
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                    "$ref": "#/$defs/resourceDeclaration"
                                }
                            }
                        }
                    }
                },
                "test_sources": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/fileReference" }
                },
                "disposition": { "const": "read-only-existing-limit" }
            }
        },
        "resourceInventory": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "inventory_kind",
                "families",
                "declaration_count",
                "inventory_fingerprint"
            ],
            "properties": {
                "schema_version": { "const": "1.0.0" },
                "inventory_kind": {
                    "const": "strling-resource-limit-inventory"
                },
                "families": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/resourceFamily" }
                },
                "declaration_count": { "type": "integer", "minimum": 1 },
                "inventory_fingerprint": { "$ref": "#/$defs/sha256" }
            }
        },
        "environment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "os",
                "os_version",
                "architecture",
                "cpu_model",
                "logical_cpu_count",
                "memory_bytes",
                "rustc_version",
                "cargo_version",
                "target_triple",
                "build_profile",
                "feature_set"
            ],
            "properties": {
                "os": { "type": "string", "minLength": 1 },
                "os_version": { "type": "string", "minLength": 1 },
                "architecture": { "type": "string", "minLength": 1 },
                "cpu_model": { "type": "string", "minLength": 1 },
                "logical_cpu_count": { "type": "integer", "minimum": 1 },
                "memory_bytes": { "type": "integer", "minimum": 1 },
                "rustc_version": { "type": "string", "minLength": 1 },
                "cargo_version": { "type": "string", "minLength": 1 },
                "target_triple": { "type": "string", "minLength": 1 },
                "build_profile": { "const": "release" },
                "feature_set": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "type": "string" }
                }
            }
        },
        "statistics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sample_count",
                "median",
                "p95",
                "mad",
                "minimum",
                "maximum"
            ],
            "properties": {
                "sample_count": { "type": "integer", "minimum": 1 },
                "median": { "type": "integer", "minimum": 0 },
                "p95": { "type": "integer", "minimum": 0 },
                "mad": { "type": "integer", "minimum": 0 },
                "minimum": { "type": "integer", "minimum": 0 },
                "maximum": { "type": "integer", "minimum": 0 }
            }
        },
        "baselineMeasurement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "operation_id",
                "fixture_id",
                "unit",
                "repetitions",
                "batch_iterations",
                "batch_duration_repetitions",
                "samples",
                "statistics",
                "budget",
                "environment_fingerprint"
            ],
            "properties": {
                "operation_id": { "$ref": "#/$defs/operationId" },
                "fixture_id": {
                    "oneOf": [
                        { "$ref": "#/$defs/fixtureId" },
                        { "type": "null" }
                    ]
                },
                "unit": { "enum": ["nanoseconds", "microseconds", "bytes"] },
                "repetitions": {
                    "type": "array",
                    "minItems": 3,
                    "items": {
                        "type": "array",
                        "minItems": 1,
                        "items": { "type": "integer", "minimum": 0 }
                    }
                },
                "batch_iterations": { "type": "integer", "minimum": 1 },
                "batch_duration_repetitions": {
                    "oneOf": [
                        {
                            "type": "array",
                            "minItems": 3,
                            "items": {
                                "type": "array",
                                "minItems": 1,
                                "items": { "type": "integer", "minimum": 1 }
                            }
                        },
                        { "type": "null" }
                    ]
                },
                "samples": {
                    "type": "array",
                    "minItems": 3,
                    "items": { "type": "integer", "minimum": 0 }
                },
                "statistics": { "$ref": "#/$defs/statistics" },
                "budget": { "$ref": "#/$defs/budget" },
                "environment_fingerprint": { "$ref": "#/$defs/sha256" }
            }
        },
        "baseline": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "baseline_kind",
                "baseline_state",
                "manifest_fingerprint",
                "fixture_manifest_fingerprint",
                "source_commit",
                "environment",
                "environment_fingerprint",
                "measurements",
                "update_command",
                "update_rationale",
                "baseline_fingerprint"
            ],
            "properties": {
                "schema_version": { "const": "1.0.0" },
                "baseline_kind": { "const": "strling-performance-baseline" },
                "baseline_state": { "enum": ["planned", "active"] },
                "manifest_fingerprint": { "$ref": "#/$defs/sha256" },
                "fixture_manifest_fingerprint": { "$ref": "#/$defs/sha256" },
                "source_commit": { "$ref": "#/$defs/gitSha" },
                "environment": { "$ref": "#/$defs/environment" },
                "environment_fingerprint": { "$ref": "#/$defs/sha256" },
                "measurements": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/baselineMeasurement" }
                },
                "update_command": { "type": "string", "minLength": 20 },
                "update_rationale": { "type": "string", "minLength": 20 },
                "baseline_fingerprint": { "$ref": "#/$defs/sha256" }
            }
        },
        "check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "details"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "status": { "enum": ["passed", "failed", "unavailable"] },
                "details": { "type": "object" }
            }
        },
        "deterministicEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile", "status", "checks"],
            "properties": {
                "profile": { "$ref": "#/$defs/profileId" },
                "status": { "enum": ["passed", "failed", "unavailable"] },
                "checks": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/check" }
                }
            }
        },
        "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "evidence_kind",
                "manifest_fingerprint",
                "commit",
                "deterministic_evidence",
                "evidence_fingerprint",
                "disclaimer"
            ],
            "properties": {
                "schema_version": { "const": "certification-result-v1" },
                "evidence_kind": {
                    "enum": ["synthetic-contract-fixture", "live-certification"]
                },
                "manifest_fingerprint": { "$ref": "#/$defs/sha256" },
                "commit": { "$ref": "#/$defs/gitSha" },
                "deterministic_evidence": {
                    "$ref": "#/$defs/deterministicEvidence"
                },
                "evidence_fingerprint": { "$ref": "#/$defs/sha256" },
                "disclaimer": { "type": "string", "minLength": 30 }
            }
        }
    }
}
