{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/governance/task-record.schema.json",
    "title": "STRling governance task record",
    "description": "A record of scope, verification, completion, and readiness for contained engineering work.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "record_version",
        "title",
        "status",
        "objective",
        "scope",
        "change_classification",
        "required_verification",
        "checkpoints",
        "commits"
    ],
    "properties": {
        "record_version": {
            "const": "1.0.0"
        },
        "title": {
            "type": "string",
            "minLength": 1,
            "description": "A durable, capability-oriented name rather than a campaign code."
        },
        "status": {
            "enum": ["planned", "in_progress", "complete", "blocked"]
        },
        "objective": {
            "type": "string",
            "minLength": 1
        },
        "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allowed_paths", "forbidden_paths"],
            "properties": {
                "allowed_paths": {
                    "$ref": "#/$defs/pathSet"
                },
                "forbidden_paths": {
                    "$ref": "#/$defs/pathSet"
                }
            }
        },
        "change_classification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["behavioral_change", "public_api_change"],
            "properties": {
                "behavioral_change": {
                    "enum": [
                        "none",
                        "behavior-preserving",
                        "intentional-compatible",
                        "intentional-breaking"
                    ]
                },
                "public_api_change": {
                    "enum": ["none", "compatible", "breaking"]
                }
            }
        },
        "required_verification": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/verificationRequirement"
            }
        },
        "checkpoints": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/checkpoint"
            }
        },
        "commits": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/commit"
            }
        },
        "completion": {
            "$ref": "#/$defs/completion"
        },
        "readiness": {
            "$ref": "#/$defs/readiness"
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "status": {
                        "const": "complete"
                    }
                },
                "required": ["status"]
            },
            "then": {
                "required": ["completion", "readiness"]
            }
        }
    ],
    "$defs": {
        "pathSet": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "uniqueItems": true
        },
        "verificationRequirement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "command", "expected_result"],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "command": {
                    "type": "string",
                    "minLength": 1
                },
                "expected_result": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "result", "details"],
            "properties": {
                "check": {
                    "type": "string",
                    "minLength": 1
                },
                "command": {
                    "type": "string",
                    "minLength": 1
                },
                "result": {
                    "enum": ["passed", "failed", "not_run"]
                },
                "details": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "checkpoint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "evidence"],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "status": {
                    "enum": [
                        "planned",
                        "in_progress",
                        "passed",
                        "failed",
                        "blocked"
                    ]
                },
                "evidence": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/evidence"
                    }
                }
            }
        },
        "commit": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha", "subject"],
            "properties": {
                "sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                },
                "subject": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "completion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "accomplished",
                "verified",
                "behavior_changed",
                "intentional_behavior_changes",
                "preserved_behavior",
                "deferred_work"
            ],
            "properties": {
                "accomplished": {
                    "$ref": "#/$defs/nonEmptyStrings"
                },
                "verified": {
                    "$ref": "#/$defs/nonEmptyStrings"
                },
                "behavior_changed": {
                    "type": "string",
                    "minLength": 1
                },
                "intentional_behavior_changes": {
                    "$ref": "#/$defs/stringList"
                },
                "preserved_behavior": {
                    "$ref": "#/$defs/nonEmptyStrings"
                },
                "deferred_work": {
                    "$ref": "#/$defs/stringList"
                }
            }
        },
        "readiness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "next_task", "rationale"],
            "properties": {
                "status": {
                    "enum": [
                        "READY",
                        "READY WITH RECORDED CARRY-FORWARD",
                        "BLOCKED"
                    ]
                },
                "next_task": {
                    "type": "string",
                    "minLength": 1
                },
                "rationale": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "stringList": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "nonEmptyStrings": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        }
    }
}
