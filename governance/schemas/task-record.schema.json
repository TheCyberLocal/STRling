{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/governance/task-record.schema.json",
    "title": "STRling governance task record",
    "description": "A record of declared change intent, enforceable scope, verification, completion, and readiness for contained engineering work.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "record_version",
        "title",
        "status",
        "objective",
        "scope",
        "change_classification",
        "required_verification",
        "checkpoints",
        "commits"
    ],
    "properties": {
        "record_version": {
            "enum": ["1.0.0", "2.0.0"]
        },
        "title": {
            "type": "string",
            "minLength": 1,
            "description": "A durable, capability-oriented name rather than a campaign code."
        },
        "status": {
            "enum": ["planned", "in_progress", "complete", "blocked"]
        },
        "objective": {
            "type": "string",
            "minLength": 1
        },
        "scope": {
            "$ref": "#/$defs/scope"
        },
        "change_classification": {
            "$ref": "#/$defs/changeClassification"
        },
        "required_verification": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/verificationRequirement"
            }
        },
        "checkpoints": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/checkpoint"
            }
        },
        "invariant_inventory": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/invariant" }
        },
        "commits": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/commit"
            }
        },
        "completion": {
            "$ref": "#/$defs/completion"
        },
        "readiness": {
            "$ref": "#/$defs/readiness"
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "record_version": {
                        "const": "1.0.0"
                    }
                },
                "required": ["record_version"]
            },
            "then": {
                "properties": {
                    "scope": {
                        "required": ["allowed_paths", "forbidden_paths"]
                    },
                    "change_classification": {
                        "required": ["behavioral_change", "public_api_change"]
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "record_version": {
                        "const": "2.0.0"
                    }
                },
                "required": ["record_version"]
            },
            "then": {
                "properties": {
                    "scope": {
                        "required": [
                            "diff",
                            "allowed_paths",
                            "forbidden_paths",
                            "expected_files",
                            "permitted_generated_changes",
                            "expected_generated_outputs",
                            "required_verification_levels",
                            "bounded_exemptions"
                        ]
                    },
                    "change_classification": {
                        "required": [
                            "semantic_change",
                            "public_api_change",
                            "schema_change",
                            "diagnostic_change",
                            "target_behavior_change",
                            "architecture_change",
                            "generated_output_change",
                            "documentation_only",
                            "internal_implementation"
                        ]
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "status": {
                        "const": "complete"
                    }
                },
                "required": ["status"]
            },
            "then": {
                "required": ["completion", "readiness"]
            }
        }
    ],
    "$defs": {
        "repositoryPath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "pathSet": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/repositoryPath"
            },
            "uniqueItems": true
        },
        "diff": {
            "type": "object",
            "additionalProperties": false,
            "required": ["base", "head"],
            "properties": {
                "base": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                },
                "head": {
                    "oneOf": [
                        {
                            "enum": ["working-tree", "HEAD"]
                        },
                        {
                            "type": "string",
                            "pattern": "^[0-9a-f]{40}$"
                        }
                    ]
                }
            }
        },
        "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "diff": {
                    "$ref": "#/$defs/diff"
                },
                "allowed_paths": {
                    "$ref": "#/$defs/pathSet"
                },
                "forbidden_paths": {
                    "$ref": "#/$defs/pathSet"
                },
                "expected_files": {
                    "$ref": "#/$defs/pathSet"
                },
                "permitted_generated_changes": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
                    },
                    "uniqueItems": true
                },
                "expected_generated_outputs": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
                    },
                    "uniqueItems": true
                },
                "required_verification_levels": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "enum": [
                            "contract",
                            "unit",
                            "integration",
                            "quality",
                            "certification"
                        ]
                    },
                    "uniqueItems": true
                },
                "bounded_exemptions": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^WVR-[A-Z0-9][A-Z0-9._-]{2,63}$"
                    },
                    "uniqueItems": true
                }
            }
        },
        "changeLevel": {
            "enum": [
                "none",
                "compatible",
                "additive",
                "breaking",
                "intentional-correction"
            ]
        },
        "changeDeclaration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "evidence"],
            "properties": {
                "level": {
                    "$ref": "#/$defs/changeLevel"
                },
                "evidence": {
                    "$ref": "#/$defs/stringList"
                },
                "affected_surfaces": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
                    },
                    "uniqueItems": true
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "level": {
                                "not": {
                                    "const": "none"
                                }
                            }
                        },
                        "required": ["level"]
                    },
                    "then": {
                        "properties": {
                            "evidence": {
                                "minItems": 1
                            }
                        }
                    }
                }
            ]
        },
        "changeClassification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "behavioral_change": {
                    "enum": [
                        "none",
                        "behavior-preserving",
                        "intentional-compatible",
                        "intentional-breaking"
                    ]
                },
                "semantic_change": {
                    "$ref": "#/$defs/changeDeclaration"
                },
                "public_api_change": {
                    "oneOf": [
                        {
                            "enum": ["none", "compatible", "breaking"]
                        },
                        {
                            "$ref": "#/$defs/changeDeclaration"
                        }
                    ]
                },
                "schema_change": {
                    "$ref": "#/$defs/changeDeclaration"
                },
                "diagnostic_change": {
                    "$ref": "#/$defs/changeDeclaration"
                },
                "target_behavior_change": {
                    "$ref": "#/$defs/changeDeclaration"
                },
                "architecture_change": {
                    "$ref": "#/$defs/changeDeclaration"
                },
                "generated_output_change": {
                    "$ref": "#/$defs/changeDeclaration"
                },
                "documentation_only": {
                    "type": "boolean"
                },
                "internal_implementation": {
                    "type": "boolean"
                }
            }
        },
        "verificationRequirement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "command", "expected_result"],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "command": {
                    "type": "string",
                    "minLength": 1
                },
                "expected_result": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "result", "details"],
            "properties": {
                "check": {
                    "type": "string",
                    "minLength": 1
                },
                "command": {
                    "type": "string",
                    "minLength": 1
                },
                "result": {
                    "enum": ["passed", "failed", "not_run"]
                },
                "details": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "checkpoint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "evidence"],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "status": {
                    "enum": [
                        "planned",
                        "in_progress",
                        "passed",
                        "failed",
                        "blocked"
                    ]
                },
                "evidence": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/evidence"
                    }
                }
            }
        },
        "invariant": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "invariant_id",
                "architectural_claim",
                "authoritative_source",
                "positive_allowed_form",
                "forbidden_form",
                "mechanical_detection_method",
                "current_observed_state",
                "expected_ratchet"
            ],
            "properties": {
                "invariant_id": { "type": "string", "minLength": 1 },
                "architectural_claim": { "type": "string", "minLength": 1 },
                "authoritative_source": { "type": "string", "minLength": 1 },
                "positive_allowed_form": { "type": "string", "minLength": 1 },
                "forbidden_form": { "type": "string", "minLength": 1 },
                "mechanical_detection_method": {
                    "type": "string",
                    "minLength": 1
                },
                "current_observed_state": { "type": "string", "minLength": 1 },
                "expected_ratchet": { "type": "string", "minLength": 1 }
            }
        },
        "commit": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha", "subject"],
            "properties": {
                "sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                },
                "subject": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "completion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "accomplished",
                "verified",
                "behavior_changed",
                "intentional_behavior_changes",
                "preserved_behavior",
                "transitional_architecture",
                "deferred_work"
            ],
            "properties": {
                "accomplished": {
                    "$ref": "#/$defs/nonEmptyStrings"
                },
                "verified": {
                    "$ref": "#/$defs/nonEmptyStrings"
                },
                "behavior_changed": {
                    "type": "string",
                    "minLength": 1
                },
                "intentional_behavior_changes": {
                    "$ref": "#/$defs/stringList"
                },
                "preserved_behavior": {
                    "$ref": "#/$defs/nonEmptyStrings"
                },
                "transitional_architecture": {
                    "$ref": "#/$defs/stringList"
                },
                "deferred_work": {
                    "$ref": "#/$defs/stringList"
                }
            }
        },
        "readiness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "next_task", "rationale"],
            "properties": {
                "status": {
                    "enum": [
                        "READY",
                        "READY WITH RECORDED CARRY-FORWARD",
                        "BLOCKED"
                    ]
                },
                "next_task": {
                    "type": "string",
                    "minLength": 1
                },
                "rationale": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "stringList": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "nonEmptyStrings": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        }
    }
}
