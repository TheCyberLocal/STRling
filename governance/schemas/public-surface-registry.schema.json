{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/governance/public-surface-registry.schema.json",
    "title": "STRling public surface registry",
    "description": "Inventory of compatibility baselines for host APIs, package entrypoints, CLI commands, and versioned structured contracts.",
    "type": "object",
    "additionalProperties": false,
    "required": ["registry_version", "classifications", "surfaces"],
    "properties": {
        "registry_version": { "const": 1 },
        "classifications": {
            "type": "array",
            "prefixItems": [
                { "const": "unchanged" },
                { "const": "compatible" },
                { "const": "additive" },
                { "const": "breaking" },
                { "const": "intentional-correction" }
            ],
            "items": false
        },
        "surfaces": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/surface" }
        }
    },
    "$defs": {
        "identifier": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/path" }
        },
        "strings": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
        },
        "extraction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mechanism", "command", "normalization", "exclusions"],
            "properties": {
                "mechanism": {
                    "enum": [
                        "c-header-declarations",
                        "cpp-header-declarations",
                        "cli-help-parser",
                        "dotnet-assembly-api",
                        "dart-analyzer-api",
                        "go-doc-declarations",
                        "java-class-api",
                        "json-schema",
                        "kotlin-binary-api",
                        "lua-bounded-facade-api",
                        "perl-declared-api",
                        "php-token-api",
                        "python-ast-exports",
                        "r-namespace-exports",
                        "ruby-ripper-api",
                        "rust-public-api",
                        "rust-source-boundary",
                        "swift-symbolgraph",
                        "typescript-declarations",
                        "typescript-package-entrypoints"
                    ]
                },
                "command": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                },
                "normalization": { "$ref": "#/$defs/strings" },
                "exclusions": { "$ref": "#/$defs/strings" }
            }
        },
        "surface": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "ecosystem",
                "component",
                "kind",
                "source_locations",
                "extraction",
                "snapshot_path",
                "authority",
                "comparison",
                "enforcement"
            ],
            "properties": {
                "id": { "$ref": "#/$defs/identifier" },
                "ecosystem": { "type": "string", "minLength": 1 },
                "component": { "type": "string", "minLength": 1 },
                "kind": {
                    "enum": ["host-api", "package-entrypoints", "cli", "schema"]
                },
                "source_locations": { "$ref": "#/$defs/paths" },
                "extraction": { "$ref": "#/$defs/extraction" },
                "snapshot_path": { "$ref": "#/$defs/path" },
                "authority": {
                    "enum": ["compatibility-baseline", "versioned-contract"]
                },
                "comparison": {
                    "enum": [
                        "declaration-set",
                        "symbol-signatures",
                        "package-entrypoints",
                        "json-schema-structure",
                        "cli-command-set"
                    ]
                },
                "enforcement": {
                    "enum": ["planned", "enforced", "transitional"]
                },
                "rationale": { "type": "string", "minLength": 1 },
                "retirement_condition": { "type": "string", "minLength": 1 },
                "activation_condition": { "type": "string", "minLength": 1 },
                "known_gaps": { "$ref": "#/$defs/strings" }
            },
            "allOf": [
                {
                    "if": {
                        "properties": { "enforcement": { "const": "planned" } },
                        "required": ["enforcement"]
                    },
                    "then": { "required": ["activation_condition"] }
                },
                {
                    "if": {
                        "properties": {
                            "enforcement": { "const": "transitional" }
                        },
                        "required": ["enforcement"]
                    },
                    "then": {
                        "required": ["rationale", "retirement_condition"]
                    }
                }
            ]
        }
    }
}
