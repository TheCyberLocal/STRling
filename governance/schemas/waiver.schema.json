{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/governance/waiver.schema.json",
    "title": "STRling governance waiver",
    "description": "A bounded, reviewable exception to an engineering rule.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "record_version",
        "waiver_id",
        "status",
        "rule",
        "scope",
        "rationale",
        "retirement"
    ],
    "allOf": [
        {
            "if": { "required": ["security"] },
            "then": {
                "properties": {
                    "retirement": {
                        "required": ["expires_on"],
                        "properties": {
                            "replacement_work": { "minItems": 1 }
                        }
                    }
                }
            }
        }
    ],
    "properties": {
        "record_version": {
            "const": "1.0.0"
        },
        "waiver_id": {
            "type": "string",
            "pattern": "^WVR-[A-Z0-9][A-Z0-9._-]{2,63}$",
            "description": "A stable identifier that is never reused."
        },
        "status": {
            "enum": ["requested", "accepted", "retired", "expired"]
        },
        "rule": {
            "type": "string",
            "minLength": 1
        },
        "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "paths"],
            "properties": {
                "description": {
                    "type": "string",
                    "minLength": 1
                },
                "paths": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "rationale": {
            "type": "string",
            "minLength": 1
        },
        "security": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "operation_id",
                "finding_code",
                "owner",
                "subsystem",
                "created_on",
                "review_context",
                "matches"
            ],
            "properties": {
                "operation_id": {
                    "type": "string",
                    "pattern": "^security\\.[a-z0-9.-]+$"
                },
                "finding_code": {
                    "type": "string",
                    "pattern": "^SEC-[A-Z0-9-]+$"
                },
                "owner": { "type": "string", "minLength": 1 },
                "subsystem": { "type": "string", "minLength": 1 },
                "created_on": { "type": "string", "format": "date" },
                "review_context": { "type": "string", "minLength": 1 },
                "matches": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["check_id"],
                        "anyOf": [
                            { "required": ["paths"] },
                            { "required": ["packages"] },
                            { "required": ["advisories"] },
                            { "required": ["licenses"] }
                        ],
                        "properties": {
                            "check_id": {
                                "type": "string",
                                "pattern": "^security\\.[a-z0-9.-]+$"
                            },
                            "paths": { "$ref": "#/$defs/nonEmptyStrings" },
                            "packages": { "$ref": "#/$defs/nonEmptyStrings" },
                            "versions": { "$ref": "#/$defs/nonEmptyStrings" },
                            "advisories": { "$ref": "#/$defs/nonEmptyStrings" },
                            "severities": { "$ref": "#/$defs/nonEmptyStrings" },
                            "licenses": { "$ref": "#/$defs/nonEmptyStrings" }
                        }
                    }
                }
            }
        },
        "retirement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["condition", "replacement_work"],
            "properties": {
                "condition": {
                    "type": "string",
                    "minLength": 1
                },
                "expires_on": {
                    "type": "string",
                    "format": "date"
                },
                "replacement_work": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        }
    },
    "$defs": {
        "nonEmptyStrings": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        }
    }
}
