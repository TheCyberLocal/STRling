{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://strling.dev/governance/architecture-rules.schema.json",
    "title": "STRling architecture fitness rules",
    "type": "object",
    "additionalProperties": false,
    "required": ["registry_version", "rules"],
    "properties": {
        "registry_version": {
            "const": 1
        },
        "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/rule"
            }
        }
    },
    "$defs": {
        "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/path"
            }
        },
        "marker_requirement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "markers"],
            "properties": {
                "path": {
                    "$ref": "#/$defs/path"
                },
                "markers": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "runner_isolation_boundary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sources", "forbidden_markers"],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
                },
                "sources": {
                    "$ref": "#/$defs/paths"
                },
                "forbidden_markers": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "runner_isolation_boundaries": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/runner_isolation_boundary"
            }
        },
        "configuration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "sources": {
                    "$ref": "#/$defs/paths"
                },
                "fsharp_sources": {
                    "$ref": "#/$defs/paths"
                },
                "manifest": {
                    "$ref": "#/$defs/path"
                },
                "forbidden_repository_roots": {
                    "$ref": "#/$defs/paths"
                },
                "forbidden_dependencies": {
                    "$ref": "#/$defs/paths"
                },
                "forbidden_paths": {
                    "$ref": "#/$defs/paths"
                },
                "forbidden_markers": {
                    "$ref": "#/$defs/paths"
                },
                "fsharp_forbidden_markers": {
                    "$ref": "#/$defs/paths"
                },
                "required_markers": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/marker_requirement"
                    }
                },
                "allowed_record_roots": {
                    "$ref": "#/$defs/paths"
                },
                "allowed_top_level_directories": {
                    "$ref": "#/$defs/paths"
                },
                "requires_declaration": {
                    "const": "architecture_change"
                },
                "tracked_paths": {
                    "$ref": "#/$defs/paths"
                },
                "forbidden_modules": {
                    "$ref": "#/$defs/paths"
                },
                "allowed_reference_roots": {
                    "$ref": "#/$defs/paths"
                },
                "guarded_roots": {
                    "$ref": "#/$defs/paths"
                },
                "semantic_names": {
                    "$ref": "#/$defs/paths"
                },
                "permitted_paths": {
                    "$ref": "#/$defs/paths"
                },
                "excluded_path_parts": {
                    "$ref": "#/$defs/paths"
                },
                "required_rule_ids": {
                    "$ref": "#/$defs/paths"
                },
                "artifact_ids": {
                    "$ref": "#/$defs/paths"
                },
                "allowed_authorities": {
                    "$ref": "#/$defs/paths"
                },
                "consumer_sources": {
                    "$ref": "#/$defs/paths"
                },
                "comparison_sources": {
                    "$ref": "#/$defs/paths"
                },
                "comparison_contract": {
                    "$ref": "#/$defs/path"
                },
                "comparison_forbidden_mutation_tokens": {
                    "$ref": "#/$defs/paths"
                },
                "comparison_forbidden_authority_tokens": {
                    "$ref": "#/$defs/paths"
                },
                "normative_sources": {
                    "$ref": "#/$defs/paths"
                },
                "runner_sources": {
                    "$ref": "#/$defs/paths"
                },
                "runner_isolation_boundaries": {
                    "$ref": "#/$defs/runner_isolation_boundaries"
                },
                "forbidden_evidence_markers": {
                    "$ref": "#/$defs/paths"
                },
                "runner_forbidden_roots": {
                    "$ref": "#/$defs/paths"
                },
                "runner_forbidden_authority_tokens": {
                    "$ref": "#/$defs/paths"
                },
                "normative_output_roots": {
                    "$ref": "#/$defs/paths"
                },
                "frontend_contract_sources": {
                    "$ref": "#/$defs/paths"
                },
                "semantic_authority_sources": {
                    "$ref": "#/$defs/paths"
                },
                "target_authority_sources": {
                    "$ref": "#/$defs/paths"
                },
                "forbidden_frontend_markers": {
                    "$ref": "#/$defs/paths"
                },
                "contract_forbidden_authority_markers": {
                    "$ref": "#/$defs/paths"
                },
                "history_roots": {
                    "$ref": "#/$defs/paths"
                },
                "allowed_files": {
                    "$ref": "#/$defs/paths"
                },
                "forbidden_reference_markers": {
                    "$ref": "#/$defs/paths"
                },
                "forbidden_extensions": {
                    "$ref": "#/$defs/paths"
                }
            }
        },
        "rule": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "description",
                "status",
                "kind",
                "configuration"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
                },
                "description": {
                    "type": "string",
                    "minLength": 1
                },
                "status": {
                    "enum": ["enforced", "transitional", "future"]
                },
                "kind": {
                    "enum": [
                        "rust-crate-boundary",
                        "native-adapter-boundary",
                        "forbidden-dependency",
                        "generated-input-cycle",
                        "task-record-placement",
                        "new-top-level-directory",
                        "forbidden-import",
                        "schema-reference-boundary",
                        "semantic-island-placement",
                        "artifact-authority-boundary",
                        "ci-profile-routing",
                        "non-normative-history-boundary",
                        "frontend-authority-boundary",
                        "jvm-adapter-boundary",
                        "dotnet-adapter-boundary",
                        "binding-semantic-path-boundary",
                        "binding-route-coverage",
                        "tracked-transition"
                    ]
                },
                "configuration": {
                    "$ref": "#/$defs/configuration"
                },
                "rationale": {
                    "type": "string",
                    "minLength": 1
                },
                "retirement_condition": {
                    "type": "string",
                    "minLength": 1
                },
                "activation_condition": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "non-normative-history-boundary"
                            }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "required": [
                                    "history_roots",
                                    "allowed_files",
                                    "consumer_sources",
                                    "forbidden_reference_markers",
                                    "forbidden_extensions"
                                ]
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "binding-semantic-path-boundary"
                            }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "required": [
                                    "sources",
                                    "semantic_names",
                                    "permitted_paths",
                                    "excluded_path_parts"
                                ]
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": { "const": "binding-route-coverage" }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "required": ["required_rule_ids"]
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": { "const": "jvm-adapter-boundary" }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "required": [
                                    "sources",
                                    "forbidden_paths",
                                    "forbidden_markers",
                                    "required_markers"
                                ]
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": { "const": "dotnet-adapter-boundary" }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "required": [
                                    "sources",
                                    "fsharp_sources",
                                    "forbidden_paths",
                                    "forbidden_markers",
                                    "fsharp_forbidden_markers",
                                    "required_markers"
                                ]
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "frontend-authority-boundary"
                            }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "required": [
                                    "frontend_contract_sources",
                                    "semantic_authority_sources",
                                    "target_authority_sources",
                                    "forbidden_frontend_markers",
                                    "contract_forbidden_authority_markers"
                                ]
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": { "const": "ci-profile-routing" }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "required": ["sources"]
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "rust-crate-boundary"
                            }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "required": [
                                    "manifest",
                                    "sources",
                                    "forbidden_repository_roots"
                                ]
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "native-adapter-boundary"
                            }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "required": [
                                    "sources",
                                    "forbidden_paths",
                                    "forbidden_markers",
                                    "required_markers"
                                ]
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "status": {
                                "const": "transitional"
                            }
                        },
                        "required": ["status"]
                    },
                    "then": {
                        "required": ["rationale", "retirement_condition"]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "status": {
                                "const": "future"
                            }
                        },
                        "required": ["status"]
                    },
                    "then": {
                        "required": ["rationale", "activation_condition"]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "forbidden-dependency"
                            }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "required": [
                                    "sources",
                                    "forbidden_dependencies"
                                ]
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "task-record-placement"
                            }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "required": ["allowed_record_roots"]
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "new-top-level-directory"
                            }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "required": [
                                    "allowed_top_level_directories",
                                    "requires_declaration"
                                ]
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": { "const": "forbidden-import" }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "required": ["sources", "forbidden_modules"]
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": { "const": "schema-reference-boundary" }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "required": [
                                    "sources",
                                    "allowed_reference_roots"
                                ]
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": { "const": "semantic-island-placement" }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "required": [
                                    "guarded_roots",
                                    "semantic_names",
                                    "requires_declaration"
                                ]
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "artifact-authority-boundary"
                            }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "required": [
                                    "artifact_ids",
                                    "allowed_authorities"
                                ]
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "tracked-transition"
                            }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "required": ["tracked_paths"]
                            }
                        }
                    }
                }
            ]
        }
    }
}
