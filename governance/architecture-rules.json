{
    "registry_version": 1,
    "rules": [
        {
            "id": "governance-product-dependency-boundary",
            "description": "Governance implementations must not import compiler or binding implementation modules.",
            "status": "enforced",
            "kind": "forbidden-dependency",
            "configuration": {
                "sources": [
                    "tooling/architecture_fitness.py",
                    "tooling/contract_declarations.py",
                    "tooling/generated_artifacts.py",
                    "tooling/governance.py",
                    "tooling/public_contracts.py"
                ],
                "forbidden_dependencies": ["STRling", "bindings", "spec"]
            }
        },
        {
            "id": "quality-semantic-dependency-boundary",
            "description": "Repository quality tooling must orchestrate contracts and processes rather than import a semantic compiler implementation.",
            "status": "enforced",
            "kind": "forbidden-dependency",
            "configuration": {
                "sources": [
                    "tooling/architecture_fitness.py",
                    "tooling/contract_declarations.py",
                    "tooling/contract_validation.py",
                    "tooling/formatting.py",
                    "tooling/generated_artifacts.py",
                    "tooling/governance.py",
                    "tooling/hygiene.py",
                    "tooling/quality.py",
                    "tooling/security.py",
                    "tooling/static_analysis.py",
                    "tooling/public_contracts.py"
                ],
                "forbidden_dependencies": ["STRling", "bindings", "spec"]
            }
        },
        {
            "id": "generated-artifact-input-acyclicity",
            "description": "A generated artifact must not appear among its own authoritative sources or generator inputs.",
            "status": "enforced",
            "kind": "generated-input-cycle",
            "configuration": {}
        },
        {
            "id": "implementation-derived-fixture-authority",
            "description": "Implementation-derived test generation may remain compatibility evidence but cannot become normative or certification authority.",
            "status": "enforced",
            "kind": "artifact-authority-boundary",
            "configuration": {
                "artifact_ids": ["shared-semantic-fixtures"],
                "allowed_authorities": ["transitional-compatibility-evidence"]
            }
        },
        {
            "id": "task-record-placement",
            "description": "Contained-task records and templates must remain in designated governance locations.",
            "status": "enforced",
            "kind": "task-record-placement",
            "configuration": {
                "allowed_record_roots": [
                    "docs/migration/records",
                    "governance/templates"
                ]
            }
        },
        {
            "id": "new-top-level-implementation-islands",
            "description": "New top-level implementation directories require an explicit architecture declaration.",
            "status": "enforced",
            "kind": "new-top-level-directory",
            "configuration": {
                "allowed_top_level_directories": [
                    ".github",
                    ".vscode",
                    "bindings",
                    "core",
                    "docs",
                    "governance",
                    "spec",
                    "tests",
                    "tooling"
                ],
                "requires_declaration": "architecture_change"
            }
        },
        {
            "id": "canonical-kernel-dependency-boundary",
            "description": "The canonical Rust kernel must not depend on host-language bindings or repository tooling implementations.",
            "status": "enforced",
            "kind": "rust-crate-boundary",
            "configuration": {
                "manifest": "core/Cargo.toml",
                "sources": ["core/src/**/*.rs"],
                "forbidden_repository_roots": ["bindings", "tooling"]
            }
        },
        {
            "id": "canonical-ci-profile-routing",
            "description": "CI and release workflows must use canonical profiles as certification authority and retain their structured artifacts without redefining pass or fail.",
            "status": "enforced",
            "kind": "ci-profile-routing",
            "configuration": {
                "sources": [
                    ".github/workflows/ci.yml",
                    ".github/workflows/cd.yml"
                ]
            }
        },
        {
            "id": "duplicated-binding-compilers",
            "description": "Independent parser, compiler, and emitter implementations remain present across language bindings.",
            "status": "transitional",
            "kind": "tracked-transition",
            "configuration": {
                "tracked_paths": [
                    "bindings/**/parser.*",
                    "bindings/**/compiler.*",
                    "bindings/**/emitters/**"
                ]
            },
            "rationale": "The canonical compiler core and adapter migration have not begun, so prohibiting all binding semantic implementations would falsely certify the current architecture.",
            "retirement_condition": "Activate binding-to-canonical-core dependency rules after each binding is migrated and its legacy semantic implementation is removed under contained verification."
        },
        {
            "id": "implementation-derived-shared-fixtures",
            "description": "Shared expected semantic and diagnostic fixtures remain derived from TypeScript implementation behavior.",
            "status": "transitional",
            "kind": "tracked-transition",
            "configuration": {
                "tracked_paths": [
                    "tests/spec/*.json",
                    "tooling/js_to_json_ast/**"
                ]
            },
            "rationale": "The fixtures are necessary compatibility evidence but do not satisfy contract-first semantic authority.",
            "retirement_condition": "Replace implementation-derived expected behavior with independently accepted specification-authored conformance contracts and deterministic projections."
        },
        {
            "id": "legacy-reference-authority-boundary",
            "description": "Legacy reference observations remain isolated historical evidence and cannot become product, normative, kernel, binding, target-capability, or cross-runner expected-output authority.",
            "status": "enforced",
            "kind": "legacy-reference-boundary",
            "configuration": {
                "consumer_sources": ["core/**", "bindings/**"],
                "comparison_sources": [
                    "tooling/migration_*.py",
                    "tooling/migration_differential*.json",
                    "tooling/tests/fixtures/migration_comparison/**",
                    "tooling/tests/fixtures/migration_differential/**"
                ],
                "comparison_contract": "tooling/migration_comparison_contract.json",
                "comparison_forbidden_mutation_tokens": [
                    "write_text(",
                    "write_bytes(",
                    ".unlink(",
                    ".rename(",
                    "open("
                ],
                "comparison_forbidden_authority_tokens": [
                    "\"majority_is_authority\": true",
                    "\"historical_consensus_is_normative\": true",
                    "\"unresolved_discrepancy\": \"passed\"",
                    "\"unresolved_discrepancy\": \"accepted\""
                ],
                "normative_sources": ["spec/**"],
                "runner_sources": ["tooling/legacy_reference/**"],
                "runner_isolation_boundaries": [
                    {
                        "id": "typescript-from-python",
                        "sources": [
                            "tooling/legacy_reference/canonical.mjs",
                            "tooling/legacy_reference/cli.mjs",
                            "tooling/legacy_reference/constants.mjs",
                            "tooling/legacy_reference/corpus.json",
                            "tooling/legacy_reference/corpus.mjs",
                            "tooling/legacy_reference/corpus_cli.mjs",
                            "tooling/legacy_reference/identity.mjs",
                            "tooling/legacy_reference/legacy_runtime.mjs"
                        ],
                        "forbidden_markers": [
                            "python_corpus",
                            "python_expected",
                            "python_golden",
                            "python_reference"
                        ]
                    },
                    {
                        "id": "python-from-typescript",
                        "sources": [
                            "tooling/legacy_reference/python_corpus.json",
                            "tooling/legacy_reference/python_reference.py"
                        ],
                        "forbidden_markers": [
                            "corpus_cli",
                            "legacy_runtime",
                            "typescript_expected",
                            "typescript_golden",
                            "with_name(\"corpus.json\")"
                        ]
                    }
                ],
                "forbidden_evidence_markers": [
                    "tooling/legacy_reference",
                    "legacy_reference",
                    "strling.legacy-reference",
                    "migration_comparison",
                    "migration_differential",
                    "strling.migration-comparison",
                    "strling.migration-discrepancy",
                    "strling.full-migration-differential",
                    "preserved_behavior",
                    "intentional_specification_correction",
                    "unsupported_legacy_behavior",
                    "unresolved_discrepancy",
                    "historical_consensus"
                ],
                "runner_forbidden_roots": ["core", "spec"],
                "runner_forbidden_authority_tokens": [
                    "TargetArtifact",
                    "PortabilityPlanner",
                    "portability_planner",
                    "TargetProfile",
                    "target_profiles",
                    "capability_evaluation"
                ],
                "normative_output_roots": ["spec"]
            }
        },
        {
            "id": "lsp-python-binding-semantic-dependency",
            "description": "Deferred formatting/code-action support and host-island extraction still reach the transitional Python binding; canonical editor evidence does not.",
            "status": "transitional",
            "kind": "forbidden-import",
            "configuration": {
                "sources": [
                    "tooling/lsp-server/island_extractor.py",
                    "tooling/lsp-server/server/island_extractor.py",
                    "tooling/lsp-server/server/deferred_intelligence.py",
                    "tooling/lsp-server/tests/test_code_actions.py"
                ],
                "forbidden_modules": ["STRling"]
            },
            "rationale": "P16-T02 removed the binding semantic dependency from diagnostics and hover. P16-T03 removed it from completion, navigation, semantic tokens, symbols, and references. P16-T04 owns formatting/code actions; island extraction remains a bounded coordinate adapter until those tasks retire the final binding imports.",
            "retirement_condition": "Route formatting, code actions, and island extraction through canonical evidence, remove every direct STRling binding import from tooling, and promote the whole LSP boundary to enforced."
        },
        {
            "id": "lsp-canonical-diagnostics-hover-boundary",
            "description": "Canonical LSP diagnostics, hover, lifecycle, and their evidence must not import the transitional Python binding.",
            "status": "enforced",
            "kind": "forbidden-import",
            "configuration": {
                "sources": [
                    "tooling/lsp-server/server/canonical_core.py",
                    "tooling/lsp-server/server/server.py",
                    "tooling/lsp-server/tests/canonical_evidence.py",
                    "tooling/lsp-server/tests/test_canonical_core.py",
                    "tooling/lsp-server/tests/test_diagnostics.py",
                    "tooling/lsp-server/tests/test_hover.py",
                    "tooling/lsp-server/tests/test_lsp_lifecycle.py",
                    "tooling/lsp-server/tests/test_lsp_server.py",
                    "tooling/lsp-server/tests/test_parser_exhaustive.py"
                ],
                "forbidden_modules": ["STRling"]
            }
        },
        {
            "id": "lsp-canonical-editor-intelligence-boundary",
            "description": "Completion, navigation, symbols, references, semantic tokens, and their closed evidence must not import the transitional Python binding.",
            "status": "enforced",
            "kind": "forbidden-import",
            "configuration": {
                "sources": [
                    "tooling/lsp-server/server/canonical_intelligence.py",
                    "tooling/lsp-server/server/server.py",
                    "tooling/lsp-server/tests/canonical_intelligence_evidence.py",
                    "tooling/lsp-server/tests/test_canonical_intelligence.py",
                    "tooling/lsp-server/tests/test_completion.py",
                    "tooling/lsp-server/tests/test_navigation.py",
                    "tooling/lsp-server/tests/test_semantic_tokens.py"
                ],
                "forbidden_modules": ["STRling"]
            }
        },
        {
            "id": "specification-reference-authority-boundary",
            "description": "Specification schemas may reference only specification-owned schema contracts, never generated implementation output.",
            "status": "enforced",
            "kind": "schema-reference-boundary",
            "configuration": {
                "sources": [
                    "spec/schema/*.json",
                    "spec/contracts/**/*.schema.json",
                    "spec/frontends/**/*.schema.json"
                ],
                "allowed_reference_roots": [
                    "spec/schema",
                    "spec/contracts",
                    "spec/frontends"
                ]
            }
        },
        {
            "id": "regex-frontend-authority-boundary",
            "description": "The regex-compatible frontend owns only versioned compatibility syntax and cannot define canonical semantic or target authority.",
            "status": "enforced",
            "kind": "frontend-authority-boundary",
            "configuration": {
                "frontend_contract_sources": ["spec/frontends/legacy-regex/**"],
                "semantic_authority_sources": [
                    "core/src/semantic/**",
                    "spec/contracts/1.0/semantic-ir.schema.json",
                    "spec/drafts/**"
                ],
                "target_authority_sources": [
                    "core/src/portability_planning.rs",
                    "core/src/target/**",
                    "spec/contracts/1.0/target-artifact.schema.json",
                    "spec/contracts/1.0/target-profile.schema.json",
                    "spec/targets/**"
                ],
                "forbidden_frontend_markers": [
                    "%flags",
                    "legacy-regex",
                    "strling.regex-compat",
                    "text/x-strling-regex-compat"
                ],
                "contract_forbidden_authority_markers": [
                    "\"raw_fragment_model\": \"opaque-passthrough\"",
                    "\"semantic_authority\": true",
                    "\"target_assumption\": \"inferred\"",
                    "\"target_authority\": true"
                ]
            }
        },
        {
            "id": "semantic-strling-authority-boundary",
            "description": "The Semantic STRling contract owns versioned source syntax and mapping but cannot implement parsing or redefine canonical semantics, targets, or runtimes.",
            "status": "enforced",
            "kind": "frontend-authority-boundary",
            "configuration": {
                "frontend_contract_sources": ["spec/frontends/semantic/**"],
                "semantic_authority_sources": [
                    "core/src/semantic/**",
                    "spec/contracts/1.0/semantic-ir.schema.json"
                ],
                "target_authority_sources": [
                    "core/src/portability_planning.rs",
                    "core/src/target/**",
                    "spec/contracts/1.0/target-artifact.schema.json",
                    "spec/contracts/1.0/target-profile.schema.json",
                    "spec/targets/**"
                ],
                "forbidden_frontend_markers": [
                    "strling.semantic",
                    "semantic strling 1.0",
                    "text/x-strling-semantic"
                ],
                "contract_forbidden_authority_markers": [
                    "\"canonical_semantic_authority\": true",
                    "\"target_authority\": true",
                    "\"runtime_authority\": true",
                    "\"parser_implementation\": true",
                    "\"formatter_implementation\": true"
                ]
            }
        },
        {
            "id": "new-tooling-semantic-islands",
            "description": "New parser, compiler, analyzer, planner, or emitter implementations under tooling require explicit architecture review.",
            "status": "enforced",
            "kind": "semantic-island-placement",
            "configuration": {
                "guarded_roots": ["tooling"],
                "semantic_names": [
                    "parser",
                    "compiler",
                    "analyzer",
                    "planner",
                    "emitter"
                ],
                "requires_declaration": "architecture_change"
            }
        },
        {
            "id": "binding-canonical-core-dependency",
            "description": "Host-language bindings depend only on the stable canonical compiler interface for STRling semantics.",
            "status": "future",
            "kind": "tracked-transition",
            "configuration": {
                "tracked_paths": ["bindings/**"]
            },
            "rationale": "The canonical kernel domain now exists, but no binding has migrated to an executable canonical compiler pipeline; final-state enforcement would reject every current binding.",
            "activation_condition": "Activate per binding only after an executable canonical pipeline, adapter migration, and behavior-preservation certification."
        }
    ]
}
