{
    "registry_version": 1,
    "rules": [
        {
            "id": "governance-product-dependency-boundary",
            "description": "Governance implementations must not import compiler or binding implementation modules.",
            "status": "enforced",
            "kind": "forbidden-dependency",
            "configuration": {
                "sources": [
                    "tooling/architecture_fitness.py",
                    "tooling/contract_declarations.py",
                    "tooling/generated_artifacts.py",
                    "tooling/governance.py",
                    "tooling/public_contracts.py"
                ],
                "forbidden_dependencies": ["STRling", "bindings", "spec"]
            }
        },
        {
            "id": "quality-semantic-dependency-boundary",
            "description": "Repository quality tooling must orchestrate contracts and processes rather than import a semantic compiler implementation.",
            "status": "enforced",
            "kind": "forbidden-dependency",
            "configuration": {
                "sources": [
                    "tooling/architecture_fitness.py",
                    "tooling/contract_declarations.py",
                    "tooling/contract_validation.py",
                    "tooling/formatting.py",
                    "tooling/generated_artifacts.py",
                    "tooling/governance.py",
                    "tooling/hygiene.py",
                    "tooling/interop_certification.py",
                    "tooling/interop_contract.py",
                    "tooling/interop_wasm.py",
                    "tooling/quality.py",
                    "tooling/security.py",
                    "tooling/static_analysis.py",
                    "tooling/public_contracts.py"
                ],
                "forbidden_dependencies": ["STRling", "bindings", "spec"]
            }
        },
        {
            "id": "generated-artifact-input-acyclicity",
            "description": "A generated artifact must not appear among its own authoritative sources or generator inputs.",
            "status": "enforced",
            "kind": "generated-input-cycle",
            "configuration": {}
        },
        {
            "id": "task-record-placement",
            "description": "Contained-task records and templates must remain in designated governance locations.",
            "status": "enforced",
            "kind": "task-record-placement",
            "configuration": {
                "allowed_record_roots": [
                    "docs/migration/records",
                    "governance/templates"
                ]
            }
        },
        {
            "id": "new-top-level-implementation-islands",
            "description": "New top-level implementation directories require an explicit architecture declaration.",
            "status": "enforced",
            "kind": "new-top-level-directory",
            "configuration": {
                "allowed_top_level_directories": [
                    ".github",
                    ".vscode",
                    "bindings",
                    "core",
                    "docs",
                    "governance",
                    "spec",
                    "tests",
                    "tooling"
                ],
                "requires_declaration": "architecture_change"
            }
        },
        {
            "id": "canonical-kernel-dependency-boundary",
            "description": "The canonical Rust kernel must not depend on host-language bindings or repository tooling implementations.",
            "status": "enforced",
            "kind": "rust-crate-boundary",
            "configuration": {
                "manifest": "core/internal/Cargo.toml",
                "sources": ["core/src/**/*.rs"],
                "forbidden_repository_roots": ["bindings", "tooling"]
            }
        },
        {
            "id": "canonical-interop-dependency-boundary",
            "description": "The canonical interop bridge may transport versioned contracts and call the public kernel, but must not depend on historical bindings or repository tooling implementations.",
            "status": "enforced",
            "kind": "rust-crate-boundary",
            "configuration": {
                "manifest": "bindings/interop/Cargo.toml",
                "sources": ["bindings/interop/src/**/*.rs"],
                "forbidden_repository_roots": [
                    "bindings/c",
                    "bindings/cpp",
                    "bindings/rust",
                    "tooling"
                ]
            }
        },
        {
            "id": "rust-binding-canonical-kernel-boundary",
            "description": "The curated Rust package must compile the canonical core/src implementation through one same-source crate root, keep internal stages private, and must not restore binding-owned parsing, analysis, planning, emission, or standard-library semantics.",
            "status": "enforced",
            "kind": "native-adapter-boundary",
            "configuration": {
                "sources": ["Cargo.toml", "core/src/lib_public.rs"],
                "forbidden_paths": [
                    "bindings/rust/src/ast.rs",
                    "bindings/rust/src/compiler.rs",
                    "bindings/rust/src/emitter.rs",
                    "bindings/rust/src/emitters/**",
                    "bindings/rust/src/ir.rs",
                    "bindings/rust/src/parser.rs",
                    "bindings/rust/src/validator.rs"
                ],
                "forbidden_markers": [
                    "regex::",
                    "pcre2_sys",
                    "binding_owned_parser",
                    "binding_owned_emitter",
                    "strling-kernel ="
                ],
                "required_markers": [
                    {
                        "path": "Cargo.toml",
                        "markers": [
                            "name = \"strling\"",
                            "\"/core/src/lib_public.rs\"",
                            "\"/core/src/compiler_pipeline.rs\"",
                            "\"/core/src/protocol/**/*.rs\"",
                            "path = \"core/src/lib_public.rs\""
                        ]
                    },
                    {
                        "path": "core/src/lib_public.rs",
                        "markers": [
                            "mod compiler_pipeline;",
                            "pub mod contract",
                            "pub use crate::protocol::*",
                            "pub mod semantic;",
                            "pub mod stdlib;"
                        ]
                    }
                ]
            }
        },
        {
            "id": "c-native-adapter-boundary",
            "description": "The C package must remain a thin native adapter over the canonical interop bridge and must not restore its retired semantic compiler copy or third-party regex/JSON engines.",
            "status": "enforced",
            "kind": "native-adapter-boundary",
            "configuration": {
                "sources": [
                    "bindings/c/src/**/*.c",
                    "bindings/c/include/**/*.h",
                    "bindings/c/CMakeLists.txt",
                    "bindings/c/Makefile"
                ],
                "forbidden_paths": [
                    "bindings/c/src/core/**",
                    "bindings/c/src/compat.c"
                ],
                "forbidden_markers": [
                    "<jansson.h>",
                    "<pcre2.h>",
                    "pcre2_compile",
                    "json_load",
                    "strling_ast_",
                    "STRlingIR",
                    "hint_engine",
                    "escape_literal_for_pcre2"
                ],
                "required_markers": [
                    {
                        "path": "bindings/c/src/strling.c",
                        "markers": [
                            "strling_interop_execute_v1",
                            "strling_interop_owned_bytes_free_v1"
                        ]
                    },
                    {
                        "path": "bindings/c/CMakeLists.txt",
                        "markers": [
                            "bindings/interop/Cargo.toml",
                            "strling_interop_native"
                        ]
                    }
                ]
            }
        },
        {
            "id": "cpp-native-adapter-boundary",
            "description": "The C++ package must remain a type-safe RAII facade over the governed C/native package and must not restore its retired compiler stages or downloaded semantic dependencies.",
            "status": "enforced",
            "kind": "native-adapter-boundary",
            "configuration": {
                "sources": [
                    "bindings/cpp/src/**/*.cpp",
                    "bindings/cpp/include/**/*.hpp",
                    "bindings/cpp/CMakeLists.txt"
                ],
                "forbidden_paths": [
                    "bindings/cpp/include/strling/ast.hpp",
                    "bindings/cpp/include/strling/compiler.hpp",
                    "bindings/cpp/include/strling/core/**",
                    "bindings/cpp/include/strling/ir.hpp",
                    "bindings/cpp/src/ast.cpp",
                    "bindings/cpp/src/compiler.cpp",
                    "bindings/cpp/src/core/**"
                ],
                "forbidden_markers": [
                    "<nlohmann/json.hpp>",
                    "FetchContent",
                    "nlohmann_json",
                    "googletest",
                    "pcre2_compile",
                    "STRlingIR",
                    "hint_engine",
                    "emit_regex"
                ],
                "required_markers": [
                    {
                        "path": "bindings/cpp/CMakeLists.txt",
                        "markers": ["../c", "STRling::c", "strling_cpp"]
                    },
                    {
                        "path": "bindings/cpp/src/strling.cpp",
                        "markers": [
                            "strling_execute_v1",
                            "strling_compile_json_v1",
                            "strling_simply_compile_json_v1"
                        ]
                    },
                    {
                        "path": "bindings/cpp/src/simply.cpp",
                        "markers": [
                            "sl_builder_request_json_v1",
                            "sl_merge_array_v1"
                        ]
                    },
                    {
                        "path": "bindings/cpp/include/strling/native.hpp",
                        "markers": [
                            "response(const response &) = delete",
                            "response(response &&other) noexcept"
                        ]
                    }
                ]
            }
        },
        {
            "id": "typescript-wasm-adapter-boundary",
            "description": "The TypeScript package must remain a thin browser-safe adapter over the governed raw WebAssembly ABI and must not restore its retired parser, compiler stages, validator, emitter, CLI fallback, or runtime regex simulation.",
            "status": "enforced",
            "kind": "native-adapter-boundary",
            "configuration": {
                "sources": [
                    "bindings/typescript/src/**/*.ts",
                    "bindings/typescript/package.json"
                ],
                "forbidden_paths": [
                    "bindings/typescript/src/STRling/core/**",
                    "bindings/typescript/src/STRling/emitters/**",
                    "bindings/typescript/src/types/ajv-dist-2020.d.ts"
                ],
                "forbidden_markers": [
                    "node:child_process",
                    "spawnSync",
                    "emitPCRE2",
                    "new RegExp(",
                    "ajv/dist/2020"
                ],
                "required_markers": [
                    {
                        "path": "bindings/typescript/src/STRling/interop.ts",
                        "markers": [
                            "strling_wasm_execute_v1",
                            "strling_wasm_owned_bytes_free_v1",
                            "serialized execution"
                        ]
                    },
                    {
                        "path": "bindings/typescript/package.json",
                        "markers": [
                            "./node",
                            "./simply",
                            "./strling_interop.wasm"
                        ]
                    }
                ]
            }
        },
        {
            "id": "python-native-adapter-boundary",
            "description": "The Python package must remain a thin adapter over the governed native ABI and must not restore its retired parser, compiler stages, validator, emitter, CLI fallback, or runtime regex simulation.",
            "status": "enforced",
            "kind": "native-adapter-boundary",
            "configuration": {
                "sources": [
                    "bindings/python/src/**/*.py",
                    "bindings/python/scripts/assemble_native.py",
                    "bindings/python/setup.py",
                    "bindings/python/pyproject.toml"
                ],
                "forbidden_paths": [
                    "bindings/python/src/STRling/core/**",
                    "bindings/python/src/STRling/emitters/**",
                    "bindings/python/testing.py"
                ],
                "forbidden_markers": [
                    "import re",
                    "from re import",
                    "STRling.core",
                    "STRling.emitters",
                    "CliSimplyPreviewTransport",
                    "emit_pcre2"
                ],
                "required_markers": [
                    {
                        "path": "bindings/python/src/STRling/interop.py",
                        "markers": [
                            "ctypes.CDLL",
                            "strling_interop_execute_v1",
                            "strling_interop_owned_bytes_free_v1"
                        ]
                    },
                    {
                        "path": "bindings/python/setup.py",
                        "markers": [
                            "BuildWithNativeInterop",
                            "assemble_native.py",
                            "root_is_pure = False"
                        ]
                    },
                    {
                        "path": "bindings/python/scripts/assemble_native.py",
                        "markers": ["+1.75.0", "--locked", "--offline"]
                    }
                ]
            }
        },
        {
            "id": "canonical-ci-profile-routing",
            "description": "CI and release workflows must use canonical profiles as certification authority, derive product evidence only from their structured artifacts, and retain both forms without redefining pass or fail.",
            "status": "enforced",
            "kind": "ci-profile-routing",
            "configuration": {
                "sources": [
                    ".github/workflows/ci.yml",
                    ".github/workflows/cd.yml"
                ]
            }
        },
        {
            "id": "duplicated-binding-compilers",
            "description": "Tracked binding products may not contain parser, compiler-stage, analyzer, validator, IR, or emitter implementation paths outside exact canonical facade exceptions.",
            "status": "enforced",
            "kind": "binding-semantic-path-boundary",
            "configuration": {
                "sources": ["bindings/**"],
                "semantic_names": [
                    "ast",
                    "compiler",
                    "emitter",
                    "emitters",
                    "hint_engine",
                    "ir",
                    "nodes",
                    "parser",
                    "pcre2_emitter",
                    "validator"
                ],
                "permitted_paths": [
                    "bindings/csharp/src/STRling/Canonical/Compiler.cs",
                    "bindings/java/src/main/java/com/strling/Compiler.java",
                    "bindings/kotlin/src/main/kotlin/strling/Compiler.kt",
                    "bindings/python/src/STRling/compiler.py",
                    "bindings/typescript/src/STRling/compiler.ts"
                ],
                "excluded_path_parts": [
                    "__tests__",
                    "docs",
                    "examples",
                    "test",
                    "tests"
                ]
            }
        },
        {
            "id": "implementation-derived-shared-fixtures",
            "description": "Frozen implementation-era JSON outputs remain data-only migration history pending the final P19 architecture ratchet.",
            "status": "transitional",
            "kind": "tracked-transition",
            "configuration": {
                "tracked_paths": [
                    "tests/spec/*.json",
                    "tooling/js_to_json_ast/**"
                ]
            },
            "rationale": "The 596 bytes-preserved files are explicitly non-normative history, excluded from product and certification authority, and retained for migration archaeology.",
            "retirement_condition": "P19-T05 replaces this transitional path census with the final permanent non-authority rule or removes the historical corpus by an explicit governed decision."
        },
        {
            "id": "legacy-reference-authority-boundary",
            "description": "Retained implementation-era corpora are data-only history and cannot become product, normative, generation, profile, or certification authority.",
            "status": "enforced",
            "kind": "non-normative-history-boundary",
            "configuration": {
                "history_roots": ["tooling/legacy_reference/**"],
                "allowed_files": [
                    "tooling/legacy_reference/README.md",
                    "tooling/legacy_reference/corpus.json",
                    "tooling/legacy_reference/python_corpus.json"
                ],
                "consumer_sources": [
                    ".github/workflows/**",
                    "bindings/**",
                    "core/**",
                    "package.json",
                    "spec/**",
                    "strling",
                    "strling.ps1",
                    "tests/certification/product/1.0/producer-manifest.json",
                    "toolchain.json"
                ],
                "forbidden_reference_markers": [
                    "tooling/legacy_reference/corpus.json",
                    "tooling/legacy_reference/python_corpus.json"
                ],
                "forbidden_extensions": [
                    ".cjs",
                    ".js",
                    ".mjs",
                    ".ps1",
                    ".py",
                    ".sh",
                    ".ts"
                ]
            }
        },
        {
            "id": "lsp-python-binding-semantic-dependency",
            "description": "Canonical LSP code actions, formatting, island extraction, and their closed evidence must not import the transitional Python binding.",
            "status": "enforced",
            "kind": "forbidden-import",
            "configuration": {
                "sources": [
                    "tooling/lsp-server/island_extractor.py",
                    "tooling/lsp-server/server/canonical_intelligence.py",
                    "tooling/lsp-server/server/island_extractor.py",
                    "tooling/lsp-server/server/server.py",
                    "tooling/lsp-server/tests/canonical_actions_islands_evidence.py",
                    "tooling/lsp-server/tests/test_canonical_actions_islands_evidence.py",
                    "tooling/lsp-server/tests/test_code_actions.py",
                    "tooling/lsp-server/tests/test_formatting.py",
                    "tooling/lsp-server/tests/test_island_extractor.py"
                ],
                "forbidden_modules": ["STRling"]
            }
        },
        {
            "id": "lsp-package-canonical-runtime-boundary",
            "description": "The extension package generator, packaged-runtime certification, and authored server adapters must not import the transitional Python binding as a semantic or runtime dependency.",
            "status": "enforced",
            "kind": "forbidden-import",
            "configuration": {
                "sources": [
                    "tooling/lsp-server/package_extension.py",
                    "tooling/lsp-server/server/canonical_core.py",
                    "tooling/lsp-server/server/canonical_intelligence.py",
                    "tooling/lsp-server/server/island_extractor.py",
                    "tooling/lsp-server/server/server.py",
                    "tooling/lsp-server/tests/packaged_runtime_evidence.py",
                    "tooling/lsp-server/tests/test_package_builder.py",
                    "tooling/lsp-server/tests/test_package_contract.py"
                ],
                "forbidden_modules": ["STRling"]
            }
        },
        {
            "id": "lsp-canonical-diagnostics-hover-boundary",
            "description": "Canonical LSP diagnostics, hover, lifecycle, and their evidence must not import the transitional Python binding.",
            "status": "enforced",
            "kind": "forbidden-import",
            "configuration": {
                "sources": [
                    "tooling/lsp-server/server/canonical_core.py",
                    "tooling/lsp-server/server/server.py",
                    "tooling/lsp-server/tests/canonical_evidence.py",
                    "tooling/lsp-server/tests/test_canonical_core.py",
                    "tooling/lsp-server/tests/test_diagnostics.py",
                    "tooling/lsp-server/tests/test_hover.py",
                    "tooling/lsp-server/tests/test_lsp_lifecycle.py",
                    "tooling/lsp-server/tests/test_lsp_server.py",
                    "tooling/lsp-server/tests/test_parser_exhaustive.py"
                ],
                "forbidden_modules": ["STRling"]
            }
        },
        {
            "id": "lsp-canonical-editor-intelligence-boundary",
            "description": "Completion, navigation, symbols, references, semantic tokens, and their closed evidence must not import the transitional Python binding.",
            "status": "enforced",
            "kind": "forbidden-import",
            "configuration": {
                "sources": [
                    "tooling/lsp-server/server/canonical_intelligence.py",
                    "tooling/lsp-server/server/server.py",
                    "tooling/lsp-server/tests/canonical_intelligence_evidence.py",
                    "tooling/lsp-server/tests/test_canonical_intelligence.py",
                    "tooling/lsp-server/tests/test_completion.py",
                    "tooling/lsp-server/tests/test_navigation.py",
                    "tooling/lsp-server/tests/test_semantic_tokens.py"
                ],
                "forbidden_modules": ["STRling"]
            }
        },
        {
            "id": "specification-reference-authority-boundary",
            "description": "Specification schemas may reference only specification-owned schema contracts, never generated implementation output.",
            "status": "enforced",
            "kind": "schema-reference-boundary",
            "configuration": {
                "sources": [
                    "spec/schema/*.json",
                    "spec/contracts/**/*.schema.json",
                    "spec/frontends/**/*.schema.json"
                ],
                "allowed_reference_roots": [
                    "spec/schema",
                    "spec/contracts",
                    "spec/frontends"
                ]
            }
        },
        {
            "id": "regex-frontend-authority-boundary",
            "description": "The regex-compatible frontend owns only versioned compatibility syntax and cannot define canonical semantic or target authority.",
            "status": "enforced",
            "kind": "frontend-authority-boundary",
            "configuration": {
                "frontend_contract_sources": ["spec/frontends/legacy-regex/**"],
                "semantic_authority_sources": [
                    "core/src/semantic/**",
                    "spec/contracts/1.0/semantic-ir.schema.json",
                    "spec/drafts/**"
                ],
                "target_authority_sources": [
                    "core/src/portability_planning.rs",
                    "core/src/target/**",
                    "spec/contracts/1.0/target-artifact.schema.json",
                    "spec/contracts/1.0/target-profile.schema.json",
                    "spec/targets/**"
                ],
                "forbidden_frontend_markers": [
                    "%flags",
                    "legacy-regex",
                    "strling.regex-compat",
                    "text/x-strling-regex-compat"
                ],
                "contract_forbidden_authority_markers": [
                    "\"raw_fragment_model\": \"opaque-passthrough\"",
                    "\"semantic_authority\": true",
                    "\"target_assumption\": \"inferred\"",
                    "\"target_authority\": true"
                ]
            }
        },
        {
            "id": "semantic-strling-authority-boundary",
            "description": "The Semantic STRling contract owns versioned source syntax and mapping but cannot implement parsing or redefine canonical semantics, targets, or runtimes.",
            "status": "enforced",
            "kind": "frontend-authority-boundary",
            "configuration": {
                "frontend_contract_sources": ["spec/frontends/semantic/**"],
                "semantic_authority_sources": [
                    "core/src/semantic/**",
                    "spec/contracts/1.0/semantic-ir.schema.json"
                ],
                "target_authority_sources": [
                    "core/src/portability_planning.rs",
                    "core/src/target/**",
                    "spec/contracts/1.0/target-artifact.schema.json",
                    "spec/contracts/1.0/target-profile.schema.json",
                    "spec/targets/**"
                ],
                "forbidden_frontend_markers": [
                    "strling.semantic",
                    "semantic strling 1.0",
                    "text/x-strling-semantic"
                ],
                "contract_forbidden_authority_markers": [
                    "\"canonical_semantic_authority\": true",
                    "\"target_authority\": true",
                    "\"runtime_authority\": true",
                    "\"parser_implementation\": true",
                    "\"formatter_implementation\": true"
                ]
            }
        },
        {
            "id": "new-tooling-semantic-islands",
            "description": "New parser, compiler, analyzer, planner, or emitter implementations under tooling require explicit architecture review.",
            "status": "enforced",
            "kind": "semantic-island-placement",
            "configuration": {
                "guarded_roots": ["tooling"],
                "semantic_names": [
                    "parser",
                    "compiler",
                    "analyzer",
                    "planner",
                    "emitter"
                ],
                "requires_declaration": "architecture_change"
            }
        },
        {
            "id": "jvm-canonical-adapter-boundary",
            "description": "Java and Kotlin expose only request-recording facades over one pinned shared JVM/native bridge; historical semantic copies and alternate native or regex routes are forbidden.",
            "status": "enforced",
            "kind": "jvm-adapter-boundary",
            "configuration": {
                "sources": [
                    "bindings/java/src/main/java/**/*.java",
                    "bindings/kotlin/src/main/kotlin/**/*.kt"
                ],
                "forbidden_paths": [
                    "bindings/java/src/main/java/com/strling/core/**",
                    "bindings/java/src/main/java/com/strling/emitters/**",
                    "bindings/kotlin/src/main/kotlin/strling/core/**",
                    "bindings/kotlin/src/main/kotlin/strling/emitters/**"
                ],
                "forbidden_markers": [
                    "com.sun.jna",
                    "Native.load(",
                    "ProcessBuilder",
                    "Runtime.getRuntime().exec",
                    "java.util.regex",
                    "kotlin.text.Regex"
                ],
                "required_markers": [
                    {
                        "path": "bindings/java/pom.xml",
                        "markers": ["<artifactId>strling-jvm</artifactId>"]
                    },
                    {
                        "path": "bindings/kotlin/build.gradle.kts",
                        "markers": ["api(\"com.strling:strling-jvm:3.0.0\")"]
                    },
                    {
                        "path": "bindings/jvm/pom.xml",
                        "markers": [
                            "<jna.version>5.19.1</jna.version>",
                            "<artifactId>jna</artifactId>"
                        ]
                    },
                    {
                        "path": "bindings/jvm/src/main/java/com/strling/jvm/NativeClient.java",
                        "markers": [
                            "strling_interop_abi_version_v1",
                            "strling_interop_execute_v1",
                            "strling_interop_owned_bytes_free_v1"
                        ]
                    }
                ]
            }
        },
        {
            "id": "dotnet-canonical-adapter-boundary",
            "description": "C# and F# expose request-recording facades over one C# NativeLibrary bridge; historical semantic copies and alternate native or regex routes are forbidden.",
            "status": "enforced",
            "kind": "dotnet-adapter-boundary",
            "configuration": {
                "sources": [
                    "bindings/csharp/src/STRling/**/*.cs",
                    "bindings/fsharp/src/STRling.FSharp/**/*.fs"
                ],
                "fsharp_sources": [
                    "bindings/fsharp/src/STRling.FSharp/**/*.fs"
                ],
                "forbidden_paths": [
                    "bindings/csharp/src/STRling/Core/Compiler.cs",
                    "bindings/csharp/src/STRling/Core/HintEngine.cs",
                    "bindings/csharp/src/STRling/Core/IR.cs",
