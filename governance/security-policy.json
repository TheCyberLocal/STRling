{
    "policy_version": 1,
    "engine": {
        "name": "strling-repository-security",
        "version": "1.0.0"
    },
    "security_tools": {
        "cargo-audit": {
            "version": "0.22.2",
            "install_command": "cargo install cargo-audit --version 0.22.2 --locked",
            "advisory_source": "rustsec"
        }
    },
    "result_schema": "governance/schemas/security-result.schema.json",
    "waiver_schema": "governance/schemas/waiver.schema.json",
    "security_waivers": ["WVR-SEC-NPM-TOOLING-001", "WVR-SEC-VSCE-LICENSE-001"],
    "statuses": ["passed", "failed", "waived", "unavailable", "incomplete"],
    "blocking_statuses": ["failed", "unavailable", "incomplete"],
    "dependency_roots": [
        {
            "id": "repository-npm",
            "ecosystem": "npm",
            "classification": "actively_governed",
            "usage": "tooling_only",
            "manifests": ["package.json"],
            "locks": ["package-lock.json"],
            "lock_policy": "required",
            "integrity_mode": "npm_lock_v3",
            "risk_mode": "npm_audit"
        },
        {
            "id": "lsp-npm",
            "ecosystem": "npm",
            "classification": "actively_governed",
            "usage": "tooling_only",
            "manifests": ["tooling/lsp-server/package.json"],
            "locks": ["tooling/lsp-server/package-lock.json"],
            "lock_policy": "required",
            "integrity_mode": "npm_lock_v3",
            "risk_mode": "npm_audit"
        },
        {
            "id": "typescript-npm",
            "ecosystem": "npm",
            "classification": "actively_governed",
            "usage": "runtime",
            "manifests": ["bindings/typescript/package.json"],
            "locks": ["bindings/typescript/package-lock.json"],
            "lock_policy": "required",
            "integrity_mode": "npm_lock_v3",
            "risk_mode": "npm_audit"
        },
        {
            "id": "core-cargo",
            "ecosystem": "cargo",
            "classification": "actively_governed",
            "usage": "runtime",
            "manifests": ["core/Cargo.toml"],
            "locks": ["core/Cargo.lock"],
            "lock_policy": "required",
            "integrity_mode": "cargo_lock",
            "risk_mode": "cargo_audit"
        },
        {
            "id": "interop-cargo",
            "ecosystem": "cargo",
            "classification": "actively_governed",
            "usage": "runtime",
            "manifests": ["bindings/interop/Cargo.toml"],
            "locks": ["bindings/interop/Cargo.lock"],
            "lock_policy": "required",
            "integrity_mode": "cargo_lock",
            "risk_mode": "cargo_audit"
        },
        {
            "id": "interop-fuzz-cargo",
            "ecosystem": "cargo",
            "classification": "actively_governed",
            "usage": "tooling_only",
            "manifests": ["bindings/interop/fuzz/Cargo.toml"],
            "locks": ["bindings/interop/Cargo.lock"],
            "lock_policy": "required",
            "integrity_mode": "cargo_lock",
            "risk_mode": "cargo_audit"
        },
        {
            "id": "rust-binding-cargo",
            "ecosystem": "cargo",
            "classification": "actively_governed",
            "usage": "runtime",
            "manifests": ["bindings/rust/Cargo.toml"],
            "locks": ["bindings/rust/Cargo.lock"],
            "lock_policy": "required",
            "integrity_mode": "cargo_lock",
            "risk_mode": "cargo_audit"
        },
        {
            "id": "dart-pub",
            "ecosystem": "dart-pub",
            "classification": "actively_governed",
            "usage": "runtime",
            "manifests": ["bindings/dart/pubspec.yaml"],
            "locks": ["bindings/dart/pubspec.lock"],
            "lock_policy": "required",
            "integrity_mode": "presence_and_parse",
            "risk_mode": "unavailable"
        },
        {
            "id": "php-composer",
            "ecosystem": "composer",
            "classification": "transitional",
            "usage": "runtime",
            "manifests": ["bindings/php/composer.json"],
            "locks": ["bindings/php/composer.lock"],
            "lock_policy": "required",
            "integrity_mode": "composer_lock",
            "risk_mode": "unavailable"
        },
        {
            "id": "ruby-bundler",
            "ecosystem": "bundler",
            "classification": "transitional",
            "usage": "runtime",
            "manifests": [
                "bindings/ruby/Gemfile",
                "bindings/ruby/strling.gemspec"
            ],
            "locks": ["bindings/ruby/Gemfile.lock"],
            "lock_policy": "required",
            "integrity_mode": "presence_and_parse",
            "risk_mode": "unavailable"
        },
        {
            "id": "go-binding",
            "ecosystem": "go",
            "classification": "actively_governed",
            "usage": "runtime",
            "manifests": ["bindings/go/go.mod"],
            "locks": [],
            "lock_policy": "not_used_no_external_dependencies",
            "integrity_mode": "no_external_dependencies",
            "risk_mode": "no_dependencies"
        },
        {
            "id": "swift-binding",
            "ecosystem": "swiftpm",
            "classification": "actively_governed",
            "usage": "runtime",
            "manifests": ["bindings/swift/Package.swift"],
            "locks": [],
