{
    "policy_version": 1,
    "engine": {
        "name": "strling-repository-security",
        "version": "1.0.0"
    },
    "result_schema": "governance/schemas/security-result.schema.json",
    "waiver_schema": "governance/schemas/waiver.schema.json",
    "statuses": ["passed", "failed", "waived", "unavailable", "incomplete"],
    "blocking_statuses": ["failed", "unavailable", "incomplete"],
    "dependency_roots": [
        {
            "id": "repository-npm",
            "ecosystem": "npm",
            "classification": "actively_governed",
            "usage": "tooling_only",
            "manifests": ["package.json"],
            "locks": ["package-lock.json"],
            "lock_policy": "required",
            "integrity_mode": "npm_lock_v3",
            "risk_mode": "npm_audit"
        },
        {
            "id": "lsp-npm",
            "ecosystem": "npm",
            "classification": "actively_governed",
            "usage": "tooling_only",
            "manifests": ["tooling/lsp-server/package.json"],
            "locks": ["tooling/lsp-server/package-lock.json"],
            "lock_policy": "required",
            "integrity_mode": "npm_lock_v3",
            "risk_mode": "npm_audit"
        },
        {
            "id": "typescript-npm",
            "ecosystem": "npm",
            "classification": "actively_governed",
            "usage": "runtime",
            "manifests": ["bindings/typescript/package.json"],
            "locks": ["bindings/typescript/package-lock.json"],
            "lock_policy": "required",
            "integrity_mode": "npm_lock_v3",
            "risk_mode": "npm_audit"
        },
        {
