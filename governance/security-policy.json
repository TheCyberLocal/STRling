        {
            "id": "perl-cpan",
            "ecosystem": "cpan",
            "classification": "transitional",
            "usage": "runtime",
            "manifests": [
                "bindings/perl/Makefile.PL",
                "bindings/perl/dist.ini"
            ],
            "locks": [],
            "lock_policy": "not_supported",
            "integrity_mode": "inventory_only",
            "risk_mode": "unavailable"
        },
        {
            "id": "r-package",
            "ecosystem": "r",
            "classification": "transitional",
            "usage": "runtime",
            "manifests": ["bindings/r/DESCRIPTION"],
            "locks": [],
            "lock_policy": "transitional_missing",
            "integrity_mode": "inventory_only",
            "risk_mode": "unavailable"
        }
    ],
    "manifest_names": [
        "package.json",
        "Cargo.toml",
        "go.mod",
        "pom.xml",
        "build.gradle",
        "build.gradle.kts",
        "pyproject.toml",
        "requirements.txt",
        "composer.json",
        "pubspec.yaml",
        "Gemfile",
        "Makefile.PL",
        "dist.ini",
        "DESCRIPTION",
        "Package.swift"
    ],
    "manifest_suffixes": [".csproj", ".fsproj", ".gemspec", ".rockspec"],
    "dependency_rules": {
        "prohibited_specifiers": ["*", "latest", "main", "master", "stable"],
        "require_npm_integrity": true,
        "require_cargo_checksums": true
    },
    "vulnerability_policy": {
        "network_mode": "certification_only",
        "blocking_severities": ["high", "critical"],
        "advisory_sources": { "npm": "npm-registry", "cargo": "rustsec" }
    },
    "license_policy": {
        "permitted": [
            "0BSD",
            "Apache-2.0",
            "BSD-2-Clause",
            "BSD-3-Clause",
            "CC0-1.0",
            "ISC",
            "MIT",
            "MPL-2.0",
            "Python-2.0",
            "Unlicense",
            "Zlib"
        ],
        "prohibited": [
            "AGPL-1.0-only",
            "AGPL-1.0-or-later",
            "AGPL-3.0-only",
            "AGPL-3.0-or-later",
            "SSPL-1.0"
        ],
        "unknown_is_blocking": true
    },
    "workflow_policy": {
        "default_permissions": "contents-read",
        "immutable_action_references": true,
        "validation_secrets_prohibited": true,
        "shell_secret_interpolation_prohibited": true
    }
}
