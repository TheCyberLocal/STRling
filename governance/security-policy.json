        },
        {
            "id": "fsharp-nuget",
            "ecosystem": "nuget",
            "classification": "transitional",
            "usage": "runtime",
            "manifests": [
                "bindings/fsharp/src/STRling/STRling.fsproj",
                "bindings/fsharp/src/STRling.FSharp/STRling.FSharp.fsproj",
                "bindings/fsharp/tests/STRling.Tests/STRling.Tests.fsproj",
                "bindings/fsharp/test/STRling.FSharp.Tests/STRling.FSharp.Tests.fsproj"
