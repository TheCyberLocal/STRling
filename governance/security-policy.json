{
    "policy_version": 1,
    "engine": {
        "name": "strling-repository-security",
        "version": "1.2.0"
    },
    "security_tools": {
        "cargo-audit": {
            "version": "0.22.2",
            "install_command": "cargo install cargo-audit --version 0.22.2 --locked",
            "advisory_source": "rustsec"
        },
        "osv-scanner": {
            "version": "2.4.0",
            "release": "https://github.com/google/osv-scanner/releases/tag/v2.4.0",
            "executable_environment_variable": "STRLING_OSV_SCANNER",
            "sha256": {
                "linux_amd64": "15314940c10d26af9c6649f150b8a47c1262e8fc7e17b1d1029b0e479e8ed8a0",
                "windows_amd64": "0cdd113610126d5dfd5e12ad0e0b4f3e879291ff19bb43b0c52ed2f2c2df1a37"
            },
            "license_allowlist": [
                "0BSD",
                "Apache-2.0",
                "Artistic-2.0",
                "BSD-2-Clause",
                "BSD-3-Clause",
                "BSL-1.0",
                "BlueOak-1.0.0",
                "CC-BY-3.0",
                "CC-BY-4.0",
                "CC0-1.0",
                "ISC",
                "MIT",
                "MPL-2.0",
                "NCSA",
                "Python-2.0",
                "Unicode-3.0",
                "Unlicense",
                "WTFPL",
                "Zlib"
            ]
        }
    },
    "result_schema": "governance/schemas/security-result.schema.json",
    "waiver_schema": "governance/schemas/waiver.schema.json",
    "security_waivers": ["WVR-SEC-VSCE-LICENSE-001"],
    "statuses": ["passed", "failed", "waived", "unavailable", "incomplete"],
    "blocking_statuses": ["failed", "unavailable", "incomplete"],
    "dependency_roots": [
