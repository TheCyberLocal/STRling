            "usage": "runtime",
            "manifests": ["bindings/c/Makefile"],
            "locks": [],
            "lock_policy": "not_supported",
            "integrity_mode": "inventory_only",
            "risk_mode": "unavailable"
        },
        {
            "id": "cpp-cmake",
            "ecosystem": "cmake",
            "classification": "transitional",
            "usage": "runtime",
            "manifests": [
                "bindings/cpp/CMakeLists.txt",
                "bindings/cpp/test/CMakeLists.txt"
            ],
            "locks": [],
            "lock_policy": "not_supported",
            "integrity_mode": "inventory_only",
            "risk_mode": "unavailable"
        },
        {
            "id": "csharp-nuget",
            "ecosystem": "nuget",
            "classification": "transitional",
            "usage": "runtime",
            "manifests": [
                "bindings/csharp/src/STRling/STRling.csproj",
                "bindings/csharp/src/STRling.Cli/STRling.Cli.csproj",
                "bindings/csharp/tests/STRling.Tests/STRling.Tests.csproj"
            ],
            "locks": [],
            "lock_policy": "transitional_missing",
            "integrity_mode": "inventory_only",
            "risk_mode": "unavailable"
        },
        {
            "id": "fsharp-nuget",
            "ecosystem": "nuget",
            "classification": "transitional",
            "usage": "runtime",
            "manifests": [
                "bindings/fsharp/src/STRling/STRling.fsproj",
                "bindings/fsharp/src/STRling.FSharp/STRling.FSharp.fsproj",
                "bindings/fsharp/tests/STRling.Tests/STRling.Tests.fsproj",
                "bindings/fsharp/test/STRling.FSharp.Tests/STRling.FSharp.Tests.fsproj"
            ],
            "locks": [],
            "lock_policy": "transitional_missing",
            "integrity_mode": "inventory_only",
            "risk_mode": "unavailable"
        },
        {
            "id": "java-maven",
            "ecosystem": "maven",
            "classification": "transitional",
            "usage": "runtime",
            "manifests": ["bindings/java/pom.xml"],
            "locks": [],
            "lock_policy": "transitional_no_transitive_lock",
            "integrity_mode": "direct_pins",
            "risk_mode": "unavailable"
        },
        {
            "id": "kotlin-gradle",
            "ecosystem": "gradle",
            "classification": "transitional",
            "usage": "runtime",
            "manifests": ["bindings/kotlin/build.gradle.kts"],
            "locks": [],
            "lock_policy": "transitional_no_dependency_lock",
            "integrity_mode": "direct_pins",
            "risk_mode": "unavailable"
        },
        {
            "id": "python-binding",
            "ecosystem": "python",
            "classification": "transitional",
            "usage": "runtime",
            "manifests": [
                "bindings/python/pyproject.toml",
                "bindings/python/requirements.txt"
            ],
            "locks": [],
            "lock_policy": "transitional_missing",
            "integrity_mode": "inventory_only",
            "risk_mode": "unavailable"
        },
        {
            "id": "lsp-python",
            "ecosystem": "python",
            "classification": "actively_governed",
            "usage": "runtime",
            "manifests": ["tooling/lsp-server/requirements.txt"],
            "locks": [],
            "lock_policy": "not_used_no_external_dependencies",
            "integrity_mode": "exact_requirements",
            "risk_mode": "no_dependencies"
        },
        {
            "id": "quality-python",
            "ecosystem": "python",
            "classification": "transitional",
            "usage": "tooling_only",
            "manifests": ["tooling/requirements-quality.txt"],
            "locks": [],
            "lock_policy": "transitional_exact_without_hashes",
            "integrity_mode": "exact_requirements",
            "risk_mode": "unavailable"
        },
        {
            "id": "lua-luarocks",
            "ecosystem": "luarocks",
            "classification": "transitional",
            "usage": "runtime",
            "manifests": ["bindings/lua/strling-template.rockspec"],
            "locks": [],
            "lock_policy": "not_supported",
            "integrity_mode": "inventory_only",
            "risk_mode": "unavailable"
        },
        {
            "id": "perl-cpan",
            "ecosystem": "cpan",
            "classification": "transitional",
            "usage": "runtime",
            "manifests": [
                "bindings/perl/Makefile.PL",
                "bindings/perl/dist.ini"
            ],
            "locks": [],
            "lock_policy": "not_supported",
            "integrity_mode": "inventory_only",
            "risk_mode": "unavailable"
        },
        {
            "id": "r-package",
            "ecosystem": "r",
            "classification": "transitional",
            "usage": "runtime",
            "manifests": ["bindings/r/DESCRIPTION"],
            "locks": [],
            "lock_policy": "transitional_missing",
            "integrity_mode": "inventory_only",
            "risk_mode": "unavailable"
        }
    ],
    "manifest_names": [
        "package.json",
        "Cargo.toml",
        "go.mod",
        "pom.xml",
        "build.gradle",
        "build.gradle.kts",
        "pyproject.toml",
        "requirements.txt",
        "composer.json",
        "pubspec.yaml",
        "Gemfile",
        "Makefile.PL",
        "dist.ini",
        "DESCRIPTION",
        "Package.swift"
    ],
    "manifest_suffixes": [".csproj", ".fsproj", ".gemspec", ".rockspec"],
    "dependency_rules": {
        "prohibited_specifiers": ["*", "latest", "main", "master", "stable"],
        "require_npm_integrity": true,
        "require_cargo_checksums": true
    },
    "vulnerability_policy": {
        "network_mode": "certification_only",
        "blocking_severities": ["high", "critical"],
        "advisory_sources": { "npm": "npm-registry", "cargo": "rustsec" }
    },
    "license_policy": {
        "permitted": [
            "(BSD-2-Clause OR MIT OR Apache-2.0)",
            "(MIT OR Apache-2.0) AND Unicode-3.0",
            "(MIT OR CC0-1.0)",
            "(MIT OR WTFPL)",
            "0BSD",
            "Apache-2.0",
            "Apache-2.0 OR BSL-1.0",
            "Apache-2.0 OR MIT",
            "Artistic-2.0",
            "BSD-2-Clause",
            "BSD-3-Clause",
            "BlueOak-1.0.0",
            "CC-BY-3.0",
            "CC-BY-4.0",
            "CC0-1.0",
            "ISC",
            "MIT",
            "MIT OR Apache-2.0",
            "MIT/Apache-2.0",
            "MPL-2.0",
            "Python-2.0",
            "Unlicense",
            "Unlicense OR MIT",
            "Unlicense/MIT",
            "WTFPL",
            "Zlib"
        ],
        "prohibited": [
            "AGPL-1.0-only",
            "AGPL-1.0-or-later",
            "AGPL-3.0-only",
            "AGPL-3.0-or-later",
            "SSPL-1.0"
        ],
        "metadata_overrides": [
            {
                "ecosystem": "npm",
                "package": "exit",
                "version": "0.1.2",
                "license": "MIT",
                "evidence": "The exact published package manifest uses its legacy licenses field to identify MIT while package-lock v3 omits that field."
            }
        ],
        "unknown_is_blocking": true
    },
    "secret_policy": {
        "credential_marker_policy": "governance/repository-hygiene.json"
    },
    "workflow_policy": {
        "default_permissions": { "contents": "read" },
        "immutable_action_references": true,
        "validation_secrets_prohibited": true,
        "shell_secret_interpolation_prohibited": true,
        "privileged_jobs": {
            ".github/workflows/cd.yml": {
                "publish-go": ["contents"],
                "publish-php": ["contents"],
                "publish-r": ["contents"],
                "publish-swift": ["contents"],
                "publish-dart": ["id-token"],
                "publish-python": ["id-token"],
                "publish-ruby": ["id-token"],
                "publish-rust": ["id-token"],
                "publish-typescript": ["id-token"]
            }
        },
        "credential_persistence_jobs": {
            ".github/workflows/cd.yml": [
                "publish-go",
                "publish-php",
                "publish-r",
                "publish-swift"
            ]
        }
    }
}
