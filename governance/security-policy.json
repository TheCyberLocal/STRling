            "usage": "runtime",
            "manifests": ["bindings/rust/Cargo.toml"],
            "locks": ["bindings/rust/Cargo.lock"],
            "lock_policy": "required",
            "integrity_mode": "cargo_lock",
            "risk_mode": "cargo_audit"
        },
        {
            "id": "dart-pub",
            "ecosystem": "dart-pub",
            "classification": "actively_governed",
            "usage": "runtime",
            "manifests": ["bindings/dart/pubspec.yaml"],
            "locks": ["bindings/dart/pubspec.lock"],
            "lock_policy": "required",
