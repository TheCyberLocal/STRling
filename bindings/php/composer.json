{
    "name": "strling/strling",
    "version": "3.0.0",
    "description": "Thin PHP FFI adapter for the canonical STRling compiler",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "STRling Team"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-ffi": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "STRling\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "STRling\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
