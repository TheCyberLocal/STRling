/**
 * @file compiler.hpp
 * @brief AST → IR compilation entry points for the C++ binding.
 *
 * Phase 3a parity with the TypeScript SSOT exposes a diagnostics-bearing
 * variant of `compile()` that surfaces non-fatal warnings (e.g. ReDoS risk)
 * alongside the lowered IR, while still throwing for unrecoverable
 * structural problems (variable-length lookbehinds, AST depth-limit
 * exhaustion). The legacy `compile(ast)` overload is preserved as a thin
 * adapter for callers that do not yet consume warnings.
 */

#ifndef STRLING_COMPILER_HPP
#define STRLING_COMPILER_HPP

#include "strling/ast.hpp"
#include "strling/ir.hpp"

#include <string>
#include <vector>

namespace strling {

/// Default upper bound on AST nesting depth before the emitter aborts.
/// Mirrors `STRLING_DEFAULT_MAX_DEPTH` in the TypeScript and C bindings.
inline constexpr int kStrlingDefaultMaxDepth = 250;

/// Stable warning code for nested-unbounded-quantifier ReDoS risk.
inline const std::string kStrlingWarningRedosRisk = "REDOS_RISK";

/// Bundles the lowered IR with any non-fatal diagnostics produced during
/// emission. Warnings are formatted as "CODE: message" strings to match
/// the wire format the C and TypeScript bindings already emit.
struct CompileResult {
    ir::IRNodePtr ir;
    std::vector<std::string> warnings;
};

/// Diagnostics-bearing compile entry point. Throws `std::runtime_error`
/// for fatal structural violations; populates `warnings` for non-fatal
/// hazards such as nested unbounded quantifiers.
///
/// @param ast       Root AST node to lower.
/// @param max_depth Upper bound on nesting depth. Values <= 0 fall back
///                  to `kStrlingDefaultMaxDepth`. Test fixtures may pass
///                  small values to exercise the depth guard.
CompileResult compile_with_diagnostics(const ast::NodePtr& ast,
                                       int max_depth = 0);

/// Backwards-compatible entry point — returns the IR only and silently
/// discards any warnings. New callers should prefer
/// `compile_with_diagnostics()`.
ir::IRNodePtr compile(const ast::NodePtr& ast);

} // namespace strling

#endif // STRLING_COMPILER_HPP
