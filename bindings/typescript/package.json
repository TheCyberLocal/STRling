{
    "name": "@strling-lang/strling",
    "version": "3.0.0",
    "description": "Next-gen string pattern DSL & compiler",
    "keywords": [
        "strling",
        "regex",
        "regexp",
        "regular expression",
        "string",
        "validation",
        "pattern",
        "parser",
        "compiler",
        "dsl",
        "readable",
        "beginner"
    ],
    "author": "STRling Team",
    "license": "Apache-2.0",
    "homepage": "https://github.com/strling-lang/strling",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/strling-lang/strling.git"
    },
    "bugs": {
        "url": "https://github.com/strling-lang/strling/issues"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./node": {
            "types": "./dist/node.d.ts",
            "import": "./dist/node.js"
        },
        "./simply": {
            "types": "./dist/STRling/simply/index.d.ts",
            "import": "./dist/STRling/simply/index.js"
        },
        "./strling_interop.wasm": "./dist/strling_interop.wasm"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "rimraf dist && tsc -p tsconfig.json && python scripts/assemble_wasm.py",
        "clean": "rimraf dist",
        "test": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
        "prepack": "npm run build"
    },
    "engines": {
        "node": ">=22 <23"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^24.3.1",
        "jest": "^29.7.0",
        "rimraf": "^6.0.1",
        "ts-jest": "^29.4.1",
        "typescript": "^5.9.2"
    }
}
