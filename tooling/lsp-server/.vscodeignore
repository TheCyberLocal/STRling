# STRling VS Code extension package exclusions.
# Applied during `vsce package` from inside dist/.
# package_contract.json and package_extension.py define the exact closed payload.

# Python bytecode and packaging metadata must never enter the payload.
**/__pycache__
**/*.pyc
**/*.pyo
**/*.dist-info/**
**/*.egg-info/**

# Test corpora and developer-only fixtures (none should be in dist/, but
# guard against future drift).
**/tests/**
**/test/**
**/_design/**
**/spec/corpora/**

# Source maps and intermediate build artifacts.
**/*.map

# Editor / VCS clutter.
.vscode/**
.git/**
.gitignore

# This file itself.
.vscodeignore
