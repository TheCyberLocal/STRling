{
    "name": "vscode-strling",
    "displayName": "STRling Language Support",
    "description": "Canonical STRling diagnostics, editor intelligence, certified actions, and governed embedded-pattern support for native STRling and 17 host-language routes.",
    "version": "1.0.0",
    "icon": "strling-icon.png",
    "publisher": "strling-lang",
    "repository": "https://github.com/strling-lang/strling",
    "license": "Apache-2.0",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages",
        "Linters"
    ],
    "activationEvents": [
        "onLanguage:strling",
        "onLanguage:c",
        "onLanguage:cpp",
        "onLanguage:csharp",
        "onLanguage:dart",
        "onLanguage:fsharp",
        "onLanguage:go",
        "onLanguage:java",
        "onLanguage:javascript",
        "onLanguage:javascriptreact",
        "onLanguage:kotlin",
        "onLanguage:lua",
        "onLanguage:perl",
        "onLanguage:php",
        "onLanguage:python",
        "onLanguage:r",
        "onLanguage:ruby",
        "onLanguage:rust",
        "onLanguage:swift",
        "onLanguage:typescript",
        "onLanguage:typescriptreact"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "strling",
                "aliases": [
                    "STRling",
                    "strling"
                ],
                "extensions": [
                    ".strl"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "STRling",
            "properties": {
                "strling.languageServer.command": {
                    "type": "string",
                    "default": "",
                    "description": "Python 3.11+ executable used to launch the bundled STRling language server. Leave blank for platform discovery."
                },
                "strling.languageServer.args": {
                    "type": "array",
                    "default": [],
                    "description": "Arguments passed to the language-server command. Defaults to the bundled server/server.py over stdio."
                },
                "strling.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Trace LSP communication for diagnostics."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "node -e \"process.exit(0)\"",
        "assemble": "python package_extension.py assemble --target auto",
        "build:dist": "npm run assemble",
        "package": "python package_extension.py package --target auto",
        "certify": "python package_extension.py certify --target auto"
    },
    "devDependencies": {
        "@types/node": "^18.0.0",
        "@types/vscode": "^1.80.0",
        "@vscode/vsce": "^3.0.0",
        "esbuild": "^0.20.0",
        "typescript": "^5.0.0",
        "vscode-languageclient": "^9.0.1"
    },
    "extensionKind": [
        "workspace"
    ]
}
