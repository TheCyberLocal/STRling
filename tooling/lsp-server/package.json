{
    "name": "vscode-strling",
    "displayName": "STRling Language Support",
    "description": "Real-time STRling diagnostics, hovers, and quick-fixes for embedded patterns across 17 host languages (TypeScript, Python, Rust, Java, C, C++, C#, F#, Go, Kotlin, Swift, Dart, PHP, Ruby, Perl, Lua, R) and native .strl files.",
    "version": "1.0.0",
    "icon": "strling-icon.png",
    "publisher": "strling-lang",
    "repository": "https://github.com/strling-lang/strling",
    "license": "MIT",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages",
        "Linters"
    ],
    "activationEvents": [
        "onLanguage:typescript",
        "onLanguage:typescriptreact",
        "onLanguage:javascript",
        "onLanguage:javascriptreact",
        "onLanguage:python",
        "onLanguage:rust",
        "onLanguage:java",
        "onLanguage:c",
        "onLanguage:cpp",
        "onLanguage:csharp",
        "onLanguage:fsharp",
        "onLanguage:go",
        "onLanguage:kotlin",
        "onLanguage:swift",
        "onLanguage:dart",
        "onLanguage:php",
        "onLanguage:ruby",
        "onLanguage:perl",
        "onLanguage:lua",
        "onLanguage:r"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "strling",
                "aliases": [
                    "STRling",
                    "strling"
                ],
                "extensions": [
                    ".strl"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "c",
                "extensions": [
                    ".c",
                    ".h"
                ]
            },
            {
                "id": "cpp",
                "extensions": [
                    ".cpp",
                    ".cc",
                    ".cxx",
                    ".hpp",
                    ".hh",
                    ".hxx"
                ]
            },
            {
                "id": "csharp",
                "extensions": [
                    ".cs"
                ]
            },
            {
                "id": "fsharp",
                "extensions": [
                    ".fs",
                    ".fsi",
                    ".fsx"
                ]
            },
            {
                "id": "go",
                "extensions": [
                    ".go"
                ]
            },
            {
                "id": "kotlin",
                "extensions": [
                    ".kt",
                    ".kts"
                ]
            },
            {
                "id": "swift",
                "extensions": [
                    ".swift"
                ]
            },
            {
                "id": "dart",
                "extensions": [
                    ".dart"
                ]
            },
            {
                "id": "php",
                "extensions": [
                    ".php"
                ]
            },
            {
                "id": "ruby",
                "extensions": [
                    ".rb"
                ]
            },
            {
                "id": "perl",
                "extensions": [
                    ".pl",
                    ".pm",
                    ".t"
                ]
            },
            {
                "id": "lua",
                "extensions": [
                    ".lua"
                ]
            },
            {
                "id": "r",
                "extensions": [
                    ".r",
                    ".R"
                ]
            }
        ],
        "configuration": {
            "type": "object",
            "title": "STRling",
            "properties": {
                "strling.languageServer.command": {
                    "type": "string",
                    "default": "",
                    "description": "Executable used to launch the STRling language server. Leave blank to auto-detect python3/python from the extension host environment."
                },
                "strling.languageServer.args": {
                    "type": "array",
                    "default": [],
                    "description": "Arguments passed to the language-server command. Defaults to the bundled server/server.py."
                },
                "strling.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Trace LSP communication for diagnostics."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "node -e \"process.exit(0)\"",
        "bundle": "npx esbuild ./client/extension.ts --bundle --outfile=./dist/out/extension.js --external:vscode --platform=node",
        "assemble": "bash ./assemble.sh",
        "build:dist": "npm run assemble",
        "package": "npm run assemble && node -e \"const version=require('./package.json').version; const { execSync } = require('node:child_process'); execSync('cd dist && npx @vscode/vsce package --out ../vscode-strling-' + version + '.vsix', { stdio: 'inherit' });\"",
        "install:local": "npm run package && bash ./sync-local-install.sh"
    },
    "devDependencies": {
        "@types/node": "^18.0.0",
        "@types/vscode": "^1.80.0",
        "@vscode/vsce": "^3.0.0",
        "esbuild": "^0.20.0",
        "typescript": "^5.0.0",
        "vscode-languageclient": "^9.0.1"
    },
    "extensionKind": [
        "workspace"
    ]
}
