{
    "manifest_version": "1.0.0",
    "compiler_contract_version": "1.0.0",
    "position_encodings": ["utf-8", "utf-16", "utf-32"],
    "resource_limits": {
        "max_source_bytes": 1048576,
        "max_diagnostics": 256,
        "max_islands": 256,
        "compile_timeout_seconds": 5.0,
        "debounce_seconds": 0.05
    },
    "hover_section_order": [
        "construct",
        "capture",
        "analysis",
        "safety",
        "portability",
        "documentation"
    ],
    "diagnostic_cases": [
        {
            "id": "regex-empty-valid",
            "command": "import",
            "frontend": "regex",
            "source": "",
            "expected_outcome": "succeeded",
            "expected_diagnostics": []
        },
        {
            "id": "regex-unicode-valid",
            "command": "import",
            "frontend": "regex",
            "source": "é+",
            "expected_outcome": "succeeded",
            "expected_diagnostics": []
        },
        {
            "id": "regex-safety-warning",
            "command": "import",
            "frontend": "regex",
            "source": "(a+)+",
            "expected_outcome": "succeeded",
            "expected_diagnostics": [
                {
                    "code": "STRL-SAFETY-0003",
                    "severity": "warning",
                    "message": "An outer repetition can repartition input with an overlapping inner repetition.",
                    "start": 0,
                    "end": 5
                }
            ]
        },
        {
            "id": "regex-unicode-orphan-close",
            "command": "import",
            "frontend": "regex",
            "source": "é)",
            "expected_outcome": "failed",
            "expected_diagnostics": [
                {
                    "code": "STRL-FRONTEND-2011",
                    "severity": "error",
                    "message": "closing parenthesis has no opener",
                    "start": 2,
                    "end": 3
                }
            ]
        },
        {
            "id": "regex-unicode-eof",
            "command": "import",
            "frontend": "regex",
            "source": "é(a",
            "expected_outcome": "failed",
            "expected_diagnostics": [
                {
                    "code": "STRL-FRONTEND-2012",
                    "severity": "error",
                    "message": "group or lookaround is not closed",
                    "start": 4,
                    "end": 4
                }
            ]
        },
        {
            "id": "regex-multiline-eof",
            "command": "import",
            "frontend": "regex",
            "source": "a\n(b",
            "expected_outcome": "failed",
            "expected_diagnostics": [
                {
                    "code": "STRL-FRONTEND-2012",
                    "severity": "error",
                    "message": "group or lookaround is not closed",
                    "start": 4,
                    "end": 4
                }
            ]
        },
        {
            "id": "regex-unclosed-class",
            "command": "import",
            "frontend": "regex",
            "source": "[a-z",
            "expected_outcome": "failed",
            "expected_diagnostics": [
                {
                    "code": "STRL-FRONTEND-2018",
                    "severity": "error",
                    "message": "character class is not closed",
                    "start": 4,
                    "end": 4
                }
            ]
        },
        {
            "id": "regex-invalid-range-quantifier",
            "command": "import",
            "frontend": "regex",
            "source": "a{5,2}",
            "expected_outcome": "failed",
            "expected_diagnostics": [
                {
                    "code": "STRL-FRONTEND-2008",
                    "severity": "error",
                    "message": "quantifier minimum exceeds maximum",
                    "start": 6,
                    "end": 6
                }
            ]
        },
        {
            "id": "semantic-literal-valid",
            "command": "compile",
            "frontend": "semantic",
            "source": "semantic strling 1.0;\ncase sensitive;\npattern text \"a\";\n",
            "expected_outcome": "succeeded",
            "expected_diagnostics": []
        },
        {
            "id": "semantic-empty-text",
            "command": "compile",
            "frontend": "semantic",
            "source": "semantic strling 1.0;\ncase sensitive;\npattern text \"\";\n",
            "expected_outcome": "failed",
            "expected_diagnostics": [
                {
                    "code": "STRL-DSL-2001",
                    "severity": "error",
                    "message": "semantic text value must not be empty",
                    "start": 51,
                    "end": 52
                }
            ]
        },
        {
            "id": "target-pcre2-profile",
            "command": "import",
            "frontend": "regex",
            "target": "pcre2-10.42",
            "source": "a+",
            "expected_outcome": "succeeded",
            "expected_diagnostics": []
        },
        {
            "id": "target-python-profile",
            "command": "import",
            "frontend": "regex",
            "target": "python-re-3.11",
            "source": "a+",
            "expected_outcome": "succeeded",
            "expected_diagnostics": []
        }
    ],
    "position_cases": [
        {
            "id": "ascii-single-line",
            "source": "abc)",
            "start": 3,
            "end": 4,
            "expected": {
                "utf-8": [
                    [0, 3],
                    [0, 4]
                ],
                "utf-16": [
                    [0, 3],
                    [0, 4]
                ],
                "utf-32": [
                    [0, 3],
                    [0, 4]
                ]
            }
        },
        {
            "id": "bmp-scalar",
            "source": "é)",
            "start": 2,
            "end": 3,
            "expected": {
                "utf-8": [
                    [0, 2],
                    [0, 3]
                ],
                "utf-16": [
                    [0, 1],
                    [0, 2]
                ],
                "utf-32": [
                    [0, 1],
                    [0, 2]
                ]
            }
        },
        {
            "id": "astral-scalar",
            "source": "😀)",
            "start": 4,
            "end": 5,
            "expected": {
                "utf-8": [
                    [0, 4],
                    [0, 5]
                ],
                "utf-16": [
                    [0, 2],
                    [0, 3]
                ],
                "utf-32": [
                    [0, 1],
                    [0, 2]
                ]
            }
        },
        {
            "id": "multiline-astral",
            "source": "é\n😀)",
            "start": 7,
            "end": 8,
            "expected": {
                "utf-8": [
                    [1, 4],
                    [1, 5]
                ],
                "utf-16": [
                    [1, 2],
                    [1, 3]
                ],
                "utf-32": [
                    [1, 1],
                    [1, 2]
                ]
            }
        },
        {
            "id": "crlf-line-boundary",
            "source": "é\r\n)",
            "start": 4,
            "end": 5,
            "expected": {
                "utf-8": [
                    [1, 0],
                    [1, 1]
                ],
                "utf-16": [
                    [1, 0],
                    [1, 1]
                ],
                "utf-32": [
                    [1, 0],
                    [1, 1]
                ]
            }
        },
        {
            "id": "unicode-eof",
            "source": "é(",
            "start": 3,
            "end": 3,
            "expected": {
                "utf-8": [
                    [0, 3],
                    [0, 3]
                ],
                "utf-16": [
                    [0, 2],
                    [0, 2]
                ],
                "utf-32": [
                    [0, 2],
                    [0, 2]
                ]
            }
        }
    ],
    "hover_cases": [
        {
            "id": "hover-empty",
            "command": "import",
            "frontend": "regex",
            "source": "",
            "cursor_byte": 0,
            "expected_node_id": "node:regex-compat/00000001",
            "expected_kind": "empty",
            "expected_span": [0, 0],
            "expected_fact": { "nullable": true, "min": 0, "max": 0 }
        },
        {
            "id": "hover-sequence",
            "command": "compile",
            "frontend": "semantic",
            "source": "semantic strling 1.0;\ncase sensitive;\npattern sequence { capture word { text \"go\"; } same text as word; }\n",
            "cursor_byte": 46,
            "expected_node_id": "node:semantic/n1",
            "expected_kind": "sequence",
            "expected_span": [46, 105],
            "expected_fact": { "nullable": false, "min": 4, "max": 4 }
        },
        {
            "id": "hover-alternation",
            "command": "import",
            "frontend": "regex",
            "source": "a|b",
            "cursor_byte": 1,
            "expected_node_id": "node:regex-compat/00000001",
            "expected_kind": "alternation",
            "expected_span": [0, 3],
            "expected_fact": { "nullable": false, "min": 1, "max": 1 }
        },
        {
            "id": "hover-literal",
            "command": "import",
            "frontend": "regex",
            "source": "abc",
            "cursor_byte": 1,
            "expected_node_id": "node:regex-compat/00000001",
            "expected_kind": "literal",
            "expected_span": [0, 3],
            "expected_fact": { "nullable": false, "min": 3, "max": 3 }
        },
        {
            "id": "hover-wildcard",
            "command": "import",
            "frontend": "regex",
            "source": ".",
            "cursor_byte": 0,
            "expected_node_id": "node:regex-compat/00000001",
            "expected_kind": "wildcard",
            "expected_span": [0, 1],
            "expected_fact": { "nullable": false, "min": 1, "max": 1 }
        },
        {
            "id": "hover-character-set",
            "command": "import",
            "frontend": "regex",
            "source": "[a-z]",
            "cursor_byte": 1,
            "expected_node_id": "node:regex-compat/00000001",
            "expected_kind": "character_set",
            "expected_span": [0, 5],
            "expected_fact": { "nullable": false, "min": 1, "max": 1 }
        },
        {
            "id": "hover-repeat",
            "command": "import",
            "frontend": "regex",
            "source": "a+",
            "cursor_byte": 1,
            "expected_node_id": "node:regex-compat/00000001",
            "expected_kind": "repeat",
            "expected_span": [0, 2],
            "expected_fact": { "nullable": false, "min": 1, "max": null }
        },
        {
            "id": "hover-position",
            "command": "import",
            "frontend": "regex",
            "source": "^a$",
            "cursor_byte": 0,
            "expected_node_id": "node:regex-compat/00000002",
            "expected_kind": "position",
            "expected_span": [0, 1],
            "expected_fact": { "nullable": true, "min": 0, "max": 0 }
        },
        {
            "id": "hover-capture",
            "command": "import",
            "frontend": "regex",
            "source": "(a)",
            "cursor_byte": 0,
            "expected_node_id": "node:regex-compat/00000001",
            "expected_kind": "capture",
            "expected_span": [0, 3],
            "expected_fact": { "nullable": false, "min": 1, "max": 1 }
        },
        {
            "id": "hover-backreference",
            "command": "import",
            "frontend": "regex",
            "source": "(?<word>a)\\k<word>",
            "cursor_byte": 11,
            "expected_node_id": "node:regex-compat/00000004",
            "expected_kind": "backreference",
            "expected_span": [10, 18],
            "expected_fact": { "nullable": false, "min": 1, "max": 1 }
        },
        {
            "id": "hover-lookaround",
            "command": "import",
            "frontend": "regex",
            "source": "(?=a)a",
            "cursor_byte": 1,
            "expected_node_id": "node:regex-compat/00000002",
            "expected_kind": "lookaround",
            "expected_span": [0, 5],
            "expected_fact": { "nullable": true, "min": 0, "max": 0 }
        },
        {
            "id": "hover-atomic",
            "command": "import",
            "frontend": "regex",
            "source": "(?>a)",
            "cursor_byte": 1,
            "expected_node_id": "node:regex-compat/00000001",
            "expected_kind": "atomic",
            "expected_span": [0, 5],
            "expected_fact": { "nullable": false, "min": 1, "max": 1 }
        }
    ],
    "lifecycle_cases": [
        { "id": "open-current-snapshot", "class": "publication" },
        { "id": "change-debounce-latest", "class": "debounce" },
        { "id": "save-current-snapshot", "class": "publication" },
        { "id": "close-cancels-and-clears", "class": "close" },
        { "id": "rapid-edit-cancels-pending", "class": "cancellation" },
        {
            "id": "new-generation-terminates-in-flight",
            "class": "cancellation"
        },
        { "id": "stale-completion-discarded", "class": "stale" },
        { "id": "profile-change-invalidates", "class": "profile" },
        { "id": "position-encoding-invalidates", "class": "profile" },
        { "id": "cache-hit-identical-semantic-inputs", "class": "cache" },
        { "id": "cache-miss-on-content-change", "class": "cache" },
        { "id": "timeout-isolated", "class": "failure" },
        { "id": "missing-kernel-isolated", "class": "failure" },
        { "id": "malformed-kernel-output-isolated", "class": "failure" },
        { "id": "compile-failed-result-is-data", "class": "failure" },
        { "id": "recovery-after-service-failure", "class": "recovery" }
    ]
}
